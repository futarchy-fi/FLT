module

public import FLT.Mazur.WeierstrassDividedFirstExteriorCoordinates

/-!
# Unit successive output centers for the actual retained exterior

The original action preserves the deeper center. Its retained input ideal
is generated by the regular horizontal coordinate. Cancelling this factor
proves that the successive output center is the unit ideal.
-/

@[expose] public noncomputable section
open AlgebraicGeometry CategoryTheory Limits
namespace FLT.Mazur.WeierstrassDividedDepth
open WeierstrassIntegralChart
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
universe u
variable {R : Type u} [CommRing R] [IsDomain R] [IsBezout R]
  {W : WeierstrassCurve R} {π : R} (hπ : π ≠ 0) {start n : ℕ}
  (data : (i : Fin (n + 1)) → Data W π (start + i.val)) (hn : 1 ≤ n)

local notation "v" => finiteNormalizedChart hπ data 0 hn

local notation "d" => data (Fin.mk 0 (Nat.zero_lt_succ n))
local notation "e" => data (Fin.mk 1 (Nat.lt_succ_of_le hn))
local notation "B" => WeierstrassDilatation.Coordinate W (π ^ (start + 0))
  (π * (Data.b3 e)) (π * (Data.b4 e)) (π ^ 2 * (Data.b6 e))
local notation "q" => previousOriginalMap hπ d e
local notation "U" => firstDividedAffineCover hπ data hn

local notation "D" => firstDividedInputCover hπ data hn
local notation "I" => WeierstrassSuccessiveX.modificationCenter W (π ^ (start + 0)) π
  (Data.b3 e) (Data.b4 e) (Data.b6 e)
local notation "X" => WeierstrassModificationX.Coordinate W (π ^ (start + 0))
  (Data.b3 d) (Data.b4 d) (Data.b6 d)
local notation "c" => WeierstrassModificationX.fromOriginal W (π ^ (start + 0))
  (Data.b3 d) (Data.b4 d) (Data.b6 d) (Data.factor3 d) (Data.factor4 d) (Data.factor6 d)
variable (a : ((firstDividedInputCover hπ data hn).X (some none)).affineCover.I₀)

/-- The complete crossed exterior branch has a unit successive output center. -/
theorem firstDividedExterior_center :
    (I).map (firstDividedAlpha hπ data hn ⟨some none, a⟩) = ⊤ := by
  let α := firstDividedAlpha hπ data hn ⟨some none, a⟩
  let ψ := firstDividedExteriorHom hπ data hn a
  have hp : firstDividedParameter hπ data hn ⟨some none, a⟩ ≫ integralSmoothStructure W =
      (Spec.map (CommRingCat.ofHom (ψ.comp (c).toRingHom)) ≫
        integralCurveChart W 2) ≫ integralCurveStructure W := by
    rw [firstDividedExteriorHom_original]
    exact firstDividedParameter_structure hπ data hn ⟨some none, a⟩
  have ha : Spec.map (CommRingCat.ofHom (α.comp (q).toRingHom)) ≫ integralCurveChart W 2 =
      leftSmoothPointAddition W (firstDividedParameter hπ data hn ⟨some none, a⟩)
        (Spec.map (CommRingCat.ofHom (ψ.comp (c).toRingHom)) ≫ integralCurveChart W 2) hp := by
    simpa only [α, ψ, firstDividedExteriorHom_original] using
      firstDividedAlpha_addition hπ data hn ⟨some none, a⟩
  have h3 : W.a₃ = (π ^ (start + 0) * π) * (e).b3 := by
    simpa only [pow_succ, Nat.add_zero] using (e).factor3
  have h4 : W.a₄ = (π ^ (start + 0) * π) * (e).b4 := by
    simpa only [pow_succ, Nat.add_zero] using (e).factor4
  have h6 : W.a₆ = (π ^ (start + 0) * π) *
      ((π ^ (start + 0) * π) * (e).b6) := by
    calc
      W.a₆ = (π ^ (start + 0 + 1)) ^ 2 * (e).b6 := (e).factor6
      _ = _ := by rw [pow_succ]; ring
  have he := leftSmoothChartPresentation_center_eq (S := (U).X ⟨some none, a⟩)
    W (π ^ (start + 0) * π) (e).b3 (e).b4 ((π ^ (start + 0) * π) * (e).b6)
    h3 h4 h6 2 2 (firstDividedParameter hπ data hn ⟨some none, a⟩)
    (α.comp (q).toRingHom) (ψ.comp (c).toRingHom) hp ha
  rw [previousOriginalMap, WeierstrassSuccessiveX.originalCenter_map_ringPresentation,
    WeierstrassSuccessiveX.originalDeeperCenter_map_exteriorPresentation] at he
  have hc := RingHom.congr_fun (firstDividedExterior_coefficients hπ data hn a)
    (π ^ (start + 0))
  simp only [RingHom.comp_apply] at hc
  rw [hc, ← WeierstrassModificationX.incidence W (π ^ (start + 0))
    (d).b3 (d).b4 (d).b6, map_mul] at he
  rw [mul_comm
    (ψ (WeierstrassModificationX.t W (π ^ (start + 0)) (d).b3 (d).b4 (d).b6))
    (ψ (WeierstrassModificationX.x W (π ^ (start + 0)) (d).b3 (d).b4 (d).b6))] at he
  exact WeierstrassSuccessiveX.successiveCenter_unit_of_scaled_eq _ _ _
    (firstDividedExteriorHom_horizontal_regular hπ data hn a) he

end FLT.Mazur.WeierstrassDividedDepth
