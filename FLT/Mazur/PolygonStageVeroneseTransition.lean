module

public import FLT.Mazur.PolygonStageVeroneseGrading

/-!
# Original transition maps on the retained stage gradings

The existing polygon section transitions restrict to the independently defined
Veronese subrings, preserve their actual gradings, and commute with compatible
evaluation. For the exact step they are surjective on each original degree.
-/

@[expose] public noncomputable section

open CategoryTheory
open scoped DirectSum

namespace FLT.Mazur.PolygonInfinitesimalStages

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

attribute [local irreducible] compatibleEval boundaryLine family

variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n)

/-- Original stage restriction preserves the subring generated by retained sections. -/
theorem boundaryVeroneseRing_map_mem (q : ℕ) {a b : ℕ} (f : a ⟶ b)
    (s : boundaryVeroneseRing K n h q b) :
    boundarySectionsMap K n h f s ∈ boundaryVeroneseRing K n h q a := by
  have hle : boundaryVeroneseRing K n h q b ≤
      (boundaryVeroneseRing K n h q a).comap (boundarySectionsMap K n h f) := by
    apply Subring.closure_le.mpr
    intro t ht
    obtain ⟨d, hd⟩ := Set.mem_iUnion.mp ht
    apply Subring.subset_closure
    exact Set.mem_iUnion.mpr ⟨d, boundarySectionsMap_mem_grade K n h f hd⟩
  exact hle s.property

/-- The original stage restriction, with its actual retained grading. -/
def boundaryVeroneseTransition (q : ℕ) {a b : ℕ} (f : a ⟶ b) :
    boundaryVeroneseGrade K n h q b →+*ᵍ boundaryVeroneseGrade K n h q a where
  __ := RingHom.codRestrict
    ((boundarySectionsMap K n h f).comp (boundaryVeroneseRing K n h q b).subtype) _
    (boundaryVeroneseRing_map_mem K n h q f)
  map_mem := fun hs ↦ boundarySectionsMap_mem_grade K n h f hs

/-- The retained restriction keeps the original stage map on every element. -/
theorem boundaryVeroneseTransition_val (q : ℕ) {a b : ℕ} (f : a ⟶ b)
    (s : boundaryVeroneseRing K n h q b) :
    (boundaryVeroneseTransition K n h q f s).val = boundarySectionsMap K n h f s := rfl

/-- Every compatible evaluation commutes with the original retained stage restriction. -/
theorem boundaryVeroneseTransition_evaluation (q : ℕ) {a b : ℕ} (f : a ⟶ b) :
    (boundaryVeroneseTransition K n h q f).comp (boundaryVeroneseEvaluation K n h q b) =
      boundaryVeroneseEvaluation K n h q a := by
  ext s : 1
  apply Subtype.ext
  exact DFunLike.congr_fun (compatibleVeroneseEval_transition K n h q f) s

/-- Pointwise compatibility retains the original evaluated section at both stages. -/
theorem boundaryVeroneseTransition_evaluation_apply (q : ℕ) {a b : ℕ} (f : a ⟶ b)
    (s : CompatibleVeroneseSections K n h q) :
    boundaryVeroneseTransition K n h q f (boundaryVeroneseEvaluation K n h q b s) =
      boundaryVeroneseEvaluation K n h q a s :=
  DFunLike.congr_fun (boundaryVeroneseTransition_evaluation K n h q f) s

variable [NeZero n]

/-- Every original retained section lifts through each original stage restriction. -/
theorem boundaryVeroneseTransition_homogeneous_surjective {a b : ℕ} (f : a ⟶ b) (d : ℕ)
    (s : boundaryVeroneseGrade K n h (exactVeroneseStep K n h) a d) :
    ∃ t : boundaryVeroneseGrade K n h (exactVeroneseStep K n h) b d,
      boundaryVeroneseTransition K n h (exactVeroneseStep K n h) f t = s := by
  obtain ⟨u, hu⟩ := boundaryVeroneseEvaluation_homogeneous_surjective K n h a d s
  refine ⟨⟨boundaryVeroneseEvaluation K n h (exactVeroneseStep K n h) b
    (DirectSum.of _ d u), (boundaryVeroneseEvaluation K n h _ b).map_mem ⟨u, rfl⟩⟩, ?_⟩
  change boundaryVeroneseTransition K n h (exactVeroneseStep K n h) f
    (boundaryVeroneseEvaluation K n h (exactVeroneseStep K n h) b (DirectSum.of _ d u)) = s
  rw [boundaryVeroneseTransition_evaluation_apply]
  exact hu

end FLT.Mazur.PolygonInfinitesimalStages
