module

public import FLT.Mazur.HilbertQuotientDegreeBound
public import Mathlib.Algebra.MvPolynomial.CommRing

/-!
# Bounded relations generate the entire finite quotient ideal

If every quotient class has a representative of degree at most `d`, then the
ideal is generated by its relations of degree at most `d + 1`. The proof is
polynomial reduction with all coefficients retained, and works over arbitrary
commutative rings. For a field quotient of rank `d` the degree hypothesis is
provided by the previously constructed uniform bound.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.HilbertChart

variable (S I : Type*) [CommRing S] (J : Ideal (MvPolynomial I S)) (d : ℕ)

/-- The actual ideal generated by the bounded-degree relations of the original ideal. -/
def truncatedRelationIdeal : Ideal (MvPolynomial I S) :=
  Ideal.span {p | p ∈ J ∧ p.totalDegree ≤ d + 1}

/-- Bounded relations are relations of the original full ideal. -/
theorem truncatedRelationIdeal_le : truncatedRelationIdeal S I J d ≤ J :=
  Ideal.span_le.mpr (fun _ hp ↦ hp.1)

variable (hrep : ∀ x : MvPolynomial I S ⧸ J,
  ∃ p : MvPolynomial I S, p.totalDegree ≤ d ∧ Ideal.Quotient.mk J p = x)

include hrep in
/-- Reduction by the bounded relations leaves a polynomial of degree at most `d`. -/
theorem exists_reduction_mod_truncatedRelations (p : MvPolynomial I S) :
    ∃ q : MvPolynomial I S, q.totalDegree ≤ d ∧
      p - q ∈ truncatedRelationIdeal S I J d := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    exact ⟨MvPolynomial.C a, by simp, by simp⟩
  | add p q hp hq =>
    obtain ⟨r, hr, hpr⟩ := hp
    obtain ⟨s, hs, hqs⟩ := hq
    refine ⟨r + s, (MvPolynomial.totalDegree_add _ _).trans (max_le hr hs), ?_⟩
    simpa only [add_sub_add_comm] using (truncatedRelationIdeal S I J d).add_mem hpr hqs
  | mul_X p i hp =>
    obtain ⟨q, hq, hpq⟩ := hp
    obtain ⟨r, hr, her⟩ := hrep (Ideal.Quotient.mk J (q * MvPolynomial.X i))
    have hrel : q * MvPolynomial.X i - r ∈ J := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [map_sub, her, sub_self]
    have hX : (MvPolynomial.X i : MvPolynomial I S).totalDegree ≤ 1 := by
      rcases subsingleton_or_nontrivial S with h | h
      · let _ := h
        rw [Subsingleton.elim (MvPolynomial.X i) 0]
        simp only [MvPolynomial.totalDegree_zero, Nat.zero_le]
      · let _ := h
        simp only [MvPolynomial.totalDegree_X, le_refl]
    have hdeg : (q * MvPolynomial.X i - r).totalDegree ≤ d + 1 := by
      apply (MvPolynomial.totalDegree_sub _ _).trans
      apply max_le
      · exact (MvPolynomial.totalDegree_mul _ _).trans
          (Nat.add_le_add hq hX)
      · exact hr.trans (Nat.le_succ d)
    have hsmall : q * MvPolynomial.X i - r ∈ truncatedRelationIdeal S I J d :=
      Ideal.subset_span ⟨hrel, hdeg⟩
    refine ⟨r, hr, ?_⟩
    have hmul := (truncatedRelationIdeal S I J d).mul_mem_right (MvPolynomial.X i) hpq
    convert (truncatedRelationIdeal S I J d).add_mem hmul hsmall using 1
    ring

include hrep in
/-- Bounded polynomial relations generate the full original ideal, not just its radical. -/
theorem truncatedRelationIdeal_eq : truncatedRelationIdeal S I J d = J := by
  apply le_antisymm (truncatedRelationIdeal_le S I J d)
  intro p hp
  obtain ⟨q, hq, hpq⟩ := exists_reduction_mod_truncatedRelations S I J d hrep p
  have hqJ : q ∈ J := by
    have h := J.sub_mem hp (truncatedRelationIdeal_le S I J d hpq)
    simpa only [sub_sub_cancel] using h
  have hsmall : q ∈ truncatedRelationIdeal S I J d :=
    Ideal.subset_span ⟨hqJ, hq.trans (Nat.le_succ d)⟩
  simpa only [sub_add_cancel] using (truncatedRelationIdeal S I J d).add_mem hpq hsmall

end FLT.Mazur.HilbertChart
