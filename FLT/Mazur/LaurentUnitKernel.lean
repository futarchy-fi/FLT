module

public import FLT.Mazur.LaurentUnitPoints
public import Mathlib.Algebra.Polynomial.Div

/-!
# The full ideal of an arbitrary Laurent unit section

Evaluation at any unit has kernel generated by the coordinate minus that
unit, over arbitrary rings. Clearing negative exponents uses an invertible
factor, so the computation does not require a reduced or integral base.
-/

@[expose] public noncomputable section

open LaurentPolynomial
open scoped LaurentPolynomial

namespace FLT.Mazur.LaurentUnitKernel

variable {R : Type*} [CommRing R] (a : Rˣ)

/-- Vanishing at a unit is divisibility by its full Laurent section equation. -/
theorem eval_eq_zero_iff (f : R[T;T⁻¹]) :
    LaurentUnitPoints.evalUnit a f = 0 ↔ T 1 - C a.val ∣ f := by
  constructor
  · induction f using LaurentPolynomial.induction_on_mul_T with
    | mul_T g n =>
      intro hf
      have hg : g.eval a.val = 0 := by
        have he : LaurentUnitPoints.evalUnit a (Polynomial.toLaurent g) *
            (a ^ (-(n : ℤ))).val = 0 := by
          simpa only [map_mul, LaurentUnitPoints.evalUnit_T] using hf
        have hz := (a ^ (-(n : ℤ))).mul_left_eq_zero.mp he
        simpa [LaurentUnitPoints.evalUnit, eval₂_toLaurent] using hz
      obtain ⟨q, hq⟩ := (Polynomial.dvd_iff_isRoot).mpr hg
      refine ⟨Polynomial.toLaurent q * T (-(n : ℤ)), ?_⟩
      rw [hq, map_mul, map_sub, Polynomial.toLaurent_X, Polynomial.toLaurent_C]
      exact mul_assoc _ _ _
  · rintro ⟨q, rfl⟩
    simp [LaurentUnitPoints.evalUnit]

/-- The actual unit-point map has the principal section kernel. -/
theorem kernel : RingHom.ker (LaurentUnitPoints.evalUnit (R := R) a).toRingHom =
    Ideal.span {T 1 - C a.val} := by
  ext f
  exact (eval_eq_zero_iff a f).trans Ideal.mem_span_singleton.symm

end FLT.Mazur.LaurentUnitKernel
