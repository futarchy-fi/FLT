module

public import FLT.Mazur.BlowupFractionPrincipalLift
public import Mathlib.AlgebraicGeometry.Cover.Open

/-!
# Ratio covers of a regular principalized center

Once the full pulled-back ideal is generated by a regular element, every
original generator has a unique quotient by it. Those quotients give a cover
of the entire input scheme. On each open the image of the corresponding
original generator is regular and generates the full pulled-back ideal.
-/

@[expose] public noncomputable section

open AlgebraicGeometry

namespace FLT.Mazur.RegularCenter

set_option backward.isDefEq.respectTransparency false

variable {A B : Type*} [CommRing A] [CommRing B]
  (I : Ideal A) (φ : A →+* B) (d : B) (hI : I.map φ = Ideal.span {d})

/-- The actual quotient of an original center element by the principal input denominator. -/
def quotient (a : A) (ha : a ∈ I) : B :=
  Classical.choose (Ideal.mem_span_singleton.mp (hI ▸ Ideal.mem_map_of_mem φ ha))

/-- Multiplying each chosen quotient by the retained denominator recovers the original image. -/
theorem denominator_mul_quotient (a : A) (ha : a ∈ I) :
    d * quotient I φ d hI a ha = φ a :=
  (Classical.choose_spec
    (Ideal.mem_span_singleton.mp (hI ▸ Ideal.mem_map_of_mem φ ha))).symm

/-- The quotient is independent of every choice when the denominator is regular. -/
theorem quotient_unique (hd : IsRegular d) (a : A) (ha : a ∈ I)
    (q : B) (hq : d * q = φ a) : q = quotient I φ d hI a ha :=
  hd.left (hq.trans (denominator_mul_quotient I φ d hI a ha).symm)

/-- Quotients of a finite generating family generate the unit ideal on the entire input. -/
theorem quotient_span_eq_top (hd : IsRegular d) {ι : Type*} [Finite ι]
    (g : ι → A) (hg : ∀ i, g i ∈ I) (hspan : Ideal.span (Set.range g) = I) :
    Ideal.span (Set.range fun i => quotient I φ d hI (g i) (hg i)) = ⊤ := by
  let _ := Fintype.ofFinite ι
  have hgen : Ideal.span (Set.range fun i => φ (g i)) = Ideal.span {d} := by
    rw [Set.range_comp', ← Ideal.map_span, hspan, hI]
  have hmem : d ∈ Ideal.span (Set.range fun i => φ (g i)) := by
    rw [hgen]
    exact Ideal.subset_span (Set.mem_singleton d)
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  have he : ∑ i, c i * quotient I φ d hI (g i) (hg i) = 1 := by
    apply hd.left
    dsimp only
    rw [mul_one, Finset.mul_sum]
    calc
      ∑ i, d * (c i * quotient I φ d hI (g i) (hg i)) = ∑ i, c i * φ (g i) := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [mul_left_comm, denominator_mul_quotient]
      _ = d := hc
  rw [Ideal.eq_top_iff_one]
  exact Ideal.mem_span_range_iff_exists_fun.mpr ⟨c, he⟩

/-- The full principalized input is covered by these actual quotient localizations. -/
def quotientCover (hd : IsRegular d) {ι : Type*} [Finite ι]
    (g : ι → A) (hg : ∀ i, g i ∈ I) (hspan : Ideal.span (Set.range g) = I) :
    (Spec (.of B)).AffineOpenCover :=
  Scheme.affineOpenCoverOfSpanRangeEqTop (fun i => quotient I φ d hI (g i) (hg i))
    (quotient_span_eq_top I φ d hI hd g hg hspan)

variable (a : A) (ha : a ∈ I)

/-- Only the quotient, not the input denominator, is inverted. -/
abbrev QuotientOpen := Localization.Away (quotient I φ d hI a ha)

/-- The original coefficient map restricted to the actual quotient open. -/
def onQuotientOpen : A →+* QuotientOpen I φ d hI a ha := (algebraMap B _).comp φ

/-- On the quotient open the image output generator generates the full pulled-back center. -/
theorem quotientOpen_center :
    I.map (onQuotientOpen I φ d hI a ha) =
      Ideal.span {onQuotientOpen I φ d hI a ha a} := by
  rw [onQuotientOpen, ← Ideal.map_map, hI, Ideal.map_span, Set.image_singleton]
  change Ideal.span {algebraMap B _ d} = Ideal.span {algebraMap B _ (φ a)}
  rw [← denominator_mul_quotient I φ d hI a ha, map_mul]
  exact (Ideal.span_singleton_mul_right_unit
    (IsLocalization.Away.algebraMap_isUnit (quotient I φ d hI a ha)) _).symm

/-- The image output denominator is regular on the full quotient open. -/
theorem quotientOpen_denominator_regular (hd : IsRegular d) :
    IsRegular (onQuotientOpen I φ d hI a ha a) := by
  have hreg : IsRegular (algebraMap B (QuotientOpen I φ d hI a ha) d) := by
    apply isRegular_iff_mem_nonZeroDivisors.mpr
    exact IsLocalization.nonZeroDivisors_le_comap
      (M := Submonoid.powers (quotient I φ d hI a ha))
      (S := QuotientOpen I φ d hI a ha)
      (isRegular_iff_mem_nonZeroDivisors.mp hd)
  change IsRegular (algebraMap B _ (φ a))
  rw [← denominator_mul_quotient I φ d hI a ha, map_mul]
  exact hreg.mul (IsLocalization.Away.algebraMap_isUnit
    (quotient I φ d hI a ha)).isRegular

/-- An actual output fraction-chart map on each member of the complete input cover. -/
irreducible_def quotientOpenLift (hd : IsRegular d) :
    BlowupFractionChart.chart I a →+* QuotientOpen I φ d hI a ha :=
  BlowupFractionChart.principalLift I (onQuotientOpen I φ d hI a ha) a
    (quotientOpen_center I φ d hI a ha).le
    (quotientOpen_denominator_regular I φ d hI a ha hd)

/-- Each local lift contracts to the original map on the actual input quotient open. -/
@[simp] theorem quotientOpenLift_base (hd : IsRegular d) (z : A) :
    quotientOpenLift I φ d hI a ha hd (algebraMap A _ z) =
      onQuotientOpen I φ d hI a ha z := by
  rw [quotientOpenLift_def, BlowupFractionChart.principalLift_base]

end FLT.Mazur.RegularCenter
