module

public import FLT.Mazur.WeierstrassChangeComparisonScheme
public import Mathlib.RingTheory.Localization.Away.AdjoinRoot
public import Mathlib.AlgebraicGeometry.Morphisms.FinitePresentation
public import Mathlib.AlgebraicGeometry.Morphisms.Affine

/-!
# Finite presentation of the varying full curve comparison scheme

Four coordinates, one inverted scale, and five explicit equations suffice.
Thus the actual comparison scheme is affine and of finite presentation over
its original coefficient base, without any Noetherian hypothesis.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
namespace FLT.Mazur.WeierstrassChangeParameter
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
variable {R : Type} [CommRing R] (W V : WeierstrassCurve R)

instance parameterRing_finitePresentation : Algebra.FinitePresentation R (ParameterRing R) :=
  inferInstanceAs (Algebra.FinitePresentation R
    (Localization.Away (MvPolynomial.X (0 : Fin 4) : PolynomialRing R)))

/-- The comparison ideal is generated by its five original coefficient equations. -/
theorem equationIdeal_fg : (equationIdeal W V).FG :=
  Submodule.fg_span (Set.finite_range (equationRelation W V))

instance equationRing_finitePresentation : Algebra.FinitePresentation R (EquationRing W V) :=
  Algebra.FinitePresentation.quotient (equationIdeal_fg W V)

instance comparisonScheme_affine : IsAffine (comparisonScheme W V) :=
  inferInstanceAs (IsAffine (Spec _))

/-- The actual comparison parameter map is locally of finite presentation over its base. -/
instance comparisonStructure_locallyOfFinitePresentation :
    LocallyOfFinitePresentation (comparisonStructure W V) := by
  apply (LocallyOfFinitePresentation.SpecMap_iff _).mpr
  exact RingHom.finitePresentation_algebraMap.mpr inferInstance

instance comparisonStructure_quasiCompact : QuasiCompact (comparisonStructure W V) := by
  change QuasiCompact (Spec.map (CommRingCat.ofHom (algebraMap R (EquationRing W V))))
  infer_instance

instance comparisonStructure_quasiSeparated : QuasiSeparated (comparisonStructure W V) := by
  change QuasiSeparated (Spec.map (CommRingCat.ofHom (algebraMap R (EquationRing W V))))
  infer_instance

end FLT.Mazur.WeierstrassChangeParameter
