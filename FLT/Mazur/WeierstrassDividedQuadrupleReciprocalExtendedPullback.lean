module

public import FLT.Mazur.WeierstrassDividedQuadrupleReciprocalExtendedOverlap

/-!
# The actual entire quadruple-depth/reciprocal-extended pullback

The old domain is open in the resolved product. Its pullback gives the flat
refinement required by the comparison, without any extra geometric hypothesis.
-/

@[expose] public noncomputable section
open AlgebraicGeometry CategoryTheory Limits
namespace FLT.Mazur.WeierstrassDividedDepth
open WeierstrassDilatation WeierstrassIntegralChart
set_option quotPrecheck false
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
attribute [local irreducible] finiteGlobalModel finiteGlobalStructure rootShearCurve
  nodalSecondShear nodalSecondQuotient
variable {R S : Type} [CommRing R] [CommRing S] [Algebra R S] [IsDomain R]
  [IsBezout R] [IsLocalRing R] [IsNoetherianRing R] [Module.Flat R S]
  {W : WeierstrassCurve R} {π : R} {k : ℕ}
  (D : SplitNodeDepth W π (4 * k)) (d : Data W π k)
  (a c : Coordinate W (π ^ k) d.b3 d.b4 d.b6 →ₐ[R] S)
local notation "data" => splitNodeDoubledFamily D
local notation "j" => k + k
local notation "hj" => (le_rfl : k + k ≤ k + k)
local notation "hπ" => D.uniformizer_ne_zero
local notation "base" => finiteGlobalStructure hπ data j hj
local notation "U" => (base).smoothLocus
local notation "t" => (U).ι ≫ base
local notation "O" => nodalQuadrupleAdditionOpen D d a c
local notation "P" => suppliedDividedSmoothInputOpen d a c

local notation "V" => quadrupleSmoothSourceOpen D d a c
local notation "pair" => quadrupleCommonInput D d a c
local notation "Old" => finiteResolvedReciprocalExtendedOpen hπ data j hj
local notation "i" => finiteResolvedReciprocalExtendedInput hπ data j hj

/-- The two constructed laws agree on their actual full fiber-product intersection. -/
theorem quadrupleCommonOutput_reciprocalExtendedPullback :
    pullback.fst (Old).ι pair ≫ finiteResolvedReciprocalExtendedPartialAddition hπ data j hj =
      pullback.snd (Old).ι pair ≫
        quadrupleCommonOutput D d a c :=
  quadrupleCommonOutput_reciprocalExtendedOverlap D d a c _ _ pullback.condition

end FLT.Mazur.WeierstrassDividedDepth
