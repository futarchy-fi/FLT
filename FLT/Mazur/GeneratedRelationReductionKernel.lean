module

public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Kernel of a reduction on a ring generated by source and target

When target reduction factors through the source, its full kernel is
generated by the source reduction kernel and the actual target errors.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.GeneratedRelationReductionKernel
variable {A B C D : Type*} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
variable (s : A →+* C) (t : B →+* C) (v : B →+* A) (r : C →+* D) (ρ : A →+* D)

/-- The original source kernel and all original target-minus-source errors. -/
def relations : Ideal C :=
  Ideal.map s (RingHom.ker ρ) ⊔ Ideal.span (Set.range (fun z : B ↦ t z - s (v z)))

/-- Each defining relation vanishes under the given compatible reduction. -/
theorem relations_le (hs : r.comp s = ρ) (ht : r.comp t = ρ.comp v) :
    relations s t v ρ ≤ RingHom.ker r := by
  apply sup_le
  · apply Ideal.map_le_iff_le_comap.mpr
    intro z hz
    change r (s z) = 0
    rw [← RingHom.comp_apply, hs]
    exact hz
  · apply Ideal.span_le.mpr
    rintro _ ⟨z, rfl⟩
    change r (t z - s (v z)) = 0
    rw [map_sub, ← RingHom.comp_apply, ht, RingHom.comp_apply,
      ← RingHom.comp_apply r s, hs, sub_self]

/-- Source and target generation makes these all of the reduction relations. -/
theorem kernel_eq (hgen : Subring.closure (Set.range s ∪ Set.range t) = ⊤)
    (hρ : Function.Surjective ρ) (hs : r.comp s = ρ) (ht : r.comp t = ρ.comp v) :
    RingHom.ker r = relations s t v ρ := by
  let J := relations s t v ρ
  let q := Ideal.Quotient.mk J
  have hq : RingHom.ker ρ ≤ RingHom.ker (q.comp s) := by
    intro z hz
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact (show Ideal.map s (RingHom.ker ρ) ≤ J from le_sup_left)
      (Ideal.mem_map_of_mem s hz)
  let j : D →+* C ⧸ J := ρ.liftOfSurjective hρ ⟨q.comp s, hq⟩
  have hj (z : A) : j (ρ z) = q (s z) :=
    ρ.liftOfSurjective_comp_apply hρ _ z
  have he : j.comp r = q := by
    apply RingHom.eq_of_eqOn_set_dense hgen
    rintro _ (⟨z, rfl⟩ | ⟨z, rfl⟩)
    · change j (r (s z)) = q (s z)
      rw [← RingHom.comp_apply r s, hs, hj]
    · change j (r (t z)) = q (t z)
      rw [← RingHom.comp_apply r t, ht, RingHom.comp_apply, hj]
      apply eq_comm.mp
      apply sub_eq_zero.mp
      rw [← map_sub]
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      exact (show Ideal.span (Set.range (fun z : B ↦ t z - s (v z))) ≤ J from le_sup_right)
        (Ideal.subset_span ⟨z, rfl⟩)
  apply le_antisymm _ (relations_le s t v r ρ hs ht)
  intro z hz
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q z = 0
  rw [← he, RingHom.comp_apply, show r z = 0 from hz, map_zero]

end FLT.Mazur.GeneratedRelationReductionKernel
