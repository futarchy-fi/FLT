module

public import FLT.Mazur.ClosedRelationOrbitEmbedding
public import FLT.Mazur.RelativeRelationEtaleSourceFunctions

/-!
# Generators of the boundary orbit image

A Cartesian invariant boundary restriction commutes with taking the orbit
image of an arbitrary open. For an etale generator its actual scheme
pullback generates the entire boundary orbit domain, even when the original
generator does not surject onto the saturated source.
-/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
namespace FLT.Mazur.RelativeRelationOrbit
universe u
variable {S : Scheme.{u}} {A U C B : Over S} {p q : A ⟶ U} {r s : C ⟶ B}
  (e : CategoryTheory.EquivalenceRelation p q)
  (ec : CategoryTheory.EquivalenceRelation r s) (i : B ⟶ U) (z : C ⟶ A)
  (hp : z ≫ p = r ≫ i) (hs : z ≫ q = s ≫ i)
  (H : IsPullback z.left r.left p.left i.left)
  (hq : IsOpenMap q.left) (hc : IsOpenMap s.left)

include H in
/-- The entire boundary orbit domain is generated by the inverse image of the source open. -/
theorem closedOrbitMap_preimage_orbitImageOpen (W : U.left.Opens) :
    (closedOrbitMap e ec i z hp hs) ⁻¹' (orbitImageOpen e hq W : Set (Orbit e)) =
      (orbitImageOpen ec hc (i.left ⁻¹ᵁ W) : Set (Orbit ec)) := by
  ext v
  obtain ⟨b, rfl⟩ := projection_surjective ec v
  constructor
  · rintro ⟨y, hy, he⟩
    obtain ⟨a, ha, hy'⟩ := (projection_eq_iff e (i.left b) y).mp he.symm
    obtain ⟨w, hw, hb⟩ := Scheme.exists_preimage_of_isPullback H a b ha
    refine ⟨s.left w, ?_, ?_⟩
    · have heq : i.left (s.left w) = y :=
        (congrArg (fun f ↦ f.left w) hs).symm.trans ((congrArg q.left hw).trans hy')
      change i.left (s.left w) ∈ W
      exact heq ▸ hy
    · rw [← projection_pair ec w, hb]
  · rintro ⟨b', hb', he⟩
    exact ⟨i.left b', hb', congrArg (closedOrbitMap e ec i z hp hs) he⟩

variable {T : Scheme.{u}} (j : T ⟶ U.left) [Etale j]

/-- The boundary generator is the actual fiber product, including its scheme structure. -/
theorem boundaryGenerator_image :
    etaleSourceImage (pullback.snd j i.left) = i.left ⁻¹ᵁ etaleSourceImage j := by
  ext b
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨pullback.fst j i.left x,
      congrArg (fun f : pullback j i.left ⟶ U.left ↦ f x) pullback.condition⟩
  · rintro ⟨t, ht⟩
    obtain ⟨x, _, hb⟩ := Scheme.exists_preimage_of_isPullback
      (IsPullback.of_hasPullback j i.left) t b ht
    exact ⟨x, hb⟩

include H in
/-- The actual boundary generator has exactly the inverse-image orbit domain. -/
theorem boundaryGenerator_orbitImage :
    (closedOrbitMap e ec i z hp hs) ⁻¹'
        (orbitImageOpen e hq (etaleSourceImage j) : Set (Orbit e)) =
      (orbitImageOpen ec hc (etaleSourceImage (pullback.snd j i.left)) : Set (Orbit ec)) := by
  rw [boundaryGenerator_image, closedOrbitMap_preimage_orbitImageOpen e ec i z hp hs H hq hc]

end FLT.Mazur.RelativeRelationOrbit
