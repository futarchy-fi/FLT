module

public import FLT.Mazur.SmoothEnvelopeBoundaryTransport
public import FLT.Mazur.AffinePullbackIdeal

/-!
# The original boundary ideal as scheme data

The actual source denominator ideal constructs a quasi-coherent ideal and
its closed subscheme. Smooth invariance of the interior gives equality of
the full pulled-back ideal sheaves, on a relation that need not be affine.
The equality survives arbitrary further tests, including nonreduced ones.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
namespace FLT.Mazur.SchemeOpenEnvelope
universe u
set_option backward.isDefEq.respectTransparency false
variable {Y X Z : Scheme.{u}} (π : Y ⟶ X) (O : Y.Opens) [IsAffine X]

/-- The ideal sheaf generated by the exact original denominator ideal. -/
def boundaryIdealSheaf : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (denominatorIdeal π.appTop.hom O)

/-- Its global ideal is exactly the original denominator ideal. -/
theorem boundaryIdealSheaf_top :
    (boundaryIdealSheaf π O).ideal ⟨⊤, isAffineOpen_top X⟩ =
      denominatorIdeal π.appTop.hom O := by simp [boundaryIdealSheaf]

/-- Its closed support is the entire excluded image closure. -/
theorem boundaryIdealSheaf_support :
    ((boundaryIdealSheaf π O).support : Set X) = closure (π '' (O : Set Y)ᶜ) := by
  exact zeroLocus_denominatorIdeal π O

variable [IsLocallyNoetherian X]

/-- Smooth endpoint invariance holds for the whole ideal sheaves on a nonaffine relation. -/
theorem boundaryIdealSheaf_comap_eq (a b : Z ⟶ X) [Smooth a] [Smooth b]
    (h : a ⁻¹ᵁ fullFiberInterior π O = b ⁻¹ᵁ fullFiberInterior π O) :
    (boundaryIdealSheaf π O).comap a = (boundaryIdealSheaf π O).comap b := by
  apply Scheme.IdealSheafData.ext
  funext U
  have he := map_denominator_eq_of_smooth π O (U.1.ι ≫ a) (U.1.ι ≫ b) (by
    simpa only [Scheme.Hom.comp_preimage] using congrArg (fun W ↦ U.1.ι ⁻¹ᵁ W) h)
  have hi : ((boundaryIdealSheaf π O).comap (U.1.ι ≫ a)).ideal
      ⟨⊤, isAffineOpen_top U⟩ =
      ((boundaryIdealSheaf π O).comap (U.1.ι ≫ b)).ideal
        ⟨⊤, isAffineOpen_top U⟩ := by
    rw [Scheme.IdealSheafData.ideal_comap_top, Scheme.IdealSheafData.ideal_comap_top,
      boundaryIdealSheaf_top]
    exact he
  rw [Scheme.IdealSheafData.comap_comp, Scheme.IdealSheafData.comap_comp,
    Scheme.IdealSheafData.ideal_comap_ι_top, Scheme.IdealSheafData.ideal_comap_ι_top] at hi
  apply_fun Ideal.map U.1.topIso.hom.hom at hi
  simpa only [Ideal.map_map, ← CommRingCat.hom_comp, Iso.inv_hom_id,
    CommRingCat.hom_id, Ideal.map_id] using hi

/-- Exact ideal-sheaf invariance survives every further scheme test. -/
theorem boundaryIdealSheaf_comap_test_eq (a b : Z ⟶ X) [Smooth a] [Smooth b]
    (h : a ⁻¹ᵁ fullFiberInterior π O = b ⁻¹ᵁ fullFiberInterior π O)
    {T : Scheme.{u}} (z : T ⟶ Z) :
    (boundaryIdealSheaf π O).comap (z ≫ a) =
      (boundaryIdealSheaf π O).comap (z ≫ b) := by
  rw [Scheme.IdealSheafData.comap_comp, Scheme.IdealSheafData.comap_comp,
    boundaryIdealSheaf_comap_eq π O a b h]

/-- Arbitrary affine tests retain equality of the full ideals, including nilpotent equations. -/
theorem map_denominator_test_eq (a b : Z ⟶ X) [Smooth a] [Smooth b]
    (h : a ⁻¹ᵁ fullFiberInterior π O = b ⁻¹ᵁ fullFiberInterior π O)
    {T : Scheme.{u}} [IsAffine T] (z : T ⟶ Z) :
    (denominatorIdeal π.appTop.hom O).map (z ≫ a).appTop.hom =
      (denominatorIdeal π.appTop.hom O).map (z ≫ b).appTop.hom := by
  have he := congrArg (fun I : T.IdealSheafData ↦ I.ideal ⟨⊤, isAffineOpen_top T⟩)
    (boundaryIdealSheaf_comap_test_eq π O a b h z)
  simpa only [Scheme.IdealSheafData.ideal_comap_top, boundaryIdealSheaf_top] using he

end FLT.Mazur.SchemeOpenEnvelope
