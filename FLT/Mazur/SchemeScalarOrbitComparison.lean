module

public import FLT.Mazur.ScalarOrbitQuotientComparison
public import FLT.Mazur.SchemeFiniteGroupFreeFlat

/-!
# The actual closed orbit relation over prescribed scheme scalars

The scalar map is an arbitrary map into the fixed global functions. It is not
replaced by the full fixed ring. Freeness constructs a closed orbit comparison
whose exact ideal records the failure of invariant endpoint agreement.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry TensorProduct
namespace FLT.Mazur.SchemeScalarOrbitComparison
open SchemeCoordinateAction SchemeFiniteGroupQuotient FiniteGroupQuotient
universe u
variable {G : Type u} [Group G] {X : Scheme.{u}} (ρ : G →* Aut X)
  {R : Type u} [CommRing R] (s : R →+* invariantCoordinates ρ)

/-- The original scalar map acts through its actual inclusion into the source functions. -/
abbrev sourceAlgebra : Algebra R Γ(X, ⊤) :=
  let _ := coordinateAction ρ
  ((inclusion G Γ(X, ⊤)).comp s).toAlgebra

/-- The full tensor ring over the prescribed scalars, with both source copies unchanged. -/
abbrev tensorCoordinates : CommRingCat.{u} :=
  let _ := sourceAlgebra ρ s
  .of (Γ(X, ⊤) ⊗[R] Γ(X, ⊤))

/-- Full orbit coordinates on the tensor product over the prescribed original scalars. -/
def coordinates : tensorCoordinates ρ s →+* (G → Γ(X, ⊤)) := by
  let _ := coordinateAction ρ
  let _ := s.toAlgebra
  let _ := sourceAlgebra ρ s
  let _ : IsScalarTower R (invariantCoordinates ρ) Γ(X, ⊤) :=
    IsScalarTower.of_algebraMap_eq' rfl
  exact (ScalarOrbitTensorComparison.comparison G R Γ(X, ⊤)).toRingHom

/-- Evaluation uses the literal inverse-action pullback on the original scheme. -/
theorem coordinates_tmul (a b : Γ(X, ⊤)) (g : G) :
    let _ := sourceAlgebra ρ s
    coordinates ρ s (a ⊗ₜ[R] b) g = a * (ρ g⁻¹).hom.appTop b := rfl

/-- The original scalar orbit relation, before assuming coverage of the scalar kernel pair. -/
def orbitArrow : Spec (.of (G → Γ(X, ⊤))) ⟶ Spec (tensorCoordinates ρ s) :=
  Spec.map (CommRingCat.ofHom (coordinates ρ s))

variable [Finite G] [IsAffine X]
  (hfree : ∀ (K : Type u) [Field K] (a : Spec (.of K) ⟶ X) (g : G),
    a ≫ (ρ g).hom = a → g = 1)
include hfree

/-- Field-valued scheme freeness gives a surjection onto the full original orbit algebra. -/
theorem coordinates_surjective : Function.Surjective (coordinates ρ s) := by
  let _ := coordinateAction ρ
  let _ := s.toAlgebra
  let _ := sourceAlgebra ρ s
  let _ : IsScalarTower R (invariantCoordinates ρ) Γ(X, ⊤) :=
    IsScalarTower.of_algebraMap_eq' rfl
  exact ScalarOrbitTensorComparison.comparison_surjective G R Γ(X, ⊤)
    (coordinate_fixedPointIdeal_eq_top ρ hfree)

/-- Field-valued scheme freeness constructs a closed immersion over the original scalars. -/
theorem orbitArrow_closedImmersion : IsClosedImmersion (orbitArrow ρ s) :=
  IsClosedImmersion.spec_of_surjective _ (coordinates_surjective ρ s hfree)

/-- Its full defining ideal is generated by differences of actual invariant sections. -/
theorem coordinates_ker :
    let _ := sourceAlgebra ρ s
    RingHom.ker (coordinates ρ s) =
      Ideal.span (Set.range (fun a : invariantCoordinates ρ ↦
        (a.val ⊗ₜ[R] (1 : Γ(X, ⊤))) - (1 ⊗ₜ[R] a.val))) := by
  let _ := coordinateAction ρ
  let _ := s.toAlgebra
  let _ := sourceAlgebra ρ s
  let _ : IsScalarTower R (invariantCoordinates ρ) Γ(X, ⊤) :=
    IsScalarTower.of_algebraMap_eq' rfl
  exact ScalarOrbitTensorComparison.comparison_ker_eq_balancingIdeal G R Γ(X, ⊤)
    (coordinate_fixedPointIdeal_eq_top ρ hfree)

/-- Exact original scalar fullness, when proved, makes this comparison an isomorphism. -/
theorem coordinates_bijective_of_full (hfull : Function.Surjective s) :
    Function.Bijective (coordinates ρ s) := by
  let _ := coordinateAction ρ
  let _ := s.toAlgebra
  let _ := sourceAlgebra ρ s
  let _ : IsScalarTower R (invariantCoordinates ρ) Γ(X, ⊤) :=
    IsScalarTower.of_algebraMap_eq' rfl
  exact (ScalarOrbitTensorComparison.fullComparison G R Γ(X, ⊤)
    (coordinate_fixedPointIdeal_eq_top ρ hfree) hfull).bijective

end FLT.Mazur.SchemeScalarOrbitComparison
