module

public import FLT.Mazur.GeneratedRelationReductionKernel
public import FLT.Mazur.PolygonCompleteIdentityFirstChartAmbientGenerators
public import FLT.Mazur.PolygonCompleteIdentityFirstChartAmbientErrors

/-!
# Generators of the full original residual node kernel

The ambient kernel is generated by the original parameter and all actual
target errors. On the literal closed fiber, the parameter is already zero,
so the target errors generate the entire residual ideal.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing LaurentPolynomial LaurentFirstStageParameter
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointWeierstrassCurve completePointToIntegralCubic originalStageToCompatibleProj
  completeIdentityFirstActionUnit completeIdentityFirstActionField
  completeIdentityFirstActionNodeDefect completeIdentityFirstErrorAlgebra
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n]
local notation "t" => parameter K 1
local notation "e" => parameter K[T;T⁻¹] 1
local notation "s" => completeIdentityFirstAmbientSourceFunctions K n h
local notation "p" => completeIdentityFirstAmbientTargetFunctions K n h
local notation "a" => stageCoefficientMap (C : K →+* K[T;T⁻¹]) 1
local notation "b" => ringMap (a) (t) (e) (stageCoefficientMap_parameter _ _)
local notation "σ" => reciprocalScale (e) (parameterUnit K)
local notation "f" => completeIdentityFirstChartClosedAmbientMap K n h
local notation "d" => completeIdentityFirstAmbientNodeReduction K n h
local notation "r" => completeIdentityFirstChartClosedReduction K n h

/-- The full ambient node kernel is generated by the original parameter and actual target errors. -/
theorem completeIdentityFirstAmbientNodeKernel_generators :
    RingHom.ker (d) = Ideal.span {completeIdentityFirstAmbientParameter K n h} ⊔
      Ideal.span (Set.range (completeIdentityFirstAmbientError K n h)) := by
  have he := GeneratedRelationReductionKernel.kernel_eq (s) (p)
    ((σ).toRingHom.comp (b)) (d) (firstNodeReduction K[T;T⁻¹])
    (completeIdentityFirstAmbientFunctions_generate K n h)
    (firstNodeReduction_surjective K[T;T⁻¹])
    (RingHom.ext (completeIdentityFirstAmbientNodeReduction_source K n h))
    (RingHom.ext (completeIdentityFirstAmbientNodeReduction_target K n h))
  rw [GeneratedRelationReductionKernel.relations, firstNodeReduction_ker,
    Ideal.map_span, Set.image_singleton] at he
  exact he

/-- The original parameter is killed by the actual full closed-fiber map. -/
theorem completeIdentityFirstChartClosedAmbientMap_parameter :
    (f) (completeIdentityFirstAmbientParameter K n h) = 0 := by
  change completeIdentityFirstChartClosedQuotient K n h
    ((completeIdentityActionGraphAdicChartEmbedding K n h 1 0 0).appTop _) = _
  rw [completeIdentityFirstAmbientParameter_restrict,
    completeIdentityFirstChartClosedQuotient_parameter]

/-- Actual target errors generate every element of the full closed-fiber residual ideal. -/
theorem completeIdentityFirstChartResidualKernel_generators :
    RingHom.ker (r) = Ideal.span (Set.range (completeIdentityFirstChartClosedError K n h)) := by
  rw [← completeIdentityFirstChartResidualKernel_image,
    completeIdentityFirstAmbientNodeKernel_generators, Ideal.map_sup,
    Ideal.map_span, Set.image_singleton, completeIdentityFirstChartClosedAmbientMap_parameter,
    Ideal.span_singleton_zero, bot_sup_eq, Ideal.map_span, ← Set.range_comp]
  rfl

end FLT.Mazur.PolygonInfinitesimalStages
