module

public import FLT.Mazur.FiniteCoefficientDifferenceIdeal
public import Mathlib.Algebra.Group.Pointwise.Set.BigOperators

/-!
# Explicit mixed products of endpoint coefficient differences

A finite product of full difference ideals is generated by products choosing
one original coefficient in each coordinate. This gives exact annihilation
and correction tests over arbitrary rings, without a reducedness assumption.
-/

@[expose] public noncomputable section
open scoped BigOperators Pointwise
namespace FLT.Mazur.FiniteCoefficientDifference
variable {I B T : Type*} [Fintype I] [CommRing B] [CommRing T]
  (l r : I → B →+* T)

/-- Products of endpoint ideals have explicit generators in the original coefficients. -/
theorem product_differenceIdeal_eq :
    (∏ i, differenceIdeal (l i) (r i)) =
      Ideal.span (Set.range fun a : I → B ↦ ∏ i, (l i (a i) - r i (a i))) := by
  classical
  simp only [differenceIdeal]
  rw [Ideal.prod_span]
  congr 1
  ext z
  rw [Set.mem_finsetProd]
  constructor
  · rintro ⟨v, hv, rfl⟩
    choose a ha using fun i ↦ @hv i (Finset.mem_univ i)
    exact ⟨a, Finset.prod_congr rfl (fun i _ ↦ ha i)⟩
  · rintro ⟨a, rfl⟩
    exact ⟨fun i ↦ l i (a i) - r i (a i), fun {i} _ ↦ ⟨a i, rfl⟩, rfl⟩

/-- Membership of every mixed coefficient product detects exact ideal containment. -/
theorem product_differenceIdeal_le_iff (K : Ideal T) :
    (∏ i, differenceIdeal (l i) (r i)) ≤ K ↔
      ∀ a : I → B, (∏ i, (l i (a i) - r i (a i))) ∈ K := by
  rw [product_differenceIdeal_eq, Ideal.span_le, Set.range_subset_iff]
  rfl

/-- Full vanishing requires all mixed products, with no cancellation of powers. -/
theorem product_differenceIdeal_eq_bot_iff :
    (∏ i, differenceIdeal (l i) (r i)) = ⊥ ↔
      ∀ a : I → B, (∏ i, (l i (a i) - r i (a i))) = 0 := by
  rw [← le_bot_iff, product_differenceIdeal_le_iff]
  rfl

/-- Under a correction ideal, the same explicit products test the full comparison obstruction. -/
theorem product_differenceIdeal_map_eq_bot_iff (K : Ideal T) :
    Ideal.map (Ideal.Quotient.mk K) (∏ i, differenceIdeal (l i) (r i)) = ⊥ ↔
      ∀ a : I → B, (∏ i, (l i (a i) - r i (a i))) ∈ K := by
  rw [← le_bot_iff, Ideal.map_le_iff_le_comap]
  change (∏ i, differenceIdeal (l i) (r i)) ≤ RingHom.ker (Ideal.Quotient.mk K) ↔ _
  rw [Ideal.mk_ker, product_differenceIdeal_le_iff]

end FLT.Mazur.FiniteCoefficientDifference
