module

public import FLT.Mazur.WeierstrassSuccessiveExteriorCenter
public import FLT.Mazur.WeierstrassSuccessiveXFlat

/-!
# Deeper original centers on every retained successive x chart

Every further original center is generated by the original horizontal
coordinate on a successive x chart. That generator is regular and remains
so under the flat presentations supplied by the actual input atlas.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.WeierstrassSuccessiveX
set_option backward.isDefEq.respectTransparency false
variable {R : Type*} [CommRing R] (W : WeierstrassCurve R) (s π b3 b4 b6 : R)
  (h3 : W.a₃ = s * (π * b3)) (h4 : W.a₄ = s * (π * b4))
  (h6 : W.a₆ = s ^ 2 * (π ^ 2 * b6))
local notation "A" => Coordinate W s π b3 b4 b6
local notation "T" => coord W s π b3 b4 b6 0
local notation "V" => coord W s π b3 b4 b6 1
local notation "U" => coord W s π b3 b4 b6 2
local notation "c" => AlgHom.comp (fromDivided W s π b3 b4 b6)
  (WeierstrassDilatation.fromOriginal W s (π * b3) (π * b4) (π ^ 2 * b6) h3 h4 h6)

/-- Any deeper original center is principal on the actual successive x chart. -/
theorem originalDeeperCenter_map_successiveX (r : R) :
    (WeierstrassIntegralChart.modificationChartCenter W (s * (π * r)) 2).map
        (c).toRingHom = Ideal.span {algebraMap R A s * U} := by
  rw [WeierstrassIntegralChart.modificationChartCenter_map]
  simp only [AlgHom.coe_comp,
    Function.comp_apply, WeierstrassDilatation.fromOriginal_x,
    WeierstrassDilatation.fromOriginal_y, map_mul, AlgHom.commutes,
    fromDivided_x, fromDivided_y, ← incidence W s π b3 b4 b6]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · exact Ideal.mem_span_singleton.mpr ⟨T * algebraMap R A r, by ring⟩
    · exact Ideal.subset_span (Set.mem_singleton _)
    · exact Ideal.mem_span_singleton.mpr ⟨V, by ring⟩
  · apply Ideal.span_mono
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst z
    simp

/-- The deeper generator formula is preserved by arbitrary ring presentations. -/
theorem originalDeeperCenter_map_successiveXPresentation {S : Type*} [CommRing S]
    (r : R) (ψ : A →+* S) :
    (WeierstrassIntegralChart.modificationChartCenter W (s * (π * r)) 2).map
        (ψ.comp (c).toRingHom) = Ideal.span {ψ (algebraMap R A s * U)} := by
  rw [← Ideal.map_map, originalDeeperCenter_map_successiveX, Ideal.map_span]
  simp only [Set.image_singleton]

/-- The original horizontal generator is regular on a retained successive chart. -/
theorem originalHorizontal_regular [IsDomain R] (hπ : π ≠ 0) (hs : s ≠ 0) :
    IsRegular (algebraMap R A s * U) :=
  (base_regular W s π b3 b4 b6 hπ hs).mul (u_regular W s π b3 b4 b6 hπ)

/-- Actual flat presentations preserve the retained original horizontal generator. -/
theorem originalHorizontalPresentation_regular [IsDomain R]
    (hπ : π ≠ 0) (hs : s ≠ 0) {S : Type*} [CommRing S]
    (ψ : A →+* S) (hψ : RingHom.Flat ψ) :
    IsRegular (ψ (algebraMap R A s * U)) :=
  WeierstrassIntegralChart.flatRingHom_isRegular ψ hψ
    (originalHorizontal_regular W s π b3 b4 b6 hπ hs)

end FLT.Mazur.WeierstrassSuccessiveX
