module

public import FLT.Mazur.FlatSectionLiftCertificate
public import Mathlib.LinearAlgebra.TensorProduct.Prod

/-!
# Lifting multipliers under a flat change of coefficient ground

Extend all three coefficient rings over the ground ring, rather than extending
only the invariant ring. The entire multiplier ideal commutes with this change,
including multipliers which have no individual original preimage.
-/

@[expose] public noncomputable section
open TensorProduct
namespace FLT.Mazur.GroundFlatSectionLiftIdeal
variable {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
  [Algebra R A] [Algebra R B] (f : A →ₐ[R] B) (t : B)

/-- The original numerator equation over the coefficient ground. -/
def numerator : A × A →ₗ[R] B := f.toLinearMap.comp (LinearMap.snd R A A)

/-- The original multiplier equation over the same ground. -/
def denominator : A × A →ₗ[R] B where
  toFun x := f x.1 * t
  map_add' x y := by simp only [Prod.fst_add, map_add, add_mul]
  map_smul' r x := by simp only [Prod.smul_fst, map_smul, smul_mul_assoc, RingHom.id_apply]

/-- Original solutions retain both multiplier and numerator. -/
abbrev solutions := FlatTensorEqualizer.equalizer (numerator f) (denominator f t)

/-- Extract the multiplier from the original equation. -/
def multiplier : solutions f t →ₗ[R] A :=
  (LinearMap.fst R A A).comp (solutions f t).subtype

/-- Every original solution gives an actual lifting multiplier. -/
theorem multiplier_mem (x : solutions f t) :
    multiplier f t x ∈ sectionLiftIdeal f.toRingHom t :=
  ⟨x.val.2, (FlatTensorEqualizer.mem_equalizer _ _ _).mp x.property⟩

variable (S : Type*) [CommRing S] [Algebra R S]
set_option quotPrecheck false in
local notation "j" => (Algebra.TensorProduct.includeRight : A →ₐ[R] S ⊗[R] A).toRingHom
set_option quotPrecheck false in
local notation "fs" => (FlatAlgebraEqualizer.tensorMap S f).toRingHom
set_option quotPrecheck false in
local notation "J" => (sectionLiftIdeal f.toRingHom t).map j

/-- Tensoring original solutions produces multipliers in the extended ideal. -/
theorem tensor_multiplier_mem (x : S ⊗[R] solutions f t) :
    (multiplier f t).lTensor S x ∈ J := by
  induction x using TensorProduct.inductionOn with
  | tmul s x =>
      have h := Ideal.mem_map_of_mem j (multiplier_mem f t x)
      have hm := (J).mul_mem_left (s ⊗ₜ[R] (1 : A)) h
      change (s ⊗ₜ[R] (1 : A)) * (1 ⊗ₜ[R] multiplier f t x) ∈ J at hm
      simpa only [LinearMap.lTensor_tmul,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul] using hm
  | add x y hx hy => simpa only [map_add] using (J).add_mem hx hy

/-- Tensoring the first projection is exactly the first product coordinate. -/
theorem tensor_fst (x : S ⊗[R] (A × A)) :
    (LinearMap.fst R A A).lTensor S x = (prodRight R R S A A x).1 := by
  induction x using TensorProduct.inductionOn with
  | tmul s a => rfl
  | add x y hx hy => simp only [map_add, Prod.fst_add, hx, hy]

/-- The numerator equation after extension keeps the second product coordinate. -/
theorem tensor_numerator (x : S ⊗[R] (A × A)) :
    (numerator f).lTensor S x = fs (prodRight R R S A A x).2 := by
  induction x using TensorProduct.inductionOn with
  | tmul s a => rfl
  | add x y hx hy => simp only [map_add, Prod.snd_add, hx, hy]

/-- The denominator equation after extension keeps the prescribed original section. -/
theorem tensor_denominator (x : S ⊗[R] (A × A)) :
    (denominator f t).lTensor S x =
      fs (prodRight R R S A A x).1 * (1 ⊗ₜ[R] t) := by
  induction x using TensorProduct.inductionOn with
  | tmul s a =>
      simp only [LinearMap.lTensor_tmul, denominator, LinearMap.coe_mk,
        AddHom.coe_mk, prodRight_tmul]
      change s ⊗ₜ[R] (f a.1 * t) = (s ⊗ₜ[R] f a.1) * (1 ⊗ₜ[R] t)
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
  | add x y hx hy => simp only [map_add, Prod.fst_add, add_mul, hx, hy]

variable [Module.Flat R S]

/-- Every extended multiplier descends to the ideal generated by original solutions. -/
theorem extended_multiplier_mem (s a : S ⊗[R] A)
    (ha : fs a = fs s * (1 ⊗ₜ[R] t)) : s ∈ J := by
  let x := (prodRight R R S A A).symm (s, a)
  have hx : (numerator f).lTensor S x = (denominator f t).lTensor S x := by
    rw [tensor_numerator, tensor_denominator]
    simpa only [x, LinearEquiv.apply_symm_apply] using ha
  obtain ⟨y, hy, _⟩ := FlatTensorEqualizer.existsUnique_lift
    (numerator f) (denominator f t) S x hx
  have hm : (multiplier f t).lTensor S y = s := by
    rw [multiplier, LinearMap.lTensor_comp, LinearMap.comp_apply, hy, tensor_fst]
    simp only [x, LinearEquiv.apply_symm_apply]
  exact hm ▸ tensor_multiplier_mem f t S y

/-- Flat ground extension preserves the whole lifting multiplier ideal. -/
theorem ideal_map :
    (sectionLiftIdeal f.toRingHom t).map j =
      sectionLiftIdeal fs (1 ⊗ₜ[R] t) := by
  apply le_antisymm
  · apply Ideal.map_le_iff_le_comap.mpr
    rintro s ⟨a, ha⟩
    refine ⟨1 ⊗ₜ[R] a, ?_⟩
    change 1 ⊗ₜ[R] f a = (1 ⊗ₜ[R] f s) * (1 ⊗ₜ[R] t)
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
    exact congrArg (fun b ↦ (1 : S) ⊗ₜ[R] b) ha
  · rintro s ⟨a, ha⟩
    exact extended_multiplier_mem f t S s a ha

end FLT.Mazur.GroundFlatSectionLiftIdeal
