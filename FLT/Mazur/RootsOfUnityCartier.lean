module

public import FLT.Mazur.RootsOfUnityScheme
public import FLT.Mazur.MultiplicativeGroupDimension
public import FLT.Mazur.AffineSmoothFiniteFlatCartier

/-!
# The roots-of-unity subgroup as a relative Cartier divisor

The ideal is the full kernel of the constructed closed subgroup inclusion.
Its closed family is identified over the base with that subgroup, giving
finite locally free degree and the relative effective Cartier property.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

open CategoryTheory AlgebraicGeometry

namespace FLT.Mazur.RootsOfUnityCartier

open RootsOfUnityScheme MultiplicativeGroupScheme FCurve

universe u
variable (R : Type u) [CommRing R] (n : ℕ) [NeZero n]

/-- The actual ideal of the closed roots-of-unity subgroup. -/
def ideal : (gm R).left.IdealSheafData := (inclusion R n).left.ker

/-- The subgroup is its closed image, with the original map to the base. -/
def imageOverIso : model R n ≅ Over.mk ((ideal R n).subschemeι ≫ (gm R).hom) :=
  Over.isoMk (asIso (inclusion R n).left.toImage) (by
    change (inclusion R n).left.toImage ≫ (inclusion R n).left.imageι ≫ (gm R).hom = _
    rw [← Category.assoc, Scheme.Hom.toImage_imageι]
    exact (inclusion R n).w)

/-- The ideal's actual closed family has degree n, including in characteristic dividing n. -/
theorem ideal_degree :
    FiniteLocallyFreeDegree ((ideal R n).subschemeι ≫ (gm R).hom) n :=
  (finiteLocallyFreeDegree_iff_of_overIso (imageOverIso R n)).mp (degree R n)

/-- Roots of unity are a relative effective Cartier divisor in the multiplicative group. -/
theorem relativeCartier : RelativeEffectiveCartier (gm R).hom (ideal R n) := by
  let _ : IsAffineHom (gm R).hom :=
    inferInstanceAs (IsAffineHom (Spec.map
      (CommRingCat.ofHom (algebraMap R (LaurentPolynomial R)))))
  exact relativeEffectiveCartier_of_affine_smooth_degree (gm R).hom (ideal R n) n (ideal_degree R n)

/-- In particular the full subgroup ideal is locally generated by a regular element. -/
theorem effectiveCartier : EffectiveCartier (ideal R n) := (relativeCartier R n).1

/-- Positive degree makes the constructed finite flat subgroup faithfully flat over the base. -/
theorem surjective : Surjective (model R n).hom :=
  (degree R n).surjective (NeZero.pos n)

/-- The closed divisor family also covers the whole arithmetic base. -/
theorem ideal_surjective : Surjective ((ideal R n).subschemeι ≫ (gm R).hom) :=
  (ideal_degree R n).surjective (NeZero.pos n)

end FLT.Mazur.RootsOfUnityCartier
