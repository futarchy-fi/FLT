module

public import FLT.Mazur.ScalarOrbitTensorComparison
public import Mathlib.LinearAlgebra.TensorProduct.Quotient

/-!
# Full equations obstructing the original scalar orbit comparison

The kernel is generated by differences of the two copies of actual invariant
functions. This is equality of ideals in the original tensor ring, including
nilpotents, rather than equality of their radicals or their field-valued zeros.
-/

@[expose] public noncomputable section
open TensorProduct
namespace FLT.Mazur.ScalarOrbitTensorComparison
open FiniteGroupQuotient
variable (G R A : Type*) [Group G] [CommRing R] [CommRing A]
  [MulSemiringAction G A] [Algebra R A] [Algebra R (invariantRing G A)]
  [IsScalarTower R (invariantRing G A) A]
local notation "S" => invariantRing G A
local notation "C" => A ⊗[R] A

/-- The unchanged scalar tensor equations for every full invariant function. -/
def balancingIdeal : Ideal C :=
  Ideal.span (Set.range (fun s : S ↦ (s.val ⊗ₜ[R] (1 : A)) - (1 ⊗ₜ[R] s.val)))

/-- Changing the base imposes exactly the invariant balancing equations. -/
theorem toFixedTensor_ker : RingHom.ker (toFixedTensor G R A).toRingHom =
    balancingIdeal G R A := by
  apply le_antisymm
  · intro t ht
    change t ∈ (TensorProduct.mapOfCompatibleSMul S R S A A).ker at ht
    rw [TensorProduct.AlgebraTensorModule.ker_mapOfCompatibleSMul] at ht
    induction ht using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨s, a, b, rfl⟩ := hx
      have h := (balancingIdeal G R A).mul_mem_left (a ⊗ₜ[R] b)
        (Ideal.subset_span (Set.mem_range_self s))
      change (s.val * a) ⊗ₜ[R] b - a ⊗ₜ[R] (s.val * b) ∈ balancingIdeal G R A
      simpa only [mul_sub, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        mul_comm a s.val, mul_comm b s.val] using h
    | zero => exact (balancingIdeal G R A).zero_mem
    | add x y _ _ hx hy => exact (balancingIdeal G R A).add_mem hx hy
    | smul s x _ hx =>
      exact (balancingIdeal G R A).smul_of_tower_mem s hx
  · apply Ideal.span_le.mpr
    rintro _ ⟨s, rfl⟩
    change s.val ⊗ₜ[S] (1 : A) - (1 ⊗ₜ[S] s.val) = 0
    apply sub_eq_zero.mpr
    have h := TensorProduct.smul_tmul (R := S) s (1 : A) (1 : A)
    change (s.val * 1) ⊗ₜ[S] (1 : A) = (1 : A) ⊗ₜ[S] (s.val * 1) at h
    simpa only [mul_one] using h

variable [Finite G] (hfree : ∀ g : G, g ≠ 1 → fixedPointIdeal G A g = ⊤)
include hfree

/-- Freeness identifies the full original comparison kernel, without scalar fullness. -/
theorem comparison_ker_eq_balancingIdeal :
    RingHom.ker (comparison G R A).toRingHom = balancingIdeal G R A := by
  rw [comparison_ker G R A hfree, toFixedTensor_ker]

/-- The obstruction vanishes exactly when the original comparison is injective. -/
theorem comparison_injective_iff : Function.Injective (comparison G R A) ↔
    balancingIdeal G R A = ⊥ := by
  change Function.Injective (comparison G R A).toRingHom ↔ _
  rw [RingHom.injective_iff_ker_eq_bot, comparison_ker_eq_balancingIdeal G R A hfree]

end FLT.Mazur.ScalarOrbitTensorComparison
