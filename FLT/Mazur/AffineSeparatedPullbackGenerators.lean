module

public import Mathlib.AlgebraicGeometry.Morphisms.Separated
public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.Algebra.Category.Ring.Constructions

/-!
# Functions on affine relations over separated targets

For two affine schemes mapping to a scheme separated over an affine base,
their pullback ring is generated by the two original coordinate maps.
The target itself need not be affine.
-/

@[expose] public noncomputable section
open CategoryTheory Limits AlgebraicGeometry
namespace FLT.Mazur.AffineSeparatedPullbackGenerators
universe u
variable {X Y S T : Scheme.{u}} [IsAffine X] [IsAffine Y] [IsAffine T]
variable (f : X ⟶ S) (g : Y ⟶ S) (i : S ⟶ T) [IsSeparated i]
include i

/-- A separated relation between affine charts is generated by the unchanged two projections. -/
theorem closure_eq_top :
    Subring.closure (Set.range (pullback.fst f g).appTop ∪
      Set.range (pullback.snd f g).appTop) = ⊤ := by
  let m := pullback.mapDesc f g i
  let U := Subring.closure (Set.range (pullback.fst f g).appTop ∪
    Set.range (pullback.snd f g).appTop)
  have hm : Function.Surjective m.appTop :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine m).2
  have hgen := CommRingCat.closure_range_union_range_eq_top_of_isPushout
    (isPushout_appTop_of_isPullback (IsPullback.of_hasPullback (f ≫ i) (g ≫ i)))
  have hle : (⊤ : Subring Γ(pullback (f ≫ i) (g ≫ i), ⊤)) ≤ U.comap m.appTop.hom := by
    rw [← hgen]
    apply Subring.closure_le.mpr
    rintro z (⟨x, rfl⟩ | ⟨y, rfl⟩)
    · change m.appTop ((pullback.fst (f ≫ i) (g ≫ i)).appTop x) ∈ U
      have he : m ≫ pullback.fst (f ≫ i) (g ≫ i) = pullback.fst f g := by
        simp only [m, pullback.mapDesc, pullback.map, pullback.lift_fst, Category.comp_id]
      change ((pullback.fst (f ≫ i) (g ≫ i)).appTop ≫ m.appTop) x ∈ U
      rw [← Scheme.Hom.comp_appTop, he]
      exact Subring.subset_closure (Or.inl ⟨x, rfl⟩)
    · change m.appTop ((pullback.snd (f ≫ i) (g ≫ i)).appTop y) ∈ U
      have he : m ≫ pullback.snd (f ≫ i) (g ≫ i) = pullback.snd f g := by
        simp only [m, pullback.mapDesc, pullback.map, pullback.lift_snd, Category.comp_id]
      change ((pullback.snd (f ≫ i) (g ≫ i)).appTop ≫ m.appTop) y ∈ U
      rw [← Scheme.Hom.comp_appTop, he]
      exact Subring.subset_closure (Or.inr ⟨y, rfl⟩)
  apply top_unique
  intro z _
  obtain ⟨w, rfl⟩ := hm z
  exact hle (Subring.mem_top w)

end FLT.Mazur.AffineSeparatedPullbackGenerators
