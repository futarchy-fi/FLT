module

public import FLT.Mazur.PolygonCompleteIdentityFirstDefectProduct
public import FLT.Mazur.PolygonSmoothingRangeGenerators
public import FLT.Mazur.SquareZeroPairAdjoin

/-!
# The actual first-order node graph algebra is finite

Inside the two full punctured branches, join the original node algebra with
its unchanged action image. This actual graph algebra is obtained by adjoining
exactly the two coordinate errors, whose pairwise products vanish. It is a
finite extension; no equality with the original node algebra is assumed.
-/

@[expose] public noncomputable section
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing LaurentFirstStageParameter
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] PolygonSmoothing.relationIdeal
  completeIdentityFirstActionUnit completeIdentityFirstActionField
  completeIdentityFirstActionNodeDefect
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (i : Fin n)
local notation "R" => K[T;T⁻¹]
local notation "S" => Ring (R) 1
local notation "e" => parameter (R) 1
local notation "B" => ChartRing (e)
local notation "L" => (S)[T;T⁻¹]
local notation "C" => firstNodeBranchSubalgebra (R)
local notation "β" => firstNodeBranchPair (R)
local notation "F" => completeIdentityFirstActionBranchEquiv K n h i
local notation "D" => completeIdentityFirstActionNodeDefect K n h i
local notation "x" => leftCoordinate (e)
local notation "y" => rightCoordinate (e)
local notation "σ" => reciprocalScale (e) (parameterUnit K)

/-- The algebra generated by the source and target of the unchanged original node action. -/
def completeIdentityFirstGraphAlgebra : Subalgebra (S) ((L) × (L)) :=
  (C) ⊔ ((F).toAlgHom.comp (β)).range

/-- Adjoin the two actual original coordinate errors over the embedded source node algebra. -/
def completeIdentityFirstErrorAlgebra : Subalgebra (C) ((L) × (L)) :=
  Algebra.adjoin (C) ({(D) (x), (D) (y)} : Set ((L) × (L)))

/-- The two error generators give a finite module over the original node algebra. -/
instance completeIdentityFirstErrorAlgebra_finite :
    Module.Finite (C) (completeIdentityFirstErrorAlgebra K n h i) :=
  SquareZeroPairAdjoin.finite _ _
    (completeIdentityFirstActionNodeDefect_mul_zero K n h i (x) (x))
    (completeIdentityFirstActionNodeDefect_mul_zero K n h i (y) (y))

/-- The error algebra has an explicit three-term normal form with original node coefficients. -/
theorem completeIdentityFirstErrorAlgebra_normalForm (z : (L) × (L))
    (hz : z ∈ completeIdentityFirstErrorAlgebra K n h i) :
    ∃ a b c : C, z = a.val + b.val * (D) (x) + c.val * (D) (y) :=
  @SquareZeroPairAdjoin.normalForm (C) ((L) × (L)) _ _ _ _ _
    (completeIdentityFirstActionNodeDefect_mul_zero K n h i (x) (x))
    (completeIdentityFirstActionNodeDefect_mul_zero K n h i (x) (y))
    (completeIdentityFirstActionNodeDefect_mul_zero K n h i (y) (y)) z hz

/-- The embedded original node is contained in the error algebra. -/
theorem completeIdentityFirstErrorAlgebra_source :
    (C) ≤ (completeIdentityFirstErrorAlgebra K n h i).restrictScalars (S) := by
  intro z hz
  exact (completeIdentityFirstErrorAlgebra K n h i).algebraMap_mem ⟨z, hz⟩

/-- Both original coordinate images belong to this concrete finite extension. -/
theorem completeIdentityFirstErrorAlgebra_coordinate (z : B)
    (hz : z = (x) ∨ z = (y)) :
    (F) ((β) z) ∈ completeIdentityFirstErrorAlgebra K n h i := by
  have hd : (D) z ∈ completeIdentityFirstErrorAlgebra K n h i := by
    apply Algebra.subset_adjoin
    rcases hz with rfl | rfl <;> simp
  have hs : (β) ((σ) z) ∈ completeIdentityFirstErrorAlgebra K n h i :=
    completeIdentityFirstErrorAlgebra_source K n h i ⟨_, rfl⟩
  have hm := (completeIdentityFirstErrorAlgebra K n h i).add_mem hd hs
  simpa only [completeIdentityFirstActionNodeDefect_apply, sub_add_cancel] using hm

/-- The finite extension contains every original action image, with all nilpotents retained. -/
theorem completeIdentityFirstErrorAlgebra_target :
    ((F).toAlgHom.comp (β)).range ≤
      (completeIdentityFirstErrorAlgebra K n h i).restrictScalars (S) := by
  apply (range_le_iff_coordinates (e) _ _).mpr
  exact ⟨completeIdentityFirstErrorAlgebra_coordinate K n h i (x) (Or.inl rfl),
    completeIdentityFirstErrorAlgebra_coordinate K n h i (y) (Or.inr rfl)⟩

/-- The finite error extension is precisely the actual source-target graph algebra. -/
theorem completeIdentityFirstErrorAlgebra_eq_graph :
    (completeIdentityFirstErrorAlgebra K n h i).restrictScalars (S) =
      completeIdentityFirstGraphAlgebra K n h i := by
  apply le_antisymm
  · intro z hz
    obtain ⟨a, b, c, rfl⟩ := completeIdentityFirstErrorAlgebra_normalForm K n h i z hz
    have hs : (C) ≤ completeIdentityFirstGraphAlgebra K n h i := le_sup_left
    have ht : ((F).toAlgHom.comp (β)).range ≤
        completeIdentityFirstGraphAlgebra K n h i := le_sup_right
    have hd (w : B) : (D) w ∈ completeIdentityFirstGraphAlgebra K n h i := by
      rw [completeIdentityFirstActionNodeDefect_apply]
      exact (completeIdentityFirstGraphAlgebra K n h i).sub_mem
        (ht ⟨w, rfl⟩) (hs ⟨(σ) w, rfl⟩)
    exact Subalgebra.add_mem _
      (Subalgebra.add_mem _ (hs a.property) (Subalgebra.mul_mem _ (hs b.property) (hd (x))))
      (Subalgebra.mul_mem _ (hs c.property) (hd (y)))
  · exact sup_le (completeIdentityFirstErrorAlgebra_source K n h i)
      (completeIdentityFirstErrorAlgebra_target K n h i)

/-- Parameter multiplication of any graph function already belongs to the original node. -/
theorem completeIdentityFirstGraphAlgebra_parameter (z : (L) × (L))
    (hz : z ∈ completeIdentityFirstGraphAlgebra K n h i) :
    (e) • z ∈ (C) := by
  rw [← completeIdentityFirstErrorAlgebra_eq_graph] at hz
  obtain ⟨a, b, c, rfl⟩ := completeIdentityFirstErrorAlgebra_normalForm K n h i z hz
  simp only [smul_add, ← mul_smul_comm,
    completeIdentityFirstActionNodeDefect_parameter, mul_zero, add_zero]
  exact (C).smul_mem a.property (e)

end FLT.Mazur.PolygonInfinitesimalStages
