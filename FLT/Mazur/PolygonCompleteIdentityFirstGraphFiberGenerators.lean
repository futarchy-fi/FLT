module

public import FLT.Mazur.PolygonCompleteIdentityFirstGraphErrors
public import FLT.Mazur.PolygonCompleteIdentityFirstGraphFiberSplit

/-!
# Two original equations generate the literal fiber's residual ideal

The original target-minus-scaling errors descend to the actual special
fiber. Every residual function is a linear combination of the two original
coordinate errors with coefficients from the unchanged reduced source node.
Their ideal is exactly the full residual kernel, not merely its radical.
-/

@[expose] public noncomputable section
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] PolygonSmoothing.relationIdeal
  completeIdentityFirstActionUnit completeIdentityFirstActionField
  completeIdentityFirstActionNodeDefect completeIdentityFirstErrorAlgebra
  completeIdentityFirstGraphReduction completeIdentityFirstGraphSource
  completeIdentityFirstGraphError completeIdentityFirstGraphFiberSection
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (i : Fin n)
local notation "R" => K[T;T⁻¹]
local notation "e" => parameter (R) 1
local notation "B" => ChartRing (e)
local notation "N" => ChartRing (0 : R)
local notation "E" => completeIdentityFirstErrorAlgebra K n h i
local notation "Q" => completeIdentityFirstGraphSpecialFiber K n h i
local notation "q" => completeIdentityFirstGraphFiberQuotient K n h i
local notation "f" => completeIdentityFirstGraphFiberReduction K n h i
local notation "s₀" => completeIdentityFirstGraphFiberSection K n h i
/-- Cache the existing graph ring for quotient calculations. -/
local instance completeIdentityFirstGraphFiberGeneratorsCommRing : CommRing (E) := inferInstance

/-- The original coordinate equation in the literal graph special fiber. -/
def completeIdentityFirstGraphFiberError (z : B) : Q :=
  (q) (completeIdentityFirstGraphError K n h i z)

local notation "d₁" => completeIdentityFirstGraphFiberError K n h i (leftCoordinate (e))
local notation "d₂" => completeIdentityFirstGraphFiberError K n h i (rightCoordinate (e))

/-- Every original coordinate equation belongs to the full residual kernel. -/
theorem completeIdentityFirstGraphFiberError_reduction (z : B) :
    (f) (completeIdentityFirstGraphFiberError K n h i z) = 0 := by
  rw [completeIdentityFirstGraphFiberError, completeIdentityFirstGraphFiberReduction_mk,
    completeIdentityFirstGraphError_reduction]

/-- All literal fiber functions have a three-term expression with original reduced coefficients. -/
theorem completeIdentityFirstGraphFiberError_normalForm (z : Q) :
    ∃ a b c : N, z = (s₀) a + (s₀) b * (d₁) + (s₀) c * (d₂) := by
  obtain ⟨w, hwq⟩ := (show Function.Surjective (q) from Ideal.Quotient.mk_surjective) z
  obtain ⟨a, b, c, hw⟩ := completeIdentityFirstGraphError_normalForm K n h i w
  refine ⟨firstNodeReduction (R) a, firstNodeReduction (R) b,
    firstNodeReduction (R) c, ?_⟩
  rw [completeIdentityFirstGraphFiberSection_reduction,
    completeIdentityFirstGraphFiberSection_reduction,
    completeIdentityFirstGraphFiberSection_reduction]
  change z = (q) _ + (q) _ * (q) _ + (q) _ * (q) _
  rw [← hwq, ← (q).map_mul, ← (q).map_mul, ← (q).map_add, ← (q).map_add]
  exact congrArg (q) hw

/-- Every residual function is generated by the two original equations over the reduced node. -/
theorem completeIdentityFirstGraphFiberError_kernel_normalForm (z : Q) (hz : (f) z = 0) :
    ∃ b c : N, z = (s₀) b * (d₁) + (s₀) c * (d₂) := by
  obtain ⟨a, b, c, he⟩ := completeIdentityFirstGraphFiberError_normalForm K n h i z
  have ha := congrArg (f) he
  rw [hz, map_add, map_add, map_mul, map_mul,
    completeIdentityFirstGraphFiberSection_rightInverse,
    completeIdentityFirstGraphFiberError_reduction,
    completeIdentityFirstGraphFiberError_reduction, mul_zero, mul_zero,
    add_zero, add_zero] at ha
  refine ⟨b, c, ?_⟩
  rw [he, ← ha, map_zero, zero_add]

/-- The full residual ideal is exactly the ideal of the two unchanged coordinate equations. -/
theorem completeIdentityFirstGraphFiberError_span :
    RingHom.ker (f) = Ideal.span ({d₁, d₂} : Set (Q)) := by
  apply le_antisymm
  · intro z hz
    obtain ⟨b, c, rfl⟩ := completeIdentityFirstGraphFiberError_kernel_normalForm K n h i z hz
    apply Ideal.add_mem
    · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))
    · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  · apply Ideal.span_le.mpr
    intro z hz
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · exact completeIdentityFirstGraphFiberError_reduction K n h i _
    · rw [Set.mem_singleton_iff] at hz
      subst z
      exact completeIdentityFirstGraphFiberError_reduction K n h i _

end FLT.Mazur.PolygonInfinitesimalStages
