module

public import FLT.Mazur.PolygonCompleteIdentityGraphAdicAlgebra
public import FLT.Mazur.SchematicImageAffineEquations

/-!
# Local equations of the original smooth graph generate the full adic graph ideal

The equations are computed on the original complete smooth graph and only
then extended to an actual adic node-relation chart. The smooth graph after
adic base change need not be schematically dense for this calculation.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
namespace FLT.Mazur.PolygonInfinitesimalStages
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointWeierstrassCurve completePointToIntegralCubic originalStageToCompatibleProj
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (m : ℕ) (i j : Fin n)
local notation "R" => completeIdentityActionAdicChartSpace K n h m i j
local notation "c" => completeIdentityActionGraphAdicChartEmbedding K n h m i j
local notation "f" => completeIdentityActionSmoothGraph K n h
local notation "v" => completeIdentityActionAdicChartSpaceMap K n h m i j
local notation "a" => completeIdentityActionAdicLiftSpaceMap K n h m
local notation "g" => completeIdentityActionGraphInclusion K n h

/-- The original smooth graph and its actual closed image have the same full ideal. -/
theorem completeIdentityActionGraphInclusion_kernel : (g).ker = (f).ker :=
  SchematicImageAffineEquations.image_kernel (f)

/-- The full chart ideal is pulled back from the original smooth graph kernel. -/
theorem completeIdentityActionGraphAdicChart_smoothIdeal :
    (f).ker.comap ((v) ≫ (a)) = (c).ker := by
  rw [← completeIdentityActionGraphInclusion_kernel,
    completeIdentityActionGraphAdicChart_completeIdeal]

attribute [local irreducible] completeIdentityActionAdicChartSpaceMap
  completeIdentityActionAdicLiftSpaceMap completeIdentityActionSmoothGraph
variable (V : (completeIdentityActionLiftSpace K n h).affineOpens)
variable (U : (completeIdentityActionAdicChartSpace K n h m i j).affineOpens)
variable (e : U.1 ≤ (completeIdentityActionAdicChartSpaceMap K n h m i j ≫
  completeIdentityActionAdicLiftSpaceMap K n h m) ⁻¹ᵁ V.1)

/-- Locally every actual adic graph equation is generated by complete smooth-graph equations. -/
theorem completeIdentityActionGraphAdicChart_localEquations :
    (c).ker.ideal U =
      (RingHom.ker ((f).app V).hom).map (((v) ≫ (a)).appLE V U e).hom := by
  rw [← completeIdentityActionGraphAdicChart_smoothIdeal,
    Scheme.IdealSheafData.ideal_comap _ _ V U e, Scheme.Hom.ker_apply]

/-- A computed original smooth-graph equation vanishes on the full actual adic chart. -/
theorem completeIdentityActionGraphAdicChart_of_smoothEquation 
    (z : Γ(completeIdentityActionLiftSpace K n h, V))
    (hz : (f).app V z = 0) :
    ((v) ≫ (a)).appLE V U e z ∈ (c).ker.ideal U := by
  rw [completeIdentityActionGraphAdicChart_localEquations K n h m i j V U e]
  exact Ideal.mem_map_of_mem _ hz

/-- Division by a regular smooth-graph factor is performed before pulling back the full ideal. -/
theorem completeIdentityActionGraphAdicChart_of_cancelledEquation 
    (b z : Γ(completeIdentityActionLiftSpace K n h, V))
    (hb : IsRegular ((f).app V b)) (hz : (f).app V (b * z) = 0) :
    ((v) ≫ (a)).appLE V U e z ∈ (c).ker.ideal U := by
  apply completeIdentityActionGraphAdicChart_of_smoothEquation K n h m i j V U e
  apply hb.left
  simpa only [map_mul, mul_zero] using hz

/-- If one complete affine open contains the chart image, its equations give the full ideal. -/
theorem completeIdentityActionGraphAdicChartRingIdeal_smoothEquations
    (eTop : (⊤ : (R).Opens) ≤ ((v) ≫ (a)) ⁻¹ᵁ V.1) :
    completeIdentityActionGraphAdicChartRingIdeal K n h m i j =
      (RingHom.ker ((f).app V).hom).map (((v) ≫ (a)).appLE V ⊤ eTop).hom := by
  rw [completeIdentityActionGraphAdicChartRingIdeal_eq]
  exact completeIdentityActionGraphAdicChart_localEquations K n h m i j V
    ⟨⊤, isAffineOpen_top (R)⟩ eTop

end FLT.Mazur.PolygonInfinitesimalStages
