module

public import FLT.Mazur.PolygonInfinitesimalRestrictionKernel
public import FLT.Mazur.LaurentCoefficientDivisibility

/-!
# Adjacent kernels in both Laurent coordinates

The principal top-order coefficient kernel remains principal after adjoining
both independent Laurent variables. Its elements are killed by q and have
pairwise zero products in the full double Laurent ring.
-/

@[expose] public noncomputable section
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open LaurentPolynomial PolygonScalingNaturality
variable (R : Type*) [CommRing R] (m : ℕ)
local notation "A" => Ring R (m + 1)
local notation "ρ" => coeffMap (coeffMap (AlgHom.toRingHom (restriction R m)))
local notation "q" => C (C (parameter R (m + 1)))

/-- The double Laurent adjacent kernel is generated by the same top parameter power. -/
theorem doubleLaurent_restriction_eq_zero_iff (p : (A)[T;T⁻¹][T;T⁻¹]) :
    (ρ) p = 0 ↔ (q) ^ (m + 1) ∣ p := by
  constructor
  · intro hp
    have hd := LaurentCoefficientDivisibility.doubleCoeffMap_kernel_dvd
      (restriction R m).toRingHom (parameter R (m + 1) ^ (m + 1))
      (fun a ha ↦ (restriction_eq_zero_iff_dvd R m a).mp ha) p hp
    simpa only [map_pow] using hd
  · rintro ⟨b, rfl⟩
    rw [map_mul, map_pow, coeffMap_C, coeffMap_C]
    change C (C (restriction R m (parameter R (m + 1)))) ^ (m + 1) * _ = 0
    rw [restriction_parameter, ← map_pow, ← map_pow, parameter_pow,
      map_zero, map_zero, zero_mul]

/-- The smoothing parameter kills every full double Laurent adjacent error. -/
theorem doubleLaurent_parameter_mul_eq_zero (p : (A)[T;T⁻¹][T;T⁻¹])
    (hp : (ρ) p = 0) : (q) * p = 0 := by
  obtain ⟨b, rfl⟩ := (doubleLaurent_restriction_eq_zero_iff R m p).mp hp
  rw [← mul_assoc, ← pow_succ', ← map_pow, ← map_pow,
    parameter_pow, map_zero, map_zero, zero_mul]

/-- Two full Laurent errors in the adjacent kernel multiply to zero. -/
theorem doubleLaurent_restriction_kernel_mul (p s : (A)[T;T⁻¹][T;T⁻¹])
    (hp : (ρ) p = 0) (hs : (ρ) s = 0) : p * s = 0 := by
  obtain ⟨b, rfl⟩ := (doubleLaurent_restriction_eq_zero_iff R m p).mp hp
  have hq := doubleLaurent_parameter_mul_eq_zero R m s hs
  calc
    ((q) ^ (m + 1) * b) * s = ((q) ^ m * b) * ((q) * s) := by
      rw [pow_succ (q)]
      ring
    _ = 0 := by rw [hq, mul_zero]

/-- Every full double Laurent adjacent error is square-zero. -/
theorem doubleLaurent_restriction_kernel_sq (p : (A)[T;T⁻¹][T;T⁻¹])
    (hp : (ρ) p = 0) : p ^ 2 = 0 := by
  rw [pow_two]
  exact doubleLaurent_restriction_kernel_mul R m p p hp hp

end FLT.Mazur.PolygonInfinitesimalStages
