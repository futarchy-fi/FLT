module

public import FLT.Mazur.BoundaryCorrectionCokernelClass

/-!
# A linear image generating the actual scalar obstruction classes

Any linear family of exact boundary values gives a map to the full extended
cokernel. When chart lifts realize those values, its image is precisely the
span of their scalar errors. This avoids the larger mixed-ideal envelope and
makes no finite generation assumption on the boundary parameter module.
-/

@[expose] public noncomputable section
open TensorProduct
namespace FLT.Mazur.BoundaryCorrectionIdeal
variable {R : Type*} [CommRing R] {ι : Type*} {A B : ι → Type*} {C : ι → ι → Type*}
  [∀ i, CommRing (A i)] [∀ i, CommRing (B i)] [∀ i j, CommRing (C i j)]
  [∀ i, Algebra R (A i)] [∀ i, Algebra R (B i)] [∀ i j, Algebra R (C i j)]
  (φ : ∀ i, A i →ₐ[R] B i)
  (p : ∀ i j, A i →ₐ[R] C i j) (q : ∀ i j, A j →ₐ[R] C i j)
  (v : ∀ i, A i) {D : Type*} [AddCommGroup D] [Module R D]
  (β : D →ₗ[R] (∀ i, B i)) (S : Type*) [CommRing S] [Algebra R S]
set_option quotPrecheck false
local notation "F" => ambientCorrectionOperator φ p q v S
local notation "π" => (LinearMap.range F).mkQ

/-- The boundary coefficient map, with zero mixed coordinates, projected to the full cokernel. -/
def boundaryCokernelMap : (S ⊗[R] D) →ₗ[S]
    ((S ⊗[R] ((∀ i, B i) × ∀ i j, C i j)) ⧸ LinearMap.range F) :=
  (π).comp (((LinearMap.inl R (∀ i, B i) (∀ i j, C i j)).comp β).baseChange S)

/-- Pure tensors retain the exact boundary representative. -/
theorem boundaryCokernelMap_tmul (s : S) (t : D) :
    boundaryCokernelMap φ p q v β S (s ⊗ₜ[R] t) = π (s ⊗ₜ[R] (β t, 0)) := rfl

/-- On actual lifted sections, the boundary map recovers the full scalar obstruction. -/
theorem boundaryCokernelMap_one_tmul (t : D) (u : ∀ i, A i)
    (hu : (fun i ↦ φ i (u i)) = β t) :
    boundaryCokernelMap φ p q v β S (1 ⊗ₜ[R] t) =
      π (ambientScalarError φ p q u S) := by
  rw [boundaryCokernelMap_tmul, ambientScalarError_cokernel_eq_boundary, hu]

/-- The image is generated by the classes of all original boundary parameters. -/
theorem range_boundaryCokernelMap :
    LinearMap.range (boundaryCokernelMap φ p q v β S) =
      Submodule.span S (Set.range (fun t : D ↦ π (1 ⊗ₜ[R] (β t, 0)))) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    induction x using TensorProduct.inductionOn with
    | tmul s t =>
      have ht : boundaryCokernelMap φ p q v β S (1 ⊗ₜ[R] t) ∈
          Submodule.span S (Set.range (fun t : D ↦ π (1 ⊗ₜ[R] (β t, 0)))) :=
        Submodule.subset_span (Set.mem_range_self t)
      have hs := Submodule.smul_mem _ s ht
      simpa only [← map_smul, smul_tmul', smul_eq_mul, mul_one] using hs
    | add x y hx hy => simpa only [map_add] using Submodule.add_mem _ hx hy
  · apply Submodule.span_le.mpr
    rintro _ ⟨t, rfl⟩
    exact ⟨1 ⊗ₜ[R] t, rfl⟩

/-- Actual scalar errors generate exactly this linear image, including all their relations. -/
theorem range_boundaryCokernelMap_eq_scalarErrors (u : D → ∀ i, A i)
    (hu : ∀ t, (fun i ↦ φ i (u t i)) = β t) :
    LinearMap.range (boundaryCokernelMap φ p q v β S) =
      Submodule.span S (Set.range (fun t : D ↦ π (ambientScalarError φ p q (u t) S))) := by
  rw [range_boundaryCokernelMap]
  congr 2
  funext t
  rw [ambientScalarError_cokernel_eq_boundary, hu]

end FLT.Mazur.BoundaryCorrectionIdeal
