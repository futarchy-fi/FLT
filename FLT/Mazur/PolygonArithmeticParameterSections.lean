module

public import FLT.Mazur.PolygonArithmeticLineLayers
public import FLT.Mazur.PolygonArithmeticAdicImmersion

/-!
# Principal affine coordinates of the actual stage parameter ideal

The extended parameter ideal is generated by the original structural
parameter section. Its powers use the powers of that same section.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry

namespace FLT.Mazur.PolygonArithmeticStages

open FCurve ModuleLineBundleTensorPullback BaseAdicThickening

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

variable (A : Type) [CommRing A] (π : A) (m n : ℕ) (h : 2 ≤ n)

/-- The actual smoothing parameter viewed as a global structural section. -/
def stageParameterSection : Γ((family A π m n h).left, ⊤) :=
  stageScalars A π m n h (parameter A π m)

/-- The power ideal is generated by the corresponding original parameter section. -/
theorem stageParameterPower_ideal (k : ℕ) (U : (family A π m n h).left.affineOpens) :
    (stageParameterIdeal A π m n h ^ k).ideal U =
      Ideal.span {((family A π m n h).left.presheaf.map U.1.leTop.op
        (stageParameterSection A π m n h ^ k))} := by
  rw [stageParameterIdeal, extendedPower_ideal, Ideal.span_singleton_pow,
    Ideal.map_span, Set.image_singleton]
  congr 2
  rw [map_pow, map_pow]
  rfl

/-- The first parameter ideal has its original principal generator on every affine open. -/
theorem stageParameterIdeal_ideal (U : (family A π m n h).left.affineOpens) :
    (stageParameterIdeal A π m n h).ideal U =
      Ideal.span {((family A π m n h).left.presheaf.map U.1.leTop.op
        (stageParameterSection A π m n h))} := by
  simpa only [pow_one] using stageParameterPower_ideal A π m n h 1 U

variable [IsDomain A] (hπ : π ≠ 0)

include hπ in
/-- The affine last-power annihilator is the actual parameter ideal acting on the line. -/
theorem boundaryPower_last_annihilator (d : ℕ)
    (U : (family A π (m + 1) n h).left.affineOpens)
    (s : Γ(tensorPower (boundaryLine A π (m + 1) n h) d, U.1)) :
    (family A π (m + 1) n h).left.presheaf.map U.1.leTop.op
        (stageParameterSection A π (m + 1) n h ^ (m + 1)) • s = 0 ↔
      s ∈ (stageParameterIdeal A π (m + 1) n h).ideal U •
        (⊤ : Submodule Γ((family A π (m + 1) n h).left, U.1)
          Γ(tensorPower (boundaryLine A π (m + 1) n h) d, U.1)) := by
  let _ := boundaryPowerSections_flat A π (m + 1) n h d U.1 U.2
  rw [stageParameterIdeal_ideal, Submodule.ideal_span_singleton_smul]
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and]
  have he := flat_last_smul_eq_zero_iff A π hπ m
    (boundaryPowerSections A π (m + 1) n h d U.1) s
  change (family A π (m + 1) n h).left.presheaf.map U.1.leTop.op
      (stageScalars A π (m + 1) n h (parameter A π (m + 1) ^ (m + 1))) • s = 0 ↔
    ∃ y, (family A π (m + 1) n h).left.presheaf.map U.1.leTop.op
      (stageScalars A π (m + 1) n h (parameter A π (m + 1))) • y = s at he
  simpa only [stageParameterSection, map_pow] using he

end FLT.Mazur.PolygonArithmeticStages
