module

public import FLT.Mazur.PolygonArithmeticVeroneseKernel

/-!
# Adic reduction to the original stage Veronese rings

Define the stage Veronese independently from the actual homogeneous stage
sections and their original multiplication. Evaluation has exactly this
image and its proved kernel is the actual parameter-ideal power.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry
open scoped DirectSum

namespace FLT.Mazur.PolygonArithmeticStages

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

attribute [local irreducible] compatibleEval boundaryLine family

variable (A : Type) [CommRing A] (π : A) (n : ℕ) (h : 2 ≤ n)

/-- The original stage ring generated by its retained tensor degrees. -/
def boundaryVeroneseRing (q m : ℕ) : Subring (boundaryGradedSections A π n h m) :=
  Subring.closure (⋃ d : ℕ, (SectionGradedSum.grade (boundaryLine A π m n h) ⊤ (q * d) : Set _))

/-- Every actual compatible Veronese evaluation belongs to the independently defined stage ring. -/
theorem compatibleVeroneseEval_mem (q m : ℕ) (s : CompatibleVeroneseSections A π n h q) :
    compatibleVeroneseEval A π n h q m s ∈ boundaryVeroneseRing A π n h q m := by
  induction s using DirectSum.induction_on with
  | zero => rw [map_zero]; exact (boundaryVeroneseRing A π n h q m).zero_mem
  | of d s =>
    rw [compatibleVeroneseEval_of]
    apply Subring.subset_closure
    exact Set.mem_iUnion.mpr ⟨d, s.property m⟩
  | add s t hs ht =>
    rw [map_add]
    exact (boundaryVeroneseRing A π n h q m).add_mem hs ht

variable [IsNoetherianRing A] [IsLocalRing A] [IsDomain A] [NeZero n]
  (hne : π ≠ 0) (hgen : IsLocalRing.maximalIdeal A = ideal A π)

include hne hgen in
/-- Evaluation reaches exactly the original stage Veronese, in every retained degree. -/
theorem exactVeroneseEval_range (m : ℕ) :
    (compatibleVeroneseEval A π n h (exactVeroneseStep A π hne hgen n h) m).range =
      boundaryVeroneseRing A π n h (exactVeroneseStep A π hne hgen n h) m := by
  apply le_antisymm
  · rintro s ⟨t, rfl⟩
    exact compatibleVeroneseEval_mem A π n h _ m t
  · apply Subring.closure_le.mpr
    intro s hs
    obtain ⟨d, hd⟩ := Set.mem_iUnion.mp hs
    obtain ⟨t, ht⟩ := exactVeroneseDegree_surjective A π hne hgen n h d m ⟨s, hd⟩
    refine ⟨DirectSum.of _ d t, ?_⟩
    exact (compatibleVeroneseEval_of A π n h _ m d t).trans (congrArg Subtype.val ht)

/-- The actual parameter-adic quotient is the independently defined original stage Veronese. -/
def exactVeroneseAdicReduction (m : ℕ) :
    (CompatibleVeroneseSections A π n h (exactVeroneseStep A π hne hgen n h) ⧸
      compatibleVeroneseParameterIdeal A π n h (exactVeroneseStep A π hne hgen n h) ^ (m + 1)) ≃+*
        boundaryVeroneseRing A π n h (exactVeroneseStep A π hne hgen n h) m :=
  ((Ideal.quotEquivOfEq (exactVeroneseEval_ker A π n h hne hgen m).symm).trans
    (RingHom.quotientKerEquivRange
      (compatibleVeroneseEval A π n h (exactVeroneseStep A π hne hgen n h) m))).trans
    (RingEquiv.subringCongr (exactVeroneseEval_range A π n h hne hgen m))

/-- The ring isomorphism retains the actual evaluation on every representative. -/
theorem exactVeroneseAdicReduction_mk (m : ℕ)
    (s : CompatibleVeroneseSections A π n h (exactVeroneseStep A π hne hgen n h)) :
    (exactVeroneseAdicReduction A π n h hne hgen m (Ideal.Quotient.mk _ s)).val =
      compatibleVeroneseEval A π n h (exactVeroneseStep A π hne hgen n h) m s := rfl

/-- Reduction retains the original integral-base coefficients inside the original stage ring. -/
theorem exactVeroneseAdicReduction_scalar (m : ℕ) (r : A) :
    (exactVeroneseAdicReduction A π n h hne hgen m (Ideal.Quotient.mk _
      (algebraMap (A)
        (CompatibleVeroneseSections A π n h (exactVeroneseStep A π hne hgen n h)) r))).val =
      boundaryIntegralScalars A π n h m r := by
  rw [exactVeroneseAdicReduction_mk, compatibleVeroneseEval_algebraMap]

/-- The recovered rings retain every original stage map on all original representatives. -/
theorem exactVeroneseAdicReduction_transition {a b : ℕ} (f : a ⟶ b)
    (s : CompatibleVeroneseSections A π n h (exactVeroneseStep A π hne hgen n h)) :
    boundarySectionsMap A π n h f
      (exactVeroneseAdicReduction A π n h hne hgen b (Ideal.Quotient.mk _ s)).val =
        (exactVeroneseAdicReduction A π n h hne hgen a (Ideal.Quotient.mk _ s)).val := by
  rw [exactVeroneseAdicReduction_mk, exactVeroneseAdicReduction_mk]
  exact DFunLike.congr_fun (compatibleVeroneseEval_transition A π n h _ f) s

end FLT.Mazur.PolygonArithmeticStages
