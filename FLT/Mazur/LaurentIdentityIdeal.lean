module

public import FLT.Mazur.LaurentCoefficientEvaluation
public import Mathlib.Algebra.Polynomial.Div

/-!
# The two identity ideals in a double Laurent algebra

Vanishing on both identity slices factors through their product over a domain.
The quotient retains all mixed coefficients; normalization alone does not make it zero.
-/

@[expose] public noncomputable section
open scoped LaurentPolynomial
namespace FLT.Mazur.LaurentIdentityIdeal
open LaurentPolynomial PolygonScalingNaturality LaurentCoefficientEvaluation
variable {R : Type*} [CommRing R]
local notation "ε" A => AlgHom.toRingHom (LaurentUnitPoints.evalUnit (R := A) (1 : Aˣ))

/-- The identity ideal in a Laurent algebra is generated by the coordinate minus one. -/
theorem evalOne_eq_zero_iff (p : R[T;T⁻¹]) :
    (ε R) p = 0 ↔ T 1 - 1 ∣ p := by
  constructor
  · induction p using LaurentPolynomial.induction_on_mul_T with
    | mul_T f n =>
      intro hp
      have hf : f.eval 1 = 0 := by
        simpa [LaurentUnitPoints.evalUnit, eval₂_toLaurent] using hp
      obtain ⟨g, hg⟩ := (Polynomial.dvd_iff_isRoot).mpr hf
      refine ⟨Polynomial.toLaurent g * T (-n), ?_⟩
      rw [hg, map_mul, map_sub, Polynomial.toLaurent_X, Polynomial.toLaurent_C, map_one]
      exact mul_assoc _ _ _
  · rintro ⟨q, rfl⟩
    simp [LaurentUnitPoints.evalUnit]

/-- Constant divisibility in a Laurent algebra is detected coefficient by coefficient. -/
theorem constant_dvd_iff (a : R) (p : R[T;T⁻¹]) :
    C a ∣ p ↔ ∀ d : ℤ, a ∣ p.coeff d := by
  constructor
  · rintro ⟨q, rfl⟩ d
    refine ⟨q.coeff d, ?_⟩
    simp only [← smul_eq_C_mul, AddMonoidAlgebra.coeff_smul_apply, smul_eq_mul]
  · intro hp
    classical
    choose q hq using hp
    refine ⟨∑ d ∈ p.coeff.support, C (q d) * T d, ?_⟩
    rw [Finset.mul_sum]
    simp_rw [← mul_assoc, ← map_mul, ← hq, ← single_eq_C_mul_T]
    apply LaurentPolynomial.ext
    intro d
    simp only [AddMonoidAlgebra.coeff_sum, AddMonoidAlgebra.coeff_single]
    exact congrArg (fun f : ℤ →₀ R ↦ f d) (Finsupp.sum_single p.coeff).symm

/-- Vanishing on the first identity slice is divisibility by its actual defining equation. -/
theorem firstUnit_eq_zero_iff (p : R[T;T⁻¹][T;T⁻¹]) :
    coeffMap (ε R) p = 0 ↔ C (T 1 - 1) ∣ p := by
  rw [constant_dvd_iff]
  constructor
  · intro hp d
    apply (evalOne_eq_zero_iff _).mp
    have he := congrArg (fun f ↦ f.coeff d) hp
    simpa only [coeffMap_coeff, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply] using he
  · intro hp
    ext d
    simpa only [coeffMap_coeff, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply] using
      (evalOne_eq_zero_iff _).mpr (hp d)

/-- The Laurent identity equation is nonzero over a nontrivial coefficient ring. -/
theorem coordinate_sub_one_ne_zero [Nontrivial R] : (T 1 : R[T;T⁻¹]) - 1 ≠ 0 := by
  intro he
  have hc := congrArg (fun p : R[T;T⁻¹] ↦ p.coeff 1) (sub_eq_zero.mp he)
  change (T 1 : R[T;T⁻¹]).coeff 1 = (T 0 : R[T;T⁻¹]).coeff 1 at hc
  have hz : (1 : R) = 0 := by simpa only [T_apply, zero_ne_one, ↓reduceIte] using hc
  exact one_ne_zero hz

/-- Over a domain the two identity equations cut out exactly the normalized mixed part. -/
theorem bothUnits_eq_zero_iff [IsDomain R] (p : R[T;T⁻¹][T;T⁻¹]) :
    coeffMap (ε R) p = 0 ∧ (ε R[T;T⁻¹]) p = 0 ↔
      C (T 1 - 1) * (T 1 - 1) ∣ p := by
  constructor
  · rintro ⟨h₁, h₂⟩
    obtain ⟨q, hq⟩ := (evalOne_eq_zero_iff p).mp h₂
    have hq₁ : coeffMap (ε R) q = 0 := by
      rw [hq, map_mul, map_sub, coeffMap_T_one, map_one] at h₁
      exact (mul_eq_zero.mp h₁).resolve_left coordinate_sub_one_ne_zero
    obtain ⟨r, hr⟩ := (firstUnit_eq_zero_iff q).mp hq₁
    refine ⟨r, ?_⟩
    rw [hq, hr]
    ring
  · rintro ⟨q, rfl⟩
    constructor <;> simp [LaurentUnitPoints.evalUnit]

end FLT.Mazur.LaurentIdentityIdeal
