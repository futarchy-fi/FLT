module

public import FLT.Mazur.SectionLiftIdeal
public import FLT.Mazur.FlatTensorEqualizer
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Flat scalar extension of the actual lifting multiplier ideal

A new multiplier and its numerator form a tensor in the kernel of the original
lifting equation. Flatness writes this tensor in terms of original solutions.
Projecting their denominator coordinates proves equality of multiplier ideals,
including new multipliers which are not images of original elements.
-/

@[expose] public noncomputable section
open TensorProduct
namespace FLT.Mazur.FlatSectionLiftIdeal
variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] (t : B)

/-- The numerator side of the original lifting equation. -/
def numerator : A × A →ₗ[A] B :=
  (Algebra.linearMap A B).comp (LinearMap.snd A A A)

/-- The denominator side of the original lifting equation. -/
def denominator : A × A →ₗ[A] B :=
  (LinearMap.toSpanSingleton A B t).comp (LinearMap.fst A A A)

/-- Actual pairs of an original multiplier and an original numerator. -/
abbrev solutions := FlatTensorEqualizer.equalizer (numerator (A := A) (B := B)) (denominator t)

/-- Project an actual solution to its multiplier. -/
def multiplier : solutions (A := A) t →ₗ[A] A :=
  (LinearMap.fst A A A).comp (solutions (A := A) t).subtype

/-- The projected original solution belongs to the actual multiplier ideal. -/
theorem multiplier_mem (x : solutions (A := A) t) :
    multiplier t x ∈ sectionLiftIdeal (algebraMap A B) t := by
  refine ⟨x.val.2, ?_⟩
  have h := (FlatTensorEqualizer.mem_equalizer _ _ _).mp x.property
  change algebraMap A B x.val.2 = x.val.1 • t at h
  exact h.trans (Algebra.smul_def _ _)

variable (S : Type*) [CommRing S] [Algebra A S]
set_option quotPrecheck false in
local notation "J" => (sectionLiftIdeal (algebraMap A B) t).map (algebraMap A S)

/-- Every tensor of original solutions has multiplier in the extended original ideal. -/
theorem tensor_multiplier_mem (x : S ⊗[A] solutions (A := A) t) :
    TensorProduct.rid A S ((multiplier t).lTensor S x) ∈ J := by
  induction x using TensorProduct.inductionOn with
  | tmul s x =>
      change (multiplier t x) • s ∈ J
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_right s J (Ideal.mem_map_of_mem _ (multiplier_mem t x))
  | add x y hx hy =>
      simpa only [map_add] using (J).add_mem hx hy

variable [Module.Flat A S]

/-- A scalar multiplier after flat extension is generated by actual original multipliers. -/
theorem scalar_multiplier_mem (s a : S)
    (ha : a ⊗ₜ[A] (1 : B) = s ⊗ₜ[A] t) : s ∈ J := by
  let x : S ⊗[A] (A × A) := s ⊗ₜ[A] (1, 0) + a ⊗ₜ[A] (0, 1)
  have hx : (numerator (A := A) (B := B)).lTensor S x =
      (denominator t).lTensor S x := by
    simpa only [x, map_add, LinearMap.lTensor_tmul, numerator, denominator,
      LinearMap.comp_apply, LinearMap.fst_apply, LinearMap.snd_apply,
      Algebra.linearMap_apply, LinearMap.toSpanSingleton_apply, map_zero, map_one,
      zero_smul, one_smul, TensorProduct.tmul_zero, zero_add, add_zero] using ha
  obtain ⟨y, hy, _⟩ := FlatTensorEqualizer.existsUnique_lift
    (numerator (A := A) (B := B)) (denominator t) S x hx
  have hm : (multiplier t).lTensor S y = (LinearMap.fst A A A).lTensor S x := by
    rw [multiplier, LinearMap.lTensor_comp, LinearMap.comp_apply, hy]
  have hs := tensor_multiplier_mem t S y
  rw [hm] at hs
  simpa only [x, map_add, LinearMap.lTensor_tmul, LinearMap.fst_apply,
    TensorProduct.rid_tmul, one_smul, zero_smul, add_zero] using hs

/-- Flat extension commutes with the entire multiplier ideal of a fixed boundary section. -/
theorem ideal_map :
    (sectionLiftIdeal (algebraMap A B) t).map (algebraMap A S) =
      sectionLiftIdeal (algebraMap S (S ⊗[A] B)) (1 ⊗ₜ[A] t) := by
  apply le_antisymm
  · apply Ideal.map_le_iff_le_comap.mpr
    rintro s ⟨a, ha⟩
    refine ⟨algebraMap A S a, ?_⟩
    simp only [Algebra.TensorProduct.algebraMap_apply,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    change algebraMap A S a ⊗ₜ[A] (1 : B) = algebraMap A S s ⊗ₜ[A] t
    rw [Algebra.algebraMap_eq_smul_one a, TensorProduct.smul_tmul,
      Algebra.algebraMap_eq_smul_one s, TensorProduct.smul_tmul]
    simp only [Algebra.smul_def, mul_one, ha]
  · rintro s ⟨a, ha⟩
    apply scalar_multiplier_mem t S s a
    simpa only [Algebra.TensorProduct.algebraMap_apply,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
      Algebra.algebraMap_self, RingHom.id_apply] using ha

end FLT.Mazur.FlatSectionLiftIdeal
