module

public import FLT.Mazur.ScalarImageResidueGenerators

/-!
# The extended scalar restriction image is generated by its unit value

A restriction map from the scalar ring has a cyclic image after every scalar
extension. Source residue restriction surjectivity can thus be tested by a
single distinguished generator, without reducing an ambient connecting image.
-/

@[expose] public noncomputable section
open TensorProduct
namespace FLT.Mazur.ScalarRestrictionImage
variable {R D : Type*} [CommRing R] [AddCommGroup D] [Module R D]
  (ρ : R →ₗ[R] D) (S : Type*) [CommRing S] [Algebra R S]

/-- Extended scalar restrictions are generated by the original unit restriction. -/
theorem range_eq_span_unit : LinearMap.range (ρ.baseChange S) =
    Submodule.span S {(1 ⊗ₜ[R] ρ 1 : S ⊗[R] D)} := by
  rw [ScalarImageOriginalGenerators.range_eq_span]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro x ⟨a, rfl⟩
    have ha : ρ a = a • ρ 1 := by rw [← map_smul, smul_eq_mul, mul_one]
    change (1 ⊗ₜ[R] ρ a : S ⊗[R] D) ∈ _
    rw [ha]
    have hm := (Submodule.span S {(1 ⊗ₜ[R] ρ 1 : S ⊗[R] D)}).smul_mem
      (algebraMap R S a) (Submodule.subset_span (Set.mem_singleton _))
    simpa only [tmul_smul, smul_tmul', Algebra.smul_def,
      Algebra.algebraMap_self, RingHom.id_apply, mul_one, one_mul, SetLike.mem_coe] using hm
  · apply Submodule.span_mono
    rintro x rfl
    exact ⟨1, rfl⟩

/-- Residue restriction surjectivity is generation by the distinguished unit modulo the ideal. -/
theorem residueRestriction_surjective_iff (J : Ideal S) :
    Function.Surjective (SourceImageNakayama.residueRestriction (ρ.baseChange S) J) ↔
      Submodule.span S {(1 ⊗ₜ[R] ρ 1 : S ⊗[R] D)} ⊔
        J • (⊤ : Submodule S (S ⊗[R] D)) = ⊤ := by
  rw [SourceImageNakayama.residueRestriction_surjective_iff, range_eq_span_unit]

variable {M : Type*} [AddCommGroup M] [Module R M]
  (g : D →ₗ[R] M) (hker : LinearMap.ker g = LinearMap.range ρ)
  [Module.Flat R S] [IsLocalRing S]

include hker in
/-- A finite exact connecting image vanishes precisely when the source residue is cyclic. -/
theorem eq_zero_iff_residue_cyclic (hfg : (LinearMap.range (g.baseChange S)).FG) :
    g.baseChange S = 0 ↔
      Submodule.span S {(1 ⊗ₜ[R] ρ 1 : S ⊗[R] D)} ⊔
        IsLocalRing.maximalIdeal S • (⊤ : Submodule S (S ⊗[R] D)) = ⊤ := by
  constructor
  · intro hz
    have hk := ScalarImageSourceGenerators.ker_baseChange ρ g hker S
    rw [hz, LinearMap.ker_zero, range_eq_span_unit] at hk
    rw [← hk, top_sup_eq]
  · intro hres
    exact ScalarImageResidueGenerators.eq_zero_of_residueRestriction ρ g hker S hfg
      ((residueRestriction_surjective_iff ρ S _).mpr hres)

end FLT.Mazur.ScalarRestrictionImage
