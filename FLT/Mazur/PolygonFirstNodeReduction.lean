module

public import FLT.Mazur.PolygonSmoothingRingMap
public import FLT.Mazur.PolygonSmoothingFlat
public import FLT.Mazur.PolygonStageFlatLayer

/-!
# Exact reduction and annihilator on the original first-order node

For the actual chart xy = e over R[e]/e², the reduction kernel and the
annihilator of e are both e times the chart ring. This uses flatness over
the coefficient ring only, not flatness of any action graph projection.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.PolygonInfinitesimalStages
set_option backward.isDefEq.respectTransparency false
open PolygonSmoothing
variable (R : Type) [CommRing R]
local notation "S" => Ring R 1
local notation "e" => parameter R 1
local notation "B" => ChartRing (e)

/-- Reduction of the actual first-order smoothing chart to its original split node. -/
def firstNodeReduction : (B) →+* ChartRing (0 : R) :=
  ringMap (reduction R 1).toRingHom (e) 0 (reduction_parameter R 1)

@[simp] theorem firstNodeReduction_left :
    firstNodeReduction R (leftCoordinate (e)) = leftCoordinate (0 : R) := ringMap_left ..

@[simp] theorem firstNodeReduction_right :
    firstNodeReduction R (rightCoordinate (e)) = rightCoordinate (0 : R) := ringMap_right ..

/-- Every original node function lifts to the first smoothing chart. -/
theorem firstNodeReduction_surjective : Function.Surjective (firstNodeReduction R) :=
  ringMap_surjective _ _ _ _ (reduction_surjective R 1)

/-- The closed coefficient kernel is the ideal generated by the actual parameter. -/
theorem firstReduction_ker :
    RingHom.ker (reduction R 1).toRingHom = Ideal.span {e} := by
  ext z
  change reduction R 1 z = 0 ↔ z ∈ Ideal.span {e}
  rw [reduction_eq_zero_iff, Ideal.mem_span_singleton]
  exact ⟨fun ⟨w, hw⟩ ↦ ⟨w, hw.symm⟩, fun ⟨w, hw⟩ ↦ ⟨w, hw.symm⟩⟩

/-- The node kernel is exactly the extended coefficient ideal. -/
theorem firstNodeReduction_ker :
    RingHom.ker (firstNodeReduction R) =
      Ideal.span {algebraMap (S) (B) (e)} := by
  rw [firstNodeReduction, ringMap_ker _ _ _ _ (reduction_surjective R 1),
    firstReduction_ker, Ideal.map_span, Set.image_singleton]

/-- Vanishing after reduction supplies an actual parameter multiple in the original chart. -/
theorem firstNodeReduction_zero_iff (z : B) :
    firstNodeReduction R z = 0 ↔ ∃ a : B, (e) • a = z := by
  rw [← RingHom.mem_ker, firstNodeReduction_ker, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨a, ha⟩
    exact ⟨a, (Algebra.smul_def (e) a).trans ha.symm⟩
  · rintro ⟨a, ha⟩
    exact ⟨a, ha.symm.trans (Algebra.smul_def (e) a)⟩

/-- Flatness of the actual node chart identifies the parameter annihilator with reduction. -/
theorem firstNode_parameter_annihilator (z : B) :
    (e) • z = 0 ↔ firstNodeReduction R z = 0 := by
  have he := flat_last_smul_eq_zero_iff R 0 (B) z
  simpa only [Nat.zero_add, pow_one, ← firstNodeReduction_zero_iff] using he

/-- The parameter still squares to zero inside the actual node ring. -/
theorem firstNode_parameter_sq : (algebraMap (S) (B) (e)) ^ 2 = 0 := by
  rw [← map_pow, parameter_pow R 1, map_zero]

end FLT.Mazur.PolygonInfinitesimalStages
