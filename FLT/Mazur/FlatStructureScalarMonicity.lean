module

public import FLT.Mazur.WeierstrassFlatSectionRegular
public import FLT.Mazur.IdealPowerScalarLift
public import FLT.Mazur.BaseAdicThickening

/-!
# Monicity of an actual flat base parameter

A regular element of the affine base remains regular on every open of a
flat total scheme. Its original scalar sheaf map is therefore monic.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Opposite

namespace FLT.Mazur.FlatStructureScalarMonicity

open FCurve WeierstrassIntegralChart IdealPowerScalarLift BaseAdicThickening

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

variable {X : Scheme} {R : Type} [CommRing R]
  (f : X ⟶ Spec (.of R)) [Flat f] (a : R) (ha : IsRegular a)

include ha in
/-- The actual base parameter is regular on arbitrary total-space opens. -/
theorem regular_on_open (U : X.Opens) :
    IsRegular (X.presheaf.map U.leTop.op (specSectionHom f a)) := by
  have h := specSectionHom_isRegular (U.ι ≫ f) ha
  have ht := flatRingHom_isRegular U.topIso.hom.hom
    (RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _)) h
  have he : U.topIso.hom (specSectionHom (U.ι ≫ f) a) =
      X.presheaf.map U.leTop.op (specSectionHom f a) := by
    change U.topIso.hom (U.ι.appTop (specSectionHom f a)) = _
    simp only [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom,
      ← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  rwa [he] at ht

include ha in
/-- The original scalar endomorphism of the structure module is monic. -/
theorem scalarEnd_mono : Mono (scalarEnd (structureModule X) (specSectionHom f a)) := by
  apply (SheafOfModules.forget X.ringCatSheaf).mono_of_mono_map
  apply PresheafOfModules.mono_of_injective
  intro U x y h
  exact (regular_on_open f a ha U.unop).left h

omit [Flat f] in
/-- The extended base ideal is generated by this same original scalar on every affine open. -/
theorem baseIdeal_principal (U : X.affineOpens) :
    ((baseIdeal (.of R) (Ideal.span {a})).comap f).ideal U =
      Ideal.span {X.presheaf.map U.1.leTop.op (specSectionHom f a)} := by
  have he := extendedPower_ideal (R := .of R) (Ideal.span {a}) f U 1
  simp only [pow_one, Ideal.map_span, Set.image_singleton] at he
  rw [he]
  rfl

end FLT.Mazur.FlatStructureScalarMonicity
