module

public import FLT.Mazur.OriginalBoundaryFramedScalarProducts
public import FLT.Mazur.FiniteDifferenceProducts
public import FLT.Mazur.SchemeClosedScalarKernelLift

/-!
# Explicit mixed equations for full original boundary lifts

The full comparison kernel is generated by mixed products choosing one
original boundary coefficient per frame coordinate. Their vanishing constructs
a unique original arrow; containment in a correction ideal is tested by the
same products. Equality merely in the original invariant ring is not used
as an unproved source of these equations.
-/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped BigOperators
namespace FLT.Mazur.EquivalenceRelationOrderedFrames
open RelativeOrderedTuples RingPairInvariantFlatScalars SchemeScalarPrincipalNeighborhood
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
variable {D A B : Scheme.{0}} {p q : D ⟶ A} [IsSeparated p] [Etale p]
  [QuasiCompact p] (J : A.IdealSheafData) (hJ : J.comap p = J.comap q)
attribute [local instance] sourceAlgebra targetAlgebra originalBoundaryAlgebra
set_option quotPrecheck false
local notation "R" => invariants p.appTop.hom q.appTop.hom
local notation "f" => scalarMorphism (algebraMap R Γ(J.subscheme, ⊤))
local notation "P" => pullback.snd p J.subschemeι
local notation "Q" => InvariantIdealRelation.snd J p q hJ
local notation "E" => Over.mk P
local notation "c" => originalBoundaryComparison p q J hJ
local instance mixedEquationBoundaryOver_separated : IsSeparated (E).hom :=
  inferInstanceAs (IsSeparated P)
local instance mixedEquationBoundaryOver_etale : Etale (E).hom := inferInstanceAs (Etale P)
local instance mixedEquationBoundaryOver_compact : QuasiCompact (E).hom :=
  inferInstanceAs (QuasiCompact P)
local instance mixedEquationOriginalOver_separated : IsSeparated (Over.mk p).hom :=
  ‹IsSeparated p›
local instance mixedEquationOriginalOver_etale : Etale (Over.mk p).hom := ‹Etale p›
local instance mixedEquationOriginalOver_compact : QuasiCompact (Over.mk p).hom :=
  ‹QuasiCompact p›
variable (t : B ⟶ pullback
    (scalarMorphism (algebraMap (invariants p.appTop.hom q.appTop.hom) Γ(J.subscheme, ⊤)))
    (scalarMorphism (algebraMap (invariants p.appTop.hom q.appTop.hom) Γ(J.subscheme, ⊤))))
  (n : ℕ)
local notation "x" => t ≫ pullback.fst f f
local notation "y" => t ≫ pullback.snd f f
variable (a : Over.mk (t ≫ pullback.fst _ _) ⟶
    distinctScheme (Over.mk (pullback.snd p J.subschemeι)) (Fin n))
  (ht : Set.range (t ≫ pullback.fst _ _ ≫ J.subschemeι) ⊆ exactRank (Over.mk p) n)

variable [IsAffine A] [IsAffine B] [LocallyQuasiFinite p]
  (e : CategoryTheory.EquivalenceRelation p q)
local instance mixedEquationBoundary_affine : IsAffine J.subscheme :=
  isAffine_of_isAffineHom J.subschemeι
local instance mixedEquationOriginal_quasiFinite : LocallyQuasiFinite (Over.mk p).hom :=
  ‹LocallyQuasiFinite p›
attribute [local irreducible] scalarMorphism
local notation "s" k:max => testSection E (Fin n) a k

/-- A concrete mixed product in the unchanged coefficient ring. -/
def originalBoundaryFrameCoefficientProduct (z : Fin n → Γ(J.subscheme, ⊤)) : Γ(B, ⊤) :=
  ∏ k : Fin n, ((s k ≫ pullback.fst P x ≫ Q).appTop (z k) - (y).appTop (z k))

include ht e

/-- Mixed original coefficient products generate the exact original comparison kernel. -/
theorem originalBoundary_frame_scalar_kernel_span :
    RingHom.ker (pullback.snd c t).appTop.hom =
      Ideal.span (Set.range (originalBoundaryFrameCoefficientProduct J hJ t n a)) := by
  rw [originalBoundary_frame_scalar_kernel_product J hJ t n a ht e]
  change (∏ k : Fin n, FiniteCoefficientDifference.differenceIdeal
    (s k ≫ pullback.fst P x ≫ Q).appTop.hom
    (s k ≫ pullback.snd P x ≫ y).appTop.hom) = _
  have hs (k : Fin n) : s k ≫ pullback.snd P x ≫ y = y := by
    simpa only [Over.mk_hom, Category.id_comp] using! testSection_snd_assoc E (Fin n) a k y
  simp_rw [hs]
  exact FiniteCoefficientDifference.product_differenceIdeal_eq _ _

/-- Every correction ideal is tested against explicit original mixed coefficient products. -/
theorem originalBoundary_frame_kernel_le_iff_products (K : Ideal Γ(B, ⊤)) :
    RingHom.ker (pullback.snd c t).appTop.hom ≤ K ↔
      ∀ z : Fin n → Γ(J.subscheme, ⊤),
        originalBoundaryFrameCoefficientProduct J hJ t n a z ∈ K := by
  rw [originalBoundary_frame_scalar_kernel_span J hJ t n a ht e,
    Ideal.span_le, Set.range_subset_iff]
  rfl

/-- Vanishing of the exact mixed products constructs the unique full original boundary arrow. -/
theorem originalBoundary_frame_lift_iff_products :
    (∃! d : B ⟶ pullback p J.subschemeι, d ≫ c = t) ↔
      ∀ z : Fin n → Γ(J.subscheme, ⊤),
        originalBoundaryFrameCoefficientProduct J hJ t n a z = 0 := by
  let _ := originalBoundaryComparison_mono e J hJ
  let _ : IsFinite (pullback.snd p (t ≫ pullback.fst f f ≫ J.subschemeι)) :=
    finite_pullback_of_exactRank (Over.mk p) n _ ht
  let _ := originalBoundary_comparison_test_closedImmersion J hJ t e
  rw [SchemeClosedScalarKernelLift.existsUnique_lift_iff, ← le_bot_iff,
    originalBoundary_frame_kernel_le_iff_products J hJ t n a ht e]
  rfl

end FLT.Mazur.EquivalenceRelationOrderedFrames
