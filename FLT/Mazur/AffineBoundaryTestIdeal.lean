module

public import FLT.Mazur.AffineBoundaryComponentEquations
public import Mathlib.RingTheory.Noetherian.Nilpotent

/-!
# Ideal powers of the fixed original boundary tests

The finite test ideal has an actual vanishing power precisely when its
minimal component equations hold. This controls mixed products of different
tests, not just separate powers, without assuming the boundary ring Noetherian.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
namespace FLT.Mazur.AffineScalarBoundaryNilpotence
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
attribute [local irreducible] boundaryProduct boundaryCoordinate
variable {R B T : Type} [CommRing R] [CommRing B] [CommRing T]
  (s : R →+* B) (κ : R →+* T) (a : Finset B)
set_option quotPrecheck false
local notation "C" => Γ(boundaryProduct s κ, ⊤)

/-- The actual finite ideal generated by the original tests on the unreduced boundary product. -/
def boundaryTestIdeal : Ideal C := Ideal.span (boundaryCoordinate s κ '' (a : Set B))

/-- Finite generation comes from the fixed tests alone. -/
theorem boundaryTestIdeal_fg : (boundaryTestIdeal s κ a).FG :=
  Submodule.fg_span (a.finite_toSet.image (boundaryCoordinate s κ))

/-- Every original test is in the constructed boundary ideal. -/
theorem boundaryCoordinate_mem_testIdeal {b : B} (hb : b ∈ a) :
    boundaryCoordinate s κ b ∈ boundaryTestIdeal s κ a :=
  Ideal.subset_span ⟨b, hb, rfl⟩

/-- An actual ideal power vanishes exactly when each fixed function is nilpotent. -/
theorem boundaryTestIdeal_nilpotent_iff :
    IsNilpotent (boundaryTestIdeal s κ a) ↔
      ∀ b ∈ a, IsNilpotent (boundaryCoordinate s κ b) := by
  rw [(boundaryTestIdeal_fg s κ a).isNilpotent_iff_le_nilradical]
  change Ideal.span _ ≤ nilradical C ↔ _
  rw [Ideal.span_le]
  constructor
  · intro h b hb
    exact mem_nilradical.mp (h ⟨b, hb, rfl⟩)
  · rintro h _ ⟨b, hb, rfl⟩
    exact mem_nilradical.mpr (h b hb)

/-- Equations on all minimal domain components construct one ideal-power equation. -/
theorem boundaryTestIdeal_nilpotent_iff_components :
    IsNilpotent (boundaryTestIdeal s κ a) ↔
      ∀ Q : minimalPrimes C, ∀ b ∈ a,
        Ideal.Quotient.mk Q.val (boundaryCoordinate s κ b) = 0 := by
  rw [boundaryTestIdeal_nilpotent_iff]
  simp_rw [boundaryCoordinate_nilpotent_iff_components]
  exact ⟨fun h Q b hb ↦ h b hb Q, fun h b hb Q ↦ h Q b hb⟩

/-- The same exponent kills every mixed product of elements of the boundary test ideal. -/
theorem exists_boundaryTestIdeal_product_length
    (h : ∀ Q : minimalPrimes C, ∀ b ∈ a,
      Ideal.Quotient.mk Q.val (boundaryCoordinate s κ b) = 0) :
    ∃ N : ℕ, ∀ t : Fin N → C,
      (∀ i, t i ∈ boundaryTestIdeal s κ a) → ∏ i, t i = 0 := by
  classical
  obtain ⟨N, hN⟩ := (boundaryTestIdeal_nilpotent_iff_components s κ a).mpr h
  refine ⟨N, fun t ht ↦ ?_⟩
  have hm : ∏ i, t i ∈ boundaryTestIdeal s κ a ^ N := by
    simpa only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] using
      (Ideal.prod_mem_prod (I := fun _ : Fin N ↦ boundaryTestIdeal s κ a)
        (s := Finset.univ) (fun i _ ↦ ht i))
  rw [hN] at hm
  exact hm

end FLT.Mazur.AffineScalarBoundaryNilpotence
