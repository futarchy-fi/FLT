module

public import FLT.Mazur.PolygonCompleteIdentityFirstChartResidualCoordinates
public import FLT.Mazur.PolygonCompleteIdentityFirstNodePolynomials

/-!
# Two actual ambient errors generate the entire original node kernel

The ambient node kernel is generated by its original parameter and the
two coordinate errors. This equality is before any localization or reduction.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing LaurentPolynomial LaurentFirstStageParameter
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointWeierstrassCurve completePointToIntegralCubic originalStageToCompatibleProj
  completeIdentityFirstActionUnit completeIdentityFirstActionField
  completeIdentityFirstActionNodeDefect completeIdentityFirstErrorAlgebra
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n]
local notation "A" => Ring K 1
local notation "t" => parameter K 1
local notation "e" => parameter K[T;T⁻¹] 1
local notation "B" => ChartRing (t)
local notation "s" => completeIdentityFirstAmbientSourceFunctions K n h
local notation "p" => completeIdentityFirstAmbientTargetFunctions K n h
local notation "a" => stageCoefficientMap (C : K →+* K[T;T⁻¹]) 1
local notation "b" => ringMap (a) (t) (e) (stageCoefficientMap_parameter _ _)
local notation "σ" => reciprocalScale (e) (parameterUnit K)
local notation "δ" => completeIdentityFirstAmbientError K n h
local notation "d" => completeIdentityFirstAmbientNodeReduction K n h

/-- No ambient node relation remains beyond the original parameter and two coordinate errors. -/
theorem completeIdentityFirstAmbientNodeKernel_twoCoordinates :
    RingHom.ker (d) = Ideal.span {completeIdentityFirstAmbientParameter K n h} ⊔
      Ideal.span {(δ) (leftCoordinate (t)), (δ) (rightCoordinate (t))} := by
  rw [completeIdentityFirstAmbientNodeKernel_generators]
  congr 1
  let g := (s).comp ((σ).toRingHom.comp (b))
  have hc (z : A) : (p) (algebraMap (A) (B) z) = g (algebraMap (A) (B) z) := by
    dsimp only [g, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [ringMap_scalar, AlgHom.commutes]
    exact (completeIdentityFirstNodePolynomialMap_coefficients K n h z).symm
  exact differenceIdeal_twoCoordinates (t) (p) g hc

end FLT.Mazur.PolygonInfinitesimalStages
