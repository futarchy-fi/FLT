module

public import FLT.Mazur.HilbertMultiplicationCoordinateRecovery
public import FLT.Mazur.HilbertBoundedMonomialBasis

/-!
# Bounded monomial coordinates generate all structure coordinates

Degree d+1 records multiplication of every degree-at-most-d basis polynomial
by each ambient variable. Their coordinates recover the entire multiplication
table over the original coefficient ring, including unit and generator entries.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.HilbertChart
variable {R S A I : Type*} [CommRing R] [CommRing S] [CommRing A]
  [Algebra R S] [Algebra S A] [Algebra R A] [IsScalarTower R S A]
  {d : ℕ} (v : Module.Basis (Fin d) S A) (D : Subalgebra R S) (x : I → A)

/-- Each variable has degree at most one, also over the zero ring. -/
theorem hilbert_variable_degree_le (i : I) :
    (MvPolynomial.X i : MvPolynomial I R).totalDegree ≤ 1 := by
  classical
  exact (MvPolynomial.totalDegree_monomial_le (Finsupp.single i 1) (1 : R)).trans
    (by simp)

/-- Bounded monomial coordinates control every polynomial within the same degree bound. -/
theorem bounded_polynomial_coordinates_mem (n : ℕ)
    (hm : ∀ m : BoundedHilbertMonomials I n, ∀ k,
      v.repr (MvPolynomial.aeval x (MvPolynomial.monomial m.val (1 : R))) k ∈ D)
    (p : MvPolynomial I R) (hp : p.totalDegree ≤ n) (k : Fin d) :
    v.repr (MvPolynomial.aeval x p) k ∈ D := by
  classical
  rw [p.as_sum]
  simp only [map_sum, Finsupp.finsetSum_apply]
  apply D.sum_mem
  intro m hmem
  have hb : m.sum (fun _ e ↦ e) ≤ n :=
    (MvPolynomial.le_totalDegree hmem).trans hp
  have h := hm ⟨m, hb⟩ k
  have he : MvPolynomial.monomial m (p.coeff m) =
      p.coeff m • MvPolynomial.monomial m (1 : R) := by
    simp only [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
  rw [he, map_smul, ← IsScalarTower.algebraMap_smul S (p.coeff m), map_smul,
    Finsupp.smul_apply, smul_eq_mul]
  exact D.mul_mem (D.algebraMap_mem _) h

/-- Every original structure coefficient is generated by the bounded coordinate columns. -/
theorem bounded_structure_coordinates_mem
    (hm : ∀ m : BoundedHilbertMonomials I (d + 1), ∀ k,
      v.repr (MvPolynomial.aeval x (MvPolynomial.monomial m.val (1 : R))) k ∈ D)
    (w : Fin d → MvPolynomial I R) (hw : ∀ j, (w j).totalDegree ≤ d)
    (hb : ∀ j, MvPolynomial.aeval x (w j) = v j) (i j k : Fin d) :
    structureCoeff v i j k ∈ D := by
  apply structure_coordinates_mem_of_polynomial_basis v D x _ w hb
  intro t a b
  rw [← hb a, ← MvPolynomial.aeval_X (R := R) x t, ← map_mul (MvPolynomial.aeval x)]
  apply bounded_polynomial_coordinates_mem v D x (d + 1) hm
  exact (MvPolynomial.totalDegree_mul _ _).trans
    (Nat.add_le_add (hw a) (hilbert_variable_degree_le (R := R) _))

/-- The unit coordinates already occur in degree zero. -/
theorem bounded_unit_coordinates_mem
    (hm : ∀ m : BoundedHilbertMonomials I (d + 1), ∀ k,
      v.repr (MvPolynomial.aeval x (MvPolynomial.monomial m.val (1 : R))) k ∈ D)
    (k : Fin d) : structureUnit v k ∈ D := by
  have h := bounded_polynomial_coordinates_mem v D x (d + 1) hm 1
    (by simp only [MvPolynomial.totalDegree_one]; exact Nat.zero_le _) k
  simpa only [map_one, structureUnit] using h

/-- Every ambient generator coordinate occurs in degree one. -/
theorem bounded_generator_coordinates_mem
    (hm : ∀ m : BoundedHilbertMonomials I (d + 1), ∀ k,
      v.repr (MvPolynomial.aeval x (MvPolynomial.monomial m.val (1 : R))) k ∈ D)
    (i : I) (k : Fin d) : v.repr (x i) k ∈ D := by
  have h := bounded_polynomial_coordinates_mem v D x (d + 1) hm (MvPolynomial.X i)
    ((hilbert_variable_degree_le (R := R) _).trans (Nat.succ_le_succ (Nat.zero_le d))) k
  rwa [MvPolynomial.aeval_X] at h

end FLT.Mazur.HilbertChart
