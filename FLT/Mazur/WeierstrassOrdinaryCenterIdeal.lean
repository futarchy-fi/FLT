module

public import FLT.Mazur.WeierstrassOrdinarySingularCenter
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Ordinary addition preserves the actual center ideal

Quotienting by an arbitrary ideal turns the second input into the singular
origin. The ring-level origin calculation therefore proves ideal membership
for both output coordinates, retaining the entire nonreduced center.
-/

@[expose] public noncomputable section

namespace FLT.Mazur.WeierstrassIntegralChart

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
  (W : WeierstrassCurve R)

/-- Ordinary output coordinates lie in any ideal containing the original center data. -/
theorem ordinarySpecialization_output_mem_center (b : Bool)
    (f : additionChartRing W (ordinaryIndex b) →ₐ[R] S) (I : Ideal S)
    (h3 : algebraMap R S W.a₃ ∈ I) (h4 : algebraMap R S W.a₄ ∈ I)
    (hx : f (ordinaryInputRight W b (coord W 2 0)) ∈ I)
    (hy : f (ordinaryInputRight W b (coord W 2 1)) ∈ I) :
    f (ordinaryChartAddition W b (coord W 2 0)) ∈ I ∧
      f (ordinaryChartAddition W b (coord W 2 1)) ∈ I := by
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  have h := ordinarySpecialization_singular_origin W b (q.comp f)
    (by
      rw [IsScalarTower.algebraMap_apply R S (S ⧸ I)]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr h3)
    (by
      rw [IsScalarTower.algebraMap_apply R S (S ⧸ I)]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr h4)
    (Ideal.Quotient.eq_zero_iff_mem.mpr hx) (Ideal.Quotient.eq_zero_iff_mem.mpr hy)
  exact ⟨Ideal.Quotient.eq_zero_iff_mem.mp h.1, Ideal.Quotient.eq_zero_iff_mem.mp h.2⟩

/-- The actual center generated by scale and second-input coordinates contains both outputs. -/
theorem ordinarySpecialization_modificationCenter (b : Bool)
    (f : additionChartRing W (ordinaryIndex b) →ₐ[R] S) (s b3 b4 : R)
    (h3 : W.a₃ = s * b3) (h4 : W.a₄ = s * b4) :
    let I : Ideal S := Ideal.span
      {algebraMap R S s, f (ordinaryInputRight W b (coord W 2 0)),
        f (ordinaryInputRight W b (coord W 2 1))}
    f (ordinaryChartAddition W b (coord W 2 0)) ∈ I ∧
      f (ordinaryChartAddition W b (coord W 2 1)) ∈ I := by
  dsimp only
  apply ordinarySpecialization_output_mem_center W b f
  · rw [h3, map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  · rw [h4, map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  · exact Ideal.subset_span (by simp)
  · exact Ideal.subset_span (by simp)

end FLT.Mazur.WeierstrassIntegralChart
