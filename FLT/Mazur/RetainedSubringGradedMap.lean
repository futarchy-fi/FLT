module

public import FLT.Mazur.RetainedSubringGrading
public import Mathlib.RingTheory.GradedAlgebra.RingHom

/-!
# Original graded maps on retained subrings

Every degree-preserving ring map restricts to the independently defined
retained subrings. The restricted map keeps the original values and degrees.
-/

@[expose] public noncomputable section

namespace FLT.Mazur.RetainedSubringGradedMap

open RetainedSubringGrading

variable {A B σ τ : Type*} [CommRing A] [CommRing B]
  [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
  (𝒜 : ℕ → σ) (ℬ : ℕ → τ) [GradedRing 𝒜] [GradedRing ℬ]
  (f : 𝒜 →+*ᵍ ℬ) (q : ℕ)

omit [AddSubgroupClass σ A] [AddSubgroupClass τ B] [GradedRing 𝒜] [GradedRing ℬ] in
/-- The original map preserves the subrings generated by the retained degrees. -/
theorem map_mem (a : ring 𝒜 q) : f a ∈ ring ℬ q := by
  have hle : ring 𝒜 q ≤ (ring ℬ q).comap f.toRingHom := by
    apply Subring.closure_le.mpr
    intro s hs
    obtain ⟨d, hd⟩ := Set.mem_iUnion.mp hs
    exact Subring.subset_closure (Set.mem_iUnion.mpr ⟨d, f.map_mem hd⟩)
  exact hle a.property

/-- Restrict the original graded ring map without changing its action. -/
def map : grade 𝒜 q →+*ᵍ grade ℬ q where
  __ := RingHom.codRestrict (f.toRingHom.comp (ring 𝒜 q).subtype) _ (map_mem 𝒜 ℬ f q)
  map_mem := fun hs ↦ f.map_mem hs

omit [GradedRing 𝒜] [GradedRing ℬ] in
/-- Restriction retains the actual original value on every retained element. -/
theorem map_val (a : ring 𝒜 q) : (map 𝒜 ℬ f q a).val = f a := rfl

end FLT.Mazur.RetainedSubringGradedMap
