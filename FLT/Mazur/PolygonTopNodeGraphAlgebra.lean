module

public import FLT.Mazur.PolygonTopNodeActionDefect
public import FLT.Mazur.PolygonSmoothingRangeGenerators
public import FLT.Mazur.SquareZeroPairAdjoin

/-!
# The actual top-order node graph algebra is finite

Inside the two full punctured branches, join the original node algebra with
its unchanged action image. This actual graph algebra is obtained by adjoining
exactly the two coordinate errors, whose pairwise products vanish. It is a
finite extension; no equality with the original node algebra is assumed.
-/

@[expose] public noncomputable section
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing PolygonChartScaling PolygonScalingNaturality
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] PolygonSmoothing.relationIdeal
  topNodeActionDefect
variable (R : Type) [CommRing R] (m : ℕ)
variable (u v : ((Ring R (m + 1))[T;T⁻¹])ˣ) (a : (Ring R (m + 1))ˣ)
local notation "S" => Ring R (m + 1)
local notation "e" => parameter R (m + 1)
local notation "B" => ChartRing (e)
local notation "L" => (S)[T;T⁻¹]
local notation "C" => stageNodeBranchSubalgebra R (m + 1)
local notation "β" => stageNodeBranchPair R (m + 1)
local notation "F" => stageNodeBranchSubstitution R (m + 1) u v
local notation "D" => topNodeActionDefect R m u v a
local notation "x" => leftCoordinate (e)
local notation "y" => rightCoordinate (e)
local notation "σ" => reciprocalScale (e) (a)

/-- The algebra generated by the source and target of the prescribed full node action. -/
def topNodeGraphAlgebra : Subalgebra (S) ((L) × (L)) :=
  (C) ⊔ ((F).comp (β)).range

/-- Adjoin the two actual original coordinate errors over the embedded source node algebra. -/
def topNodeErrorAlgebra : Subalgebra (C) ((L) × (L)) :=
  Algebra.adjoin (C) ({(D) (x), (D) (y)} : Set ((L) × (L)))

variable
  (hu : coeffMap (restriction R m).toRingHom u.val =
    LaurentPolynomial.C (restriction R m a.val) * LaurentPolynomial.T 1)
  (hv : coeffMap (restriction R m).toRingHom v.val =
    LaurentPolynomial.C (restriction R m a⁻¹.val) * LaurentPolynomial.T 1)
include hu hv

/-- The two error generators give a finite module over the original node algebra. -/
theorem topNodeErrorAlgebra_finite :
    Module.Finite (C) (topNodeErrorAlgebra R m u v a) :=
  SquareZeroPairAdjoin.finite _ _
    (topNodeActionDefect_mul_zero R m u v a hu hv (x) (x))
    (topNodeActionDefect_mul_zero R m u v a hu hv (y) (y))

/-- The error algebra has an explicit three-term normal form with original node coefficients. -/
theorem topNodeErrorAlgebra_normalForm (z : (L) × (L))
    (hz : z ∈ topNodeErrorAlgebra R m u v a) :
    ∃ a b c : C, z = a.val + b.val * (D) (x) + c.val * (D) (y) :=
  @SquareZeroPairAdjoin.normalForm (C) ((L) × (L)) _ _ _ _ _
    (topNodeActionDefect_mul_zero R m u v a hu hv (x) (x))
    (topNodeActionDefect_mul_zero R m u v a hu hv (x) (y))
    (topNodeActionDefect_mul_zero R m u v a hu hv (y) (y)) z hz

omit hu hv in
/-- The embedded original node is contained in the error algebra. -/
theorem topNodeErrorAlgebra_source :
    (C) ≤ (topNodeErrorAlgebra R m u v a).restrictScalars (S) := by
  intro z hz
  exact (topNodeErrorAlgebra R m u v a).algebraMap_mem ⟨z, hz⟩

omit hu hv in
/-- Both original coordinate images belong to this concrete finite extension. -/
theorem topNodeErrorAlgebra_coordinate (z : B)
    (hz : z = (x) ∨ z = (y)) :
    (F) ((β) z) ∈ topNodeErrorAlgebra R m u v a := by
  have hd : (D) z ∈ topNodeErrorAlgebra R m u v a := by
    apply Algebra.subset_adjoin
    rcases hz with rfl | rfl <;> simp
  have hs : (β) ((σ) z) ∈ topNodeErrorAlgebra R m u v a :=
    topNodeErrorAlgebra_source R m u v a ⟨_, rfl⟩
  have hm := (topNodeErrorAlgebra R m u v a).add_mem hd hs
  simpa only [topNodeActionDefect_apply, sub_add_cancel] using hm

omit hu hv in
/-- The finite extension contains every original action image, with all nilpotents retained. -/
theorem topNodeErrorAlgebra_target :
    ((F).comp (β)).range ≤
      (topNodeErrorAlgebra R m u v a).restrictScalars (S) := by
  apply (range_le_iff_coordinates (e) _ _).mpr
  exact ⟨topNodeErrorAlgebra_coordinate R m u v a (x) (Or.inl rfl),
    topNodeErrorAlgebra_coordinate R m u v a (y) (Or.inr rfl)⟩

/-- The finite error extension is precisely the actual source-target graph algebra. -/
theorem topNodeErrorAlgebra_eq_graph :
    (topNodeErrorAlgebra R m u v a).restrictScalars (S) =
      topNodeGraphAlgebra R m u v := by
  apply le_antisymm
  · intro z hz
    obtain ⟨a₀, b, c, rfl⟩ := topNodeErrorAlgebra_normalForm R m u v a hu hv z hz
    have hs : (C) ≤ topNodeGraphAlgebra R m u v := le_sup_left
    have ht : ((F).comp (β)).range ≤
        topNodeGraphAlgebra R m u v := le_sup_right
    have hd (w : B) : (D) w ∈ topNodeGraphAlgebra R m u v := by
      rw [topNodeActionDefect_apply]
      exact (topNodeGraphAlgebra R m u v).sub_mem
        (ht ⟨w, rfl⟩) (hs ⟨(σ) w, rfl⟩)
    exact Subalgebra.add_mem _
      (Subalgebra.add_mem _ (hs a₀.property) (Subalgebra.mul_mem _ (hs b.property) (hd (x))))
      (Subalgebra.mul_mem _ (hs c.property) (hd (y)))
  · exact sup_le (topNodeErrorAlgebra_source R m u v a)
      (topNodeErrorAlgebra_target R m u v a)

/-- Parameter multiplication of any graph function already belongs to the original node. -/
theorem topNodeGraphAlgebra_parameter (z : (L) × (L))
    (hz : z ∈ topNodeGraphAlgebra R m u v) :
    (e) • z ∈ (C) := by
  rw [← topNodeErrorAlgebra_eq_graph R m u v a hu hv] at hz
  obtain ⟨a₀, b, c, rfl⟩ := topNodeErrorAlgebra_normalForm R m u v a hu hv z hz
  simp only [smul_add, ← mul_smul_comm,
    topNodeActionDefect_parameter R m u v a hu hv, mul_zero, add_zero]
  exact (C).smul_mem a₀.property (e)

end FLT.Mazur.PolygonInfinitesimalStages
