module

public import FLT.Mazur.AffinePullbackIdeal

/-!
# Original image equations on affine base changes

The ideal of a base change of a schematic image is generated by the original
section kernel. Taking the image of the base-changed map is not required.
Regular factors can be cancelled in that original kernel before base change.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
namespace FLT.Mazur.SchematicImageAffineEquations
variable {X Y T : Scheme} (f : X ⟶ Y) (k : T ⟶ Y)
  (V : Y.affineOpens) (U : T.affineOpens) (e : U.1 ≤ k ⁻¹ᵁ V.1)

/-- Closing the original image preserves its entire kernel ideal sheaf. -/
theorem image_kernel : f.imageι.ker = f.ker :=
  Scheme.IdealSheafData.ker_subschemeι _

variable [QuasiCompact f]

/-- The full pulled-back image ideal is the extension of the original section kernel. -/
theorem affine_ideal :
    (f.imageι.ker.comap k).ideal U =
      (RingHom.ker (f.app V).hom).map (k.appLE V U e).hom := by
  rw [image_kernel, Scheme.IdealSheafData.ideal_comap _ k V U e, Scheme.Hom.ker_apply]

/-- Every original equation remains an equation on the literal base-changed image. -/
theorem equation (z : Γ(Y, V)) (hz : f.app V z = 0) :
    k.appLE V U e z ∈ (f.imageι.ker.comap k).ideal U := by
  rw [affine_ideal f k V U e]
  exact Ideal.mem_map_of_mem _ hz

/-- A factor regular on the original source may be cancelled before taking the image. -/
theorem cancel_equation (a z : Γ(Y, V)) (ha : IsRegular (f.app V a))
    (hz : f.app V (a * z) = 0) :
    k.appLE V U e z ∈ (f.imageι.ker.comap k).ideal U := by
  apply equation f k V U e
  apply ha.left
  simpa only [map_mul, mul_zero] using hz

/-- Powers of a regular original factor can also be removed before specialization. -/
theorem cancel_power_equation (a z : Γ(Y, V)) (r : ℕ)
    (ha : IsRegular (f.app V a)) (hz : f.app V (a ^ r * z) = 0) :
    k.appLE V U e z ∈ (f.imageι.ker.comap k).ideal U := by
  apply cancel_equation f k V U e (a ^ r) z
  · simpa only [map_pow] using ha.pow r
  · exact hz

end FLT.Mazur.SchematicImageAffineEquations
