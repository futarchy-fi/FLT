module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.FieldTheory.SeparableClosure
public import Mathlib.RingTheory.FiniteType

/-!
# Finite separable witnesses for affine points

A point of a finitely generated algebra in a separable extension factors
through the finite separable field generated by the images of generators.
The factorization is exact on the entire algebra.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.FiniteSeparablePointFactor
variable {k K A : Type} [Field k] [Field K] [Algebra k K]
  [Algebra.IsSeparable k K] [CommRing A] [Algebra k A] [Algebra.FiniteType k A]

/-- An affine point in a separable extension has an actual finite separable coefficient field. -/
theorem exists_factor (q : A →ₐ[k] K) :
    ∃ (L : IntermediateField k K) (q₀ : A →ₐ[k] L),
      Module.Finite k L ∧ Algebra.IsSeparable k L ∧ L.val.comp q₀ = q := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := k) (A := A)
  let L := IntermediateField.adjoin k (q '' (s : Set A))
  have hfinite : (q '' (s : Set A)).Finite := s.finite_toSet.image q
  let _ := hfinite.fintype
  have hL : Module.Finite k L := IntermediateField.finiteDimensional_adjoin
    (fun x _ ↦ (Algebra.IsSeparable.isSeparable k x).isIntegral)
  have hq (a : A) : q a ∈ L := by
    have h : (⊤ : Subalgebra k A) ≤ L.toSubalgebra.comap q := by
      rw [← hs]
      apply Algebra.adjoin_le
      intro a ha
      exact IntermediateField.subset_adjoin k _ ⟨a, ha, rfl⟩
    exact h (show a ∈ (⊤ : Subalgebra k A) from trivial)
  let q₀ : A →ₐ[k] L := q.codRestrict L.toSubalgebra hq
  exact ⟨L, q₀, hL, inferInstance, rfl⟩

end FLT.Mazur.FiniteSeparablePointFactor
