module

public import FLT.Mazur.CyclicCharacteristicAffineArrowGeometry
public import Mathlib.RingTheory.Noetherian.Nilpotent

/-!
# A single nilpotent ideal controls every finite-invariant discrepancy

The entire affine residual arrow ring is Noetherian. Its ideal generated by
all finite-relabeling discrepancies is therefore nilpotent, with one exponent
independent of the function. This preserves the infinitesimal obstruction
instead of replacing the full relation by its geometric points.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
namespace FLT.Mazur.CyclicCharacteristicOrbit
open CyclicCharacteristicAtlas
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
variable (n : ℕ) [NeZero n] (i : InvariantAffineIndex n)

/-- The ideal of actual discrepancies of all finite fixed regular functions. -/
def affineRelabelDiscrepancyIdeal : Ideal Γ((affineResidualDomain n i).toScheme, ⊤) :=
  Ideal.span (Set.range (fun s : affineRelabelSections n i =>
    (affineResidualSource n i).appTop s.val - (affineResidualTarget n i).appTop s.val))

/-- Every original finite-invariant discrepancy belongs to the retained obstruction ideal. -/
theorem affineRelabelDiscrepancy_mem (s : affineRelabelSections n i) :
    (affineResidualSource n i).appTop s.val - (affineResidualTarget n i).appTop s.val ∈
      affineRelabelDiscrepancyIdeal n i :=
  Ideal.subset_span ⟨s, rfl⟩

/-- Geometric agreement puts the entire discrepancy ideal in the nilradical. -/
theorem affineRelabelDiscrepancyIdeal_le_nilradical :
    affineRelabelDiscrepancyIdeal n i ≤
      nilradical Γ((affineResidualDomain n i).toScheme, ⊤) := by
  apply Ideal.span_le.mpr
  rintro _ ⟨s, rfl⟩
  exact mem_nilradical.mpr (affineRelabelSections_discrepancy_nilpotent n i s)

/-- Noetherianity gives a single nilpotence bound for every finite-invariant discrepancy. -/
theorem affineRelabelDiscrepancyIdeal_isNilpotent :
    IsNilpotent (affineRelabelDiscrepancyIdeal n i) :=
  (Ideal.FG.isNilpotent_iff_le_nilradical (IsNoetherian.noetherian _)).mpr
    (affineRelabelDiscrepancyIdeal_le_nilradical n i)

/-- One positive exponent annihilates all actual discrepancies simultaneously. -/
theorem affineRelabelDiscrepancy_uniform_exponent :
    ∃ k : ℕ, 0 < k ∧ ∀ s : affineRelabelSections n i,
      ((affineResidualSource n i).appTop s.val -
        (affineResidualTarget n i).appTop s.val) ^ k = 0 := by
  obtain ⟨k, hk⟩ := affineRelabelDiscrepancyIdeal_isNilpotent n i
  refine ⟨k + 1, Nat.succ_pos _, fun s => ?_⟩
  have h := Ideal.pow_mem_pow (affineRelabelDiscrepancy_mem n i s) k
  rw [hk] at h
  exact pow_eq_zero_of_le (Nat.le_succ k) h

end FLT.Mazur.CyclicCharacteristicOrbit
