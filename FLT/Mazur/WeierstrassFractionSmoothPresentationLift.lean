module

public import FLT.Mazur.WeierstrassFractionSmoothPresentation

/-!
# Rees lifts on the actual refined fraction-smooth product

On every member whose original output lies in the affine cubic chart,
instantiate the regular-center lift with the constructed smooth parameter,
input projection and output coordinates. All presentation and flatness
hypotheses are proved by the actual source construction.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

namespace FLT.Mazur.WeierstrassIntegralChart

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

universe u
variable {R : Type u} [CommRing R] (W : WeierstrassCurve R) (s b3 b4 b6 : R)
  (h3 : W.a₃ = s * b3) (h4 : W.a₄ = s * b4) (h6 : W.a₆ = s * b6)
  (f : Coordinate W 2) (hf : f ∈ modificationChartCenter W s 2)
  (i : (fractionSmoothCover W s f).I₀)
  (hi : modifiedSmoothOutputIndex W (fractionSmoothContraction W s f) i = 2)

/-- The actual action lifts on each affine-output member of the constructed source cover. -/
irreducible_def fractionSmoothPresentationToRees :
    Spec ((fractionSmoothCover W s f).X i) ⟶
      BlowupRees.proj (modificationChartCenter W s 2) :=
  leftSmoothFractionActionToRees W s b3 b4 b6 h3 h4 h6
    (modifiedSmoothAffineParameter W (fractionSmoothContraction W s f) i)
    (modifiedSmoothOutputHomAt W (fractionSmoothContraction W s f) i 2 hi)
    (fractionSmoothOriginalHom W s f i)
    (fractionSmoothParameter_structure W s f i) (fractionSmoothOutput_addition W s f i hi)
    f hf (modifiedSmoothAffineInputHom W (fractionSmoothContraction W s f) i) rfl
    (modifiedSmoothAffineInputHom_flat W (fractionSmoothContraction W s f) i)

/-- The constructed lift retains the exact original affine output coordinates. -/
@[reassoc] theorem fractionSmoothPresentationToRees_contraction :
    fractionSmoothPresentationToRees W s b3 b4 b6 h3 h4 h6 f hf i hi ≫
        BlowupRees.contraction (modificationChartCenter W s 2) =
      Spec.map (CommRingCat.ofHom
        (modifiedSmoothOutputHomAt W (fractionSmoothContraction W s f) i 2 hi)) := by
  rw [fractionSmoothPresentationToRees_def, leftSmoothFractionActionToRees_contraction]

/-- In the original projective curve, the contraction is exactly the restricted original action. -/
@[reassoc] theorem fractionSmoothPresentationToRees_action :
    fractionSmoothPresentationToRees W s b3 b4 b6 h3 h4 h6 f hf i hi ≫
        BlowupRees.contraction (modificationChartCenter W s 2) ≫ integralCurveChart W 2 =
      (fractionSmoothCover W s f).f i ≫
        modifiedSmoothAffineAddition W (fractionSmoothContraction W s f) := by
  rw [fractionSmoothPresentationToRees_contraction_assoc,
    modifiedSmoothOutputHomAt_addition, ← modifiedSmoothAffineCover_addition]

include h3 h4 h6 hf in
/-- The full output center on an actual source member is generated by its retained denominator. -/
theorem fractionSmoothPresentation_center :
    (modificationChartCenter W s 2).map
        (modifiedSmoothOutputHomAt W (fractionSmoothContraction W s f) i 2 hi) =
      Ideal.span {fractionSmoothOriginalHom W s f i f} :=
  leftSmoothFractionAction_principal W s b3 b4 b6 h3 h4 h6
    (modifiedSmoothAffineParameter W (fractionSmoothContraction W s f) i)
    (modifiedSmoothOutputHomAt W (fractionSmoothContraction W s f) i 2 hi)
    (fractionSmoothOriginalHom W s f i)
    (fractionSmoothParameter_structure W s f i) (fractionSmoothOutput_addition W s f i hi)
    f hf (modifiedSmoothAffineInputHom W (fractionSmoothContraction W s f) i) rfl

end FLT.Mazur.WeierstrassIntegralChart
