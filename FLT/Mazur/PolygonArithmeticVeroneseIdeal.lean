module

public import FLT.Mazur.PolygonArithmeticVeronese

/-!
# The actual parameter ideal of the compatible Veronese

The retained integral-base algebra map determines its parameter ideal.
Every original stage evaluation kills the prescribed power of that ideal.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry

namespace FLT.Mazur.PolygonArithmeticStages

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

attribute [local irreducible] compatibleEval

variable (A : Type) [CommRing A] (π : A) (n : ℕ) (h : 2 ≤ n) (q : ℕ)

/-- The Veronese retains the integral-base scalar map at every original stage. -/
theorem compatibleVeroneseEval_algebraMap (m : ℕ) (r : A) :
    compatibleVeroneseEval A π n h q m
      (algebraMap (A) (CompatibleVeroneseSections A π n h q) r) =
        boundaryIntegralScalars A π n h m r := by
  change compatibleEval A π n h m (DirectSum.coeRingHom (compatibleVeroneseDegree A π n h q) _) = _
  rw [show DirectSum.coeRingHom (compatibleVeroneseDegree A π n h q)
      (algebraMap (A) (CompatibleVeroneseSections A π n h q) r) =
    algebraMap (A) (CompatibleSections A π n h) r from
      (DirectSum.coeAlgHom (compatibleVeroneseDegree A π n h q)).commutes r]
  exact compatibleEval_algebraMap A π n h m r

/-- The parameter ideal is generated by the original integral-base parameter. -/
def compatibleVeroneseParameterIdeal : Ideal (CompatibleVeroneseSections A π n h q) :=
  Ideal.span {algebraMap (A) (CompatibleVeroneseSections A π n h q) π}

/-- The original stage evaluation kills the corresponding actual parameter-ideal power. -/
theorem compatibleVeroneseParameterIdeal_le_ker (m : ℕ) :
    compatibleVeroneseParameterIdeal A π n h q ^ (m + 1) ≤
      RingHom.ker (compatibleVeroneseEval A π n h q m) := by
  rw [compatibleVeroneseParameterIdeal, Ideal.span_singleton_pow, Ideal.span_singleton_le_iff_mem]
  change compatibleVeroneseEval A π n h q m
    ((algebraMap (A) (CompatibleVeroneseSections A π n h q) π) ^
      (m + 1)) = 0
  rw [← map_pow, compatibleVeroneseEval_algebraMap]
  apply boundaryIntegralScalars_vanish
  rw [ideal, Ideal.span_singleton_pow]
  exact Ideal.subset_span (Set.mem_singleton _)

end FLT.Mazur.PolygonArithmeticStages
