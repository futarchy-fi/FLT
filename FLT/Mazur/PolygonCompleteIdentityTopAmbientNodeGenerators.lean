module

public import FLT.Mazur.PolygonCompleteIdentityTopChartResidualGenerators
public import FLT.Mazur.PolygonSmoothingDifferenceIdeal
public import FLT.Mazur.PolygonCompleteIdentityTopNodePolynomials

/-!
# Two actual ambient errors generate the entire original node kernel

The ambient node kernel is generated by its original parameter and the
two coordinate errors. This equality is before any localization or reduction.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing LaurentPolynomial LaurentStageParameter
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointWeierstrassCurve completePointToIntegralCubic originalStageToCompatibleProj
  completeIdentityTopActionUnit completeIdentityTopActionField
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (m : ℕ)
local notation "A" => Ring K (m + 1)
local notation "t" => parameter K (m + 1)
local notation "e" => parameter K[T;T⁻¹] (m + 1)
local notation "B" => ChartRing (t)
local notation "s" => completeIdentityTopAmbientSourceFunctions K n h m
local notation "p" => completeIdentityTopAmbientTargetFunctions K n h m
local notation "a" => stageCoefficientMap (C : K →+* K[T;T⁻¹]) (m + 1)
local notation "b" => ringMap (a) (t) (e) (stageCoefficientMap_parameter _ _)
local notation "σ" => reciprocalScale (e) (parameterUnit K (m + 1))
local notation "δ" => completeIdentityTopAmbientError K n h m
variable (hm : completeIdentityFiniteMulDefect K n h 0 m = 0)
local notation "d" => completeIdentityTopAmbientNodeReduction K n h m hm

/-- No ambient node relation remains beyond the original parameter and two coordinate errors. -/
theorem completeIdentityTopAmbientNodeKernel_twoCoordinates :
    RingHom.ker (d) = Ideal.span {completeIdentityTopAmbientParameter K n h m} ⊔
      Ideal.span {(δ) (leftCoordinate (t)), (δ) (rightCoordinate (t))} := by
  rw [completeIdentityTopAmbientNodeKernel_generators K n h m hm]
  congr 1
  let g := (s).comp ((σ).toRingHom.comp (b))
  have hc (z : A) : (p) (algebraMap (A) (B) z) = g (algebraMap (A) (B) z) := by
    dsimp only [g, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [ringMap_scalar, AlgHom.commutes]
    exact (completeIdentityTopNodePolynomialMap_coefficients K n h m z).symm
  exact differenceIdeal_twoCoordinates (t) (p) g hc

/-- The literal closed-fiber residual kernel has precisely the two actual coordinate errors. -/
theorem completeIdentityTopChartResidualKernel_twoCoordinates :
    RingHom.ker (completeIdentityTopChartClosedReduction K n h m hm) =
      Ideal.span {completeIdentityTopChartClosedError K n h m (leftCoordinate (t)),
        completeIdentityTopChartClosedError K n h m (rightCoordinate (t))} := by
  rw [← completeIdentityTopChartResidualKernel_image,
    completeIdentityTopAmbientNodeKernel_twoCoordinates, Ideal.map_sup,
    Ideal.map_span, Set.image_singleton, completeIdentityTopChartClosedAmbientMap_parameter,
    Ideal.span_singleton_zero, bot_sup_eq, Ideal.map_span, Set.image_insert_eq,
    Set.image_singleton]
  rfl

end FLT.Mazur.PolygonInfinitesimalStages
