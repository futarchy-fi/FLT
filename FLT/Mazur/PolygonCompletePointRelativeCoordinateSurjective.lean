module

public import FLT.Mazur.PolygonCompletePointRelativeAffineMorphism
public import FLT.Mazur.PolygonCompletePointNormalMonomials
public import FLT.Mazur.DivisorComplementExhaustion

/-!
# The actual cubic coordinates generate the entire relative complement ring
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry Scheme.Modules MonoidalCategory
namespace FLT.Mazur.PolygonInfinitesimalStages
open FCurve FCurve.ModuleLineBundleTensorPullback
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  divisorLineBundle ModuleSheafTensor.tensor sectionPoleMultiplicativeCoordinates
  relativePoleFunction completePointAllPoleBasis completePointHigherMonomial

variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (i : Fin n)
local notation "S" => Spec (CommRingCat.of (PowerSeries K))
local notation "f" => exactVeroneseProjToBase K n h
local notation "s" => completeBaseMarking K n h i
local notation "hI" => And.left (completeBaseMarking_relativeCartier K n h i)
local notation "e" => completePointSectionFrame K n h i

local notation "W" => completePointWeierstrassCurve K n h i
local notation "E" => completePointCoordinateEvaluation K n h i

/-- Every original base scalar belongs to the actual coordinate image. -/
theorem completePointCoordinateRange_scalar (a : Γ(S, ⊤)) :
    completePointComplementBaseMap K n h i a ∈ (E).range :=
  ⟨algebraMap Γ(S, ⊤) (W).toAffine.CoordinateRing a,
    completePointCoordinateEvaluation_scalar K n h i a⟩

/-- Every quadratic normal monomial belongs to the original coordinate image. -/
theorem completePointCoordinateRange_monomial (j : ℕ) :
    WeightedPoleMonomials.monomial (completePointComplementX K n h i)
      (completePointComplementY K n h i) j ∈ (E).range := by
  have hx : completePointComplementX K n h i ∈ (E).range :=
    ⟨algebraMap (Polynomial Γ(S, ⊤)) (W).toAffine.CoordinateRing Polynomial.X,
      completePointCoordinateEvaluation_x K n h i⟩
  have hy : completePointComplementY K n h i ∈ (E).range :=
    ⟨AdjoinRoot.root (W).toAffine.polynomial, completePointCoordinateEvaluation_y K n h i⟩
  exact (E).range.mul_mem ((E).range.pow_mem hx _) ((E).range.pow_mem hy _)

/-- Every original positive pole section is generated by the actual cubic coordinates. -/
theorem completePointCoordinateRange_positive (m : ℕ)
    (z : ModuleRingH (f).appTop.hom
      (tensorPower (completePointLine K n h i) (m + 1)) 0) :
    relativePoleFunction f s hI (m + 1) z ∈ (E).range := by
  have hz := congrArg (relativePoleFunctionAddHom f s hI (m + 1))
    ((completePointAllPoleBasis K n h i m).sum_repr z)
  rw [map_sum] at hz
  change (∑ j, relativePoleFunction f s hI (m + 1)
    ((completePointAllPoleBasis K n h i m).repr z j •
      completePointAllPoleBasis K n h i m j)) =
      relativePoleFunction f s hI (m + 1) z at hz
  erw [← hz]
  apply (E).range.sum_mem
  intro j _
  have hf : relativePoleFunction f s hI (m + 1)
      (completePointAllPoleBasis K n h i m j) =
        WeightedPoleMonomials.monomial (completePointComplementX K n h i)
          (completePointComplementY K n h i) j :=
    (completePointAllPoleBasis_function K n h i m j).trans
      (completePointOrderedFunction_monomial K n h i j)
  rw [relativePoleFunction_smul, hf]
  exact (E).range.mul_mem (completePointCoordinateRange_scalar K n h i _)
    (completePointCoordinateRange_monomial K n h i j)

/-- Degree zero is included using the original divisor transition. -/
theorem completePointCoordinateRange_pole (m : ℕ)
    (z : ModuleRingH (f).appTop.hom
      (tensorPower (completePointLine K n h i) m) 0) :
    relativePoleFunction f s hI m z ∈ (E).range := by
  rw [← relativePoleFunction_step f s hI m z]
  exact completePointCoordinateRange_positive K n h i m _

/-- The cubic coordinates generate every regular function on the actual complement. -/
theorem completePointCoordinateEvaluation_surjective : Function.Surjective E := by
  let _ := exactVeroneseProjToBase_isProper K n h
  let _ := Chow.source_isNoetherian (f)
  intro z
  obtain ⟨m, t, ht⟩ := exists_divisorComplementFunction hI z
  have hz := completePointCoordinateRange_pole K n h i m ((moduleH0Equiv _).symm t)
  unfold relativePoleFunction at hz
  erw [LinearEquiv.apply_symm_apply, ht] at hz
  exact hz

end FLT.Mazur.PolygonInfinitesimalStages
