module

public import FLT.Mazur.RootsOfUnityPolynomialPresentation

/-!
# The exact Laurent ideal of roots of unity

Reduction of exponents modulo n has kernel generated by T^n - 1. The proof
uses the polynomial quotient presentation after clearing negative exponents.
The generator is regular over every coefficient ring, including nonreduced ones.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

open Polynomial LaurentPolynomial
open scoped LaurentPolynomial

namespace FLT.Mazur.RootsOfUnityLaurentKernel

open RootsOfUnityAlgebra RootsOfUnityPolynomialPresentation

variable (R : Type*) [CommRing R] (n : ℕ) [NeZero n]

/-- Polynomial restriction agrees with the quotient's actual character isomorphism. -/
theorem restriction_toLaurent (f : R[X]) :
    restriction R n (Polynomial.toLaurent f) =
      coordinateEquiv R n (AdjoinRoot.mk (equation R n) f) := by
  have h : (restriction R n).toAlgHom.comp Polynomial.toLaurentAlg =
      (coordinateEquiv R n).toAlgHom.comp (aeval (AdjoinRoot.root (equation R n))) := by
    apply Polynomial.algHom_ext
    simp only [AlgHom.comp_apply, Polynomial.toLaurentAlg_apply, Polynomial.toLaurent_X,
      restriction_T, Int.cast_one, aeval_X, AlgEquiv.coe_toAlgHom, BialgHom.coe_toAlgHom,
      coordinateEquiv_root, rootUnit]
  simpa only [AlgHom.comp_apply, Polynomial.toLaurentAlg_apply,
    AlgEquiv.coe_toAlgHom, BialgHom.coe_toAlgHom, AdjoinRoot.aeval_eq] using
    DFunLike.congr_fun h f

/-- The kernel on the polynomial chart is exactly its monic equation. -/
theorem restriction_toLaurent_eq_zero (f : R[X]) :
    restriction R n (Polynomial.toLaurent f) = 0 ↔ equation R n ∣ f := by
  rw [restriction_toLaurent, map_eq_zero_iff _ (coordinateEquiv R n).injective,
    AdjoinRoot.mk_eq_zero]

/-- The full Laurent relation includes all negative exponents. -/
theorem restriction_eq_zero (f : R[T;T⁻¹]) :
    restriction R n f = 0 ↔ T (n : ℤ) - 1 ∣ f := by
  constructor
  · intro hf
    obtain ⟨k, g, hg⟩ := LaurentPolynomial.exists_T_pow f
    have hz : restriction R n (Polynomial.toLaurent g) = 0 := by
      rw [hg, map_mul, hf, zero_mul]
    obtain ⟨q, hq⟩ := (restriction_toLaurent_eq_zero R n g).mp hz
    have he : Polynomial.toLaurent (equation R n) = T (n : ℤ) - 1 := by
      simp only [equation, map_sub, Polynomial.toLaurent_X_pow, map_one]
    have hm : f * T (k : ℤ) = (T (n : ℤ) - 1) * Polynomial.toLaurent q := by
      rw [← hg, hq, map_mul, he]
    refine ⟨Polynomial.toLaurent q * T (-(k : ℤ)), ?_⟩
    calc
      f = (f * T (k : ℤ)) * T (-(k : ℤ)) := by
        rw [mul_assoc, ← T_add, add_neg_cancel, T_zero, mul_one]
      _ = _ := by rw [hm, mul_assoc]
  · rintro ⟨q, rfl⟩
    rw [map_mul, map_sub, map_one, restriction_T]
    simp only [Int.cast_natCast, ZMod.natCast_self, ← AddMonoidAlgebra.one_def,
      sub_self, zero_mul]

/-- The actual coordinate map has the principal Laurent kernel. -/
theorem kernel : RingHom.ker (restriction R n).toAlgHom.toRingHom =
    Ideal.span {T (n : ℤ) - (1 : R[T;T⁻¹])} := by
  ext f
  exact (restriction_eq_zero R n f).trans Ideal.mem_span_singleton.symm

/-- The defining Laurent equation is regular without any domain assumption. -/
theorem equation_regular : IsRegular (T (n : ℤ) - (1 : R[T;T⁻¹])) := by
  have h := (Polynomial.monic_X_pow_sub_one (R := R) (NeZero.ne n)).isRegular
  have hm := IsLocalization.nonZeroDivisors_le_comap
    (Submonoid.powers (X : R[X])) R[T;T⁻¹] h.mem_nonZeroDivisors
  apply isRegular_iff_mem_nonZeroDivisors.mpr
  change algebraMap R[X] R[T;T⁻¹] (X ^ n - 1) ∈ nonZeroDivisors R[T;T⁻¹] at hm
  simpa only [LaurentPolynomial.algebraMap_eq_toLaurent, map_sub, Polynomial.toLaurent_X_pow,
    map_one] using hm

end FLT.Mazur.RootsOfUnityLaurentKernel
