module

public import Mathlib.RingTheory.GradedAlgebra.Basic
public import Mathlib.Algebra.Ring.Subring.Basic

/-!
# Internal grading of a retained-degree subring

The subring generated by degrees divisible by a positive step has those
original homogeneous groups as its grading, with the degree divided by the step.
-/

@[expose] public noncomputable section

open scoped DirectSum

namespace FLT.Mazur.RetainedSubringGrading

variable {A σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] (q : ℕ)

/-- The subring generated by the retained original degrees. -/
def ring : Subring A := Subring.closure (⋃ d : ℕ, (𝒜 (q * d) : Set A))

/-- Degree d is the original degree q*d, inside the retained subring. -/
def grade (d : ℕ) : AddSubgroup (ring 𝒜 q) where
  carrier := {s | (s : A) ∈ 𝒜 (q * d)}
  zero_mem' := zero_mem _
  add_mem' := fun hs ht ↦ add_mem hs ht
  neg_mem' := fun hs ↦ neg_mem hs

/-- The retained groups use the original unit and multiplication. -/
instance gradeMonoid : SetLike.GradedMonoid (grade 𝒜 q) where
  one_mem := by
    change (1 : A) ∈ 𝒜 (q * 0)
    rw [Nat.mul_zero]
    exact SetLike.GradedOne.one_mem
  mul_mem := by
    intro i j s t hs ht
    change (s : A) * (t : A) ∈ 𝒜 (q * (i + j))
    rw [Nat.mul_add]
    exact SetLike.GradedMul.mul_mem hs ht

/-- Recomposition reaches the whole subring generated by retained degrees. -/
theorem recompose_surjective : Function.Surjective (DirectSum.coeRingHom (grade 𝒜 q)) := by
  intro s
  have hr : ring 𝒜 q ≤ ((ring 𝒜 q).subtype.comp
      (DirectSum.coeRingHom (grade 𝒜 q))).range := by
    apply Subring.closure_le.mpr
    intro x hx
    obtain ⟨d, hd⟩ := Set.mem_iUnion.mp hx
    refine ⟨DirectSum.of _ d ⟨⟨x, Subring.subset_closure hx⟩, hd⟩, ?_⟩
    simp only [RingHom.comp_apply, DirectSum.coeRingHom_of, Subring.subtype_apply]
  obtain ⟨t, ht⟩ := hr s.property
  exact ⟨t, Subtype.ext ht⟩

/-- Projection in the original grading extracts the retained coefficient. -/
theorem project_recompose (hq : 0 < q) (d : ℕ) (s : ⨁ i, grade 𝒜 q i) :
    GradedRing.proj 𝒜 (q * d) (DirectSum.coeRingHom (grade 𝒜 q) s : A) =
      ((s d : ring 𝒜 q) : A) := by
  induction s using DirectSum.induction_on with
  | zero => simp only [map_zero, ZeroMemClass.coe_zero, DFinsupp.coe_zero, Pi.zero_apply]
  | of j s =>
    rw [DirectSum.coeRingHom_of, GradedRing.proj_apply,
      DirectSum.decompose_of_mem 𝒜 s.property]
    by_cases hj : j = d
    · subst j
      rw [DirectSum.of_eq_same, DirectSum.of_eq_same]
    · rw [DirectSum.of_eq_of_ne _ _ _ (Ne.symm
        (fun he ↦ hj (Nat.eq_of_mul_eq_mul_left hq he))),
        DirectSum.of_eq_of_ne _ _ _ (Ne.symm hj)]
      rfl
  | add s t hs ht =>
    simp only [map_add, Subring.coe_add, hs, ht]
    rfl

/-- Distinct retained degrees remain independent because the step is positive. -/
theorem recompose_injective (hq : 0 < q) :
    Function.Injective (DirectSum.coeRingHom (grade 𝒜 q)) := by
  intro s t he
  apply DFinsupp.ext
  intro d
  apply Subtype.ext
  apply Subtype.ext
  have hp := congrArg (fun x : ring 𝒜 q ↦ GradedRing.proj 𝒜 (q * d) (x : A)) he
  simpa only [project_recompose 𝒜 q hq] using hp

/-- The retained original groups internally grade their generated subring. -/
@[instance_reducible]
def gradedRing (hq : 0 < q) : GradedRing (grade 𝒜 q) where
  __ := gradeMonoid 𝒜 q
  __ := DirectSum.IsInternal.chooseDecomposition (grade 𝒜 q)
    (show DirectSum.IsInternal (grade 𝒜 q) from
      ⟨recompose_injective 𝒜 q hq, recompose_surjective 𝒜 q⟩)

end FLT.Mazur.RetainedSubringGrading
