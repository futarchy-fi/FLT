module

public import FLT.Mazur.PolygonCompletePointIdentityAffineMarking
public import FLT.Mazur.CartierQuotientAugmentation

/-!
# The actual quotient comparison on the finite affine identity chart

The target parameter and its pullback cut out the two original markings.
Their original augmentations prove that the actual parameter quotient map
is bijective. These are the finite chart inputs for local inversion.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
namespace FLT.Mazur.FCurve
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

/-- A principal pulled marking ideal gives the same equation for the actual augmentation. -/
theorem affineMarking_kernel_of_principal_pullback {T X Y : Scheme}
    [IsAffine X] [IsAffine Y] (j : T ⟶ X) [QuasiCompact j] (u : X ⟶ Y)
    (I : Y.IdealSheafData) (a : Γ(Y, ⊤)) (hj : j.ker = I.comap u)
    (ha : I.ideal ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span {a}) :
    RingHom.ker j.appTop.hom = Ideal.span {u.appTop a} := by
  have he := congrArg (fun J => J.ideal ⟨⊤, isAffineOpen_top X⟩) hj
  rw [Scheme.IdealSheafData.ideal_comap_top, ha, Ideal.map_span, Set.image_singleton] at he
  simpa only [Scheme.Hom.ker_apply] using he

/-- A commuting square preserves regularity of the original pulled section. -/
theorem regular_appTop_of_composite {X Y Z : Scheme} (f : X ⟶ Y) (u : Y ⟶ Z)
    (g : X ⟶ Z) (h : f ≫ u = g) (a : Γ(Z, ⊤)) (ha : IsRegular (g.appTop a)) :
    IsRegular (f.appTop (u.appTop a)) := by
  change IsRegular ((u.appTop ≫ f.appTop) a)
  rw [← Scheme.Hom.comp_appTop, h]
  exact ha

end FLT.Mazur.FCurve

namespace FLT.Mazur.PolygonInfinitesimalStages
open WeierstrassIntegralChart FiniteCartierComparison FCurve
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointIdentityAffineOpen completePointToOrigin completePointOriginOpen
  completePointIdentityAffineSourceMarking completePointIdentityAffineTargetMarking
  completePointWeierstrassCurve

variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (i : Fin n)
local notation "W" => completePointWeierstrassCurve K n h i
local notation "q" => completePointToOrigin K n h i
local notation "U" => completePointIdentityAffineOpen K n h i
local notation "Uₛ" => (q) ⁻¹ᵁ (U)
local notation "mS" => completePointIdentityAffineSourceMarking K n h i
local notation "mT" => completePointIdentityAffineTargetMarking K n h i
/-- The unchanged finite restriction, sealed to retain manageable section-ring expressions. -/
@[irreducible] def completePointIdentityAffineMap : (Uₛ).toScheme ⟶ (U).toScheme :=
  (q) ∣_ (U)

local notation "f" => completePointIdentityAffineMap K n h i

/-- The sealed restriction retains its actual original morphism square. -/
@[reassoc] theorem completePointIdentityAffineMap_inclusion :
    (f) ≫ (U).ι = (Uₛ).ι ≫ (q) := by
  rw [completePointIdentityAffineMap]
  exact morphismRestrict_ι _ _

/-- The original cubic parameter restricted to the finite affine target. -/
def completePointIdentityAffineParameter : Γ((U).toScheme, ⊤) :=
  (U).ι.appTop (originParameterSection (W))

local notation "t" => completePointIdentityAffineParameter K n h i

/-- The target augmentation has the full original parameter ideal as its kernel. -/
theorem completePointIdentityAffineTarget_kernel :
    RingHom.ker (mT).appTop.hom = Ideal.span {(t)} := by
  let _ : IsAffine (U).toScheme := (completePointIdentityAffineOpen_spec K n h i).2.1
  let _ := completePointIdentityAffineTargetMarking_closed K n h i
  exact affineMarking_kernel_of_principal_pullback (mT) (U).ι
    (originNeighborhoodSection (W)).ker (originParameterSection (W))
    (completePointIdentityAffineTargetMarking_ker K n h i)
    (originIdealSheaf_section_equation (W))

/-- The source augmentation has the ideal generated by the original pulled parameter. -/
theorem completePointIdentityAffineSource_kernel :
    RingHom.ker (mS).appTop.hom = Ideal.span {(f).appTop (t)} := by
  let _ : IsAffine (U).toScheme := (completePointIdentityAffineOpen_spec K n h i).2.1
  let _ : IsAffine (Uₛ).toScheme := (completePointIdentityAffineOpen_spec K n h i).2.2.2
  let _ := completePointIdentityAffineTargetMarking_closed K n h i
  let _ := completePointIdentityAffineSourceMarking_closed K n h i
  apply affineMarking_kernel_of_principal_pullback (mS) (f) (mT).ker (t)
  · rw [completePointIdentityAffineMap]
    exact (completePointIdentityAffine_marking_ideal K n h i).symm
  · simpa only [Scheme.Hom.ker_apply] using completePointIdentityAffineTarget_kernel K n h i

/-- The actual section-ring map is finite on the chosen original affine charts. -/
theorem completePointIdentityAffine_ringMap_finite : (f).appTop.hom.Finite := by
  let _ : IsAffine (U).toScheme := (completePointIdentityAffineOpen_spec K n h i).2.1
  have : IsFinite (f) := by
    rw [completePointIdentityAffineMap]
    exact (completePointIdentityAffineOpen_spec K n h i).2.2.1
  exact (f).finite_appTop

/-- The parameter used by the quotient comparison has its proved regular pullback. -/
theorem completePointIdentityAffine_ringMap_parameter_regular :
    IsRegular ((f).appTop (t)) :=
  regular_appTop_of_composite (f) (U).ι ((Uₛ).ι ≫ (q))
    (completePointIdentityAffineMap_inclusion K n h i) (originParameterSection (W))
    (completePointIdentityAffine_parameter_regular K n h i)

/-- The actual original finite-chart parameter quotient map is bijective. -/
theorem completePointIdentityAffine_quotient_bijective :
    let _ := (f).appTop.hom.toAlgebra
    Function.Bijective
      (FiniteCartierComparison.parameterQuotientMap (A := Γ((Uₛ).toScheme, ⊤)) (t)) := by
  let _ := (f).appTop.hom.toAlgebra
  let _ : IsAffine (U).toScheme := (completePointIdentityAffineOpen_spec K n h i).2.1
  let _ := completePointIdentityAffineTargetMarking_closed K n h i
  apply parameterQuotientMap_bijective_of_augmentations (t) (mT).appTop.hom (mS).appTop.hom
  · change ((f).appTop ≫ (mS).appTop).hom = (mT).appTop.hom
    rw [← Scheme.Hom.comp_appTop]
    rw [completePointIdentityAffineTargetMarking, completePointIdentityAffineMap]
  · exact (mT).app_surjective ⊤ (isAffineOpen_top (U).toScheme)
  · exact completePointIdentityAffineTarget_kernel K n h i
  · exact completePointIdentityAffineSource_kernel K n h i

end FLT.Mazur.PolygonInfinitesimalStages
