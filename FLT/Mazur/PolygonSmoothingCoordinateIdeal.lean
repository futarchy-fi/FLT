module

public import FLT.Mazur.PolygonSmoothingSingularSupport
public import FLT.Mazur.PolygonSmoothingBaseChange

/-!
# The coordinate ideal of the arithmetic node model

The ideal generated by both original branch coordinates contains the parameter.
Its quotient is the coefficient ring modulo that parameter, with the original
coefficient map retained. Nonsmooth points contain this explicit ideal.
-/

@[expose] public noncomputable section

namespace FLT.Mazur.PolygonSmoothing

universe u

variable {R : Type u} [CommRing R] (t : R)

/-- The ideal generated by the two original branch coordinates. -/
def coordinateIdeal : Ideal (ChartRing t) := Ideal.span {leftCoordinate t, rightCoordinate t}

/-- The original parameter belongs to the coordinate ideal. -/
theorem parameter_mem_coordinateIdeal : algebraMap R (ChartRing t) t ∈ coordinateIdeal t := by
  rw [← coordinate_relation]
  exact (coordinateIdeal t).mul_mem_right _ (Ideal.subset_span (by simp))

/-- Evaluation at the origin with the actual zero-parameter coefficient quotient. -/
def coordinateZeroEvaluation : ChartRing t →ₐ[R] R ⧸ Ideal.span {t} :=
  evaluate t 0 0 (by
    rw [zero_mul]
    exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))).symm)

/-- The original coordinate ideal is killed by the zero-parameter origin evaluation. -/
theorem coordinateIdeal_le_ker :
    coordinateIdeal t ≤ RingHom.ker (coordinateZeroEvaluation t).toRingHom := by
  rw [coordinateIdeal, Ideal.span_le]
  intro z hz
  rcases hz with rfl | hz
  · change evaluate t 0 0 _ (leftCoordinate t) = 0
    exact evaluate_left t 0 0 _
  · rcases hz with rfl
    change evaluate t 0 0 _ (rightCoordinate t) = 0
    exact evaluate_right t 0 0 _

/-- The origin evaluation descends to the original coordinate quotient. -/
def coordinateQuotientToBase : (ChartRing t ⧸ coordinateIdeal t) →ₐ[R] R ⧸ Ideal.span {t} :=
  Ideal.Quotient.liftₐ _ (coordinateZeroEvaluation t) (coordinateIdeal_le_ker t)

/-- The coefficient map into the coordinate quotient factors through the parameter quotient. -/
def baseToCoordinateQuotient : (R ⧸ Ideal.span {t}) →ₐ[R] ChartRing t ⧸ coordinateIdeal t :=
  Ideal.Quotient.liftₐ _ (Algebra.ofId R _) (by
    change Ideal.span {t} ≤ RingHom.ker (algebraMap R (ChartRing t ⧸ coordinateIdeal t))
    rw [Ideal.span_le, Set.singleton_subset_iff]
    change algebraMap R (ChartRing t ⧸ coordinateIdeal t) t = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (parameter_mem_coordinateIdeal t))

/-- Both maps fix the original coefficient quotient. -/
theorem coordinateQuotientToBase_comp :
    (coordinateQuotientToBase t).comp (baseToCoordinateQuotient t) = AlgHom.id R _ := by
  apply Ideal.Quotient.algHom_ext
  exact Subsingleton.elim _ _

/-- Both maps also fix the original coordinate quotient. -/
theorem baseToCoordinateQuotient_comp :
    (baseToCoordinateQuotient t).comp (coordinateQuotientToBase t) = AlgHom.id R _ := by
  apply Ideal.Quotient.algHom_ext
  refine chartRing_hom_ext (S := ChartRing t ⧸ coordinateIdeal t) t _ _ ?_ ?_
  · change baseToCoordinateQuotient t (coordinateZeroEvaluation t (leftCoordinate t)) =
      Ideal.Quotient.mk _ (leftCoordinate t)
    rw [coordinateZeroEvaluation, evaluate_left, map_zero]
    exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))).symm
  · change baseToCoordinateQuotient t (coordinateZeroEvaluation t (rightCoordinate t)) =
      Ideal.Quotient.mk _ (rightCoordinate t)
    rw [coordinateZeroEvaluation, evaluate_right, map_zero]
    exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))).symm

/-- Killing the original two coordinates gives exactly the original zero-parameter base. -/
def coordinateQuotientEquiv : (ChartRing t ⧸ coordinateIdeal t) ≃ₐ[R] R ⧸ Ideal.span {t} :=
  AlgEquiv.ofAlgHom (coordinateQuotientToBase t) (baseToCoordinateQuotient t)
    (coordinateQuotientToBase_comp t) (baseToCoordinateQuotient_comp t)

/-- Every nonsmooth point contains the explicit coordinate ideal. -/
theorem coordinateIdeal_le_of_not_smooth (x : chart R t)
    (hx : x ∉ (chartStructure R t).smoothLocus) : coordinateIdeal t ≤ x.asIdeal := by
  rw [coordinateIdeal, Ideal.span_le]
  intro z hz
  rcases hz with rfl | hz
  · exact (coordinates_mem_of_not_smooth R t x hx).1
  · rcases hz with rfl
    exact (coordinates_mem_of_not_smooth R t x hx).2

/-- The explicit coordinate ideal is exactly the kernel of origin evaluation. -/
theorem coordinateZeroEvaluation_ker :
    RingHom.ker (coordinateZeroEvaluation t).toRingHom = coordinateIdeal t := by
  apply le_antisymm _ (coordinateIdeal_le_ker t)
  intro x hx
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  apply (coordinateQuotientEquiv t).injective
  change coordinateZeroEvaluation t x = coordinateQuotientEquiv t 0
  rw [map_zero]
  exact hx

/-- Arbitrary coefficient extension preserves the original coordinate ideal exactly. -/
theorem coordinateIdeal_map (S : Type u) [CommRing S] [Algebra R S] :
    Ideal.map (coefficientMap R S t) (coordinateIdeal t) =
      coordinateIdeal (algebraMap R S t) := by
  simp only [coordinateIdeal, Ideal.map_span, Set.image_insert_eq, Set.image_singleton,
    coefficientMap_left, coefficientMap_right]

end FLT.Mazur.PolygonSmoothing
