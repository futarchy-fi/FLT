module

public import FLT.Mazur.AdicExtensionProjection
public import FLT.Mazur.AdicIdealCompletionRange

/-!
# The kernel of a completed presentation

Exactness of completion identifies the actual completed presentation kernel
with the extension of the original relation ideal. Consequently a square-zero
presentation kernel remains square-zero after completing the presentation.
-/

@[expose] public noncomputable section

namespace FLT.Mazur.AdicExtensionProjection

universe u

set_option backward.isDefEq.respectTransparency false

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]
  (P : Algebra.Extension.{u} R A) (I : Ideal A)

/-- The ring projection and the module completion map have exactly the same zero fiber. -/
theorem projection_eq_zero_iff (x : AdicCompletion (ideal P I) P.Ring) :
    projection P I x = 0 ↔
      AdicCompletion.map (ideal P I) (Algebra.linearMap P.Ring A) x = 0 := by
  change idealEquiv (R := R) (ideal_map P I)
    (AdicCompletionScalars.equivalence (ideal P I)
      (AdicCompletion.map (ideal P I) (Algebra.linearMap P.Ring A) x)) = 0 ↔ _
  rw [map_eq_zero_iff _ (idealEquiv (R := R) (ideal_map P I)).injective,
    map_eq_zero_iff _ (AdicCompletionScalars.equivalence (ideal P I)).injective]

variable [IsNoetherianRing P.Ring]

/-- The completed projection kernel is generated by the original presentation equations. -/
theorem ker_projection : RingHom.ker (projection P I).toRingHom =
    P.ker.map (algebraMap P.Ring (AdicCompletion (ideal P I) P.Ring)) := by
  let _ : Module.Finite P.Ring A := Module.Finite.of_surjective
    (Algebra.linearMap P.Ring A) P.algebraMap_surjective
  have he := AdicCompletion.map_exact (I := ideal P I)
    (f := P.ker.subtype) (g := Algebra.linearMap P.Ring A)
    (Submodule.injective_subtype _) (Algebra.linearMap P.Ring A).exact_subtype_ker_map
    P.algebraMap_surjective
  ext x
  change projection P I x = 0 ↔ _
  rw [projection_eq_zero_iff, he]
  change x ∈ LinearMap.range (AdicCompletion.map (ideal P I) P.ker.subtype) ↔ _
  rw [AdicIdealCompletionRange.range_map_subtype]

/-- Completion preserves the square-zero kernel of an infinitesimal presentation. -/
theorem ker_projection_square_zero (h : P.ker ^ 2 = ⊥) :
    (RingHom.ker (projection P I).toRingHom) ^ 2 = ⊥ := by
  rw [ker_projection, ← Ideal.map_pow, h, Ideal.map_bot]

end FLT.Mazur.AdicExtensionProjection
