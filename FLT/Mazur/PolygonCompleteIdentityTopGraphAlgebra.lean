module

public import FLT.Mazur.PolygonCompleteIdentityTopActionRestriction
public import FLT.Mazur.PolygonTopNodeGraphAlgebra

/-!
# The actual finite graph of every original top-order action

These algebras use the unchanged original multiplication unit and its
reciprocal. The preceding-law hypothesis proves their finite three-term
normal form and parameter descent. Their geometric flatness is not assumed
in the construction and remains to be established separately.
-/

@[expose] public noncomputable section
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing LaurentPolynomial LaurentStageParameter PolygonScalingNaturality
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] PolygonSmoothing.relationIdeal
  completeIdentityTopActionUnit completeIdentityTopActionField
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (i : Fin n) (m : ℕ)
local notation "R" => K[T;T⁻¹]
local notation "S" => Ring (R) (m + 1)
local notation "e" => parameter (R) (m + 1)
local notation "L" => (S)[T;T⁻¹]
local notation "B" => ChartRing (e)
local notation "C" => stageNodeBranchSubalgebra (R) (m + 1)
local notation "U" => completeIdentityTopActionUnit K n h i m
local notation "V" => completeIdentityTopActionReciprocalUnit K n h i m
local notation "a" => parameterUnit K (m + 1)
local notation "β" => stageNodeBranchPair (R) (m + 1)
local notation "σ" => reciprocalScale (e) (a)

/-- The original full branch action minus its prescribed full node scaling. -/
def completeIdentityTopActionNodeDefect : (B) →ₗ[S] ((L) × (L)) :=
  topNodeActionDefect (R) m (U) (V) (a)

/-- The graph generated by the source node and its unchanged original action image. -/
def completeIdentityTopGraphAlgebra : Subalgebra (S) ((L) × (L)) :=
  topNodeGraphAlgebra (R) m (U) (V)

/-- The two actual coordinate defects adjoined over the unchanged source node. -/
def completeIdentityTopErrorAlgebra : Subalgebra (C) ((L) × (L)) :=
  topNodeErrorAlgebra (R) m (U) (V) (a)

local notation "D" => completeIdentityTopActionNodeDefect K n h i m
local notation "E" => completeIdentityTopErrorAlgebra K n h i m
local notation "G" => completeIdentityTopGraphAlgebra K n h i m
variable (hm : completeIdentityFiniteMulDefect K n h i m = 0)
include hm

/-- Every actual original defect is annihilated by the original smoothing parameter. -/
theorem completeIdentityTopActionNodeDefect_parameter (z : B) : (e) • (D) z = 0 :=
  topNodeActionDefect_parameter (R) m (U) (V) (a)
    (completeIdentityTopActionUnit_restriction K n h i m hm)
    (completeIdentityTopActionReciprocalUnit_restriction K n h i m hm) z

/-- Products of the actual full defects vanish, without discarding any nilpotents. -/
theorem completeIdentityTopActionNodeDefect_mul_zero (z w : B) : (D) z * (D) w = 0 :=
  topNodeActionDefect_mul_zero (R) m (U) (V) (a)
    (completeIdentityTopActionUnit_restriction K n h i m hm)
    (completeIdentityTopActionReciprocalUnit_restriction K n h i m hm) z w

/-- The actual full defect obeys the product rule relative to the original scaling. -/
theorem completeIdentityTopActionNodeDefect_mul (z w : B) :
    (D) (z * w) = (D) z * (β) ((σ) w) + (D) w * (β) ((σ) z) :=
  topNodeActionDefect_mul (R) m (U) (V) (a)
    (completeIdentityTopActionUnit_restriction K n h i m hm)
    (completeIdentityTopActionReciprocalUnit_restriction K n h i m hm) z w

/-- The actual two-error algebra is finite over the original node. -/
theorem completeIdentityTopErrorAlgebra_finite : Module.Finite (C) (E) :=
  topNodeErrorAlgebra_finite (R) m (U) (V) (a)
    (completeIdentityTopActionUnit_restriction K n h i m hm)
    (completeIdentityTopActionReciprocalUnit_restriction K n h i m hm)

/-- Its three original-node coefficients give every full graph function exactly. -/
theorem completeIdentityTopErrorAlgebra_normalForm (z : (L) × (L)) (hz : z ∈ (E)) :
    ∃ b c d : C, z = b.val + c.val * (D) (leftCoordinate (e)) +
      d.val * (D) (rightCoordinate (e)) :=
  topNodeErrorAlgebra_normalForm (R) m (U) (V) (a)
    (completeIdentityTopActionUnit_restriction K n h i m hm)
    (completeIdentityTopActionReciprocalUnit_restriction K n h i m hm) z hz

/-- The error algebra is exactly the unchanged source-target graph. -/
theorem completeIdentityTopErrorAlgebra_eq_graph : (E).restrictScalars (S) = (G) :=
  topNodeErrorAlgebra_eq_graph (R) m (U) (V) (a)
    (completeIdentityTopActionUnit_restriction K n h i m hm)
    (completeIdentityTopActionReciprocalUnit_restriction K n h i m hm)

/-- Parameter multiplication of every actual graph function descends unconditionally. -/
theorem completeIdentityTopGraphAlgebra_parameter (z : (L) × (L)) (hz : z ∈ (G)) :
    (e) • z ∈ (C) :=
  topNodeGraphAlgebra_parameter (R) m (U) (V) (a)
    (completeIdentityTopActionUnit_restriction K n h i m hm)
    (completeIdentityTopActionReciprocalUnit_restriction K n h i m hm) z hz

end FLT.Mazur.PolygonInfinitesimalStages
