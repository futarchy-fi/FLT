module

public import FLT.Mazur.PolygonSmoothingRingMap
public import FLT.Mazur.PolygonSmoothingFlat
public import FLT.Mazur.PolygonStageFlatLayer
public import FLT.Mazur.PolygonStageTopScalar

/-!
# Exact restriction and top annihilator on every original smoothing node

Adjacent restriction has the actual top-power parameter kernel. Flatness
identifies its annihilator with reduction to the unchanged split node,
without discarding any base nilpotents or replacing any defining ideal.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.PolygonInfinitesimalStages
set_option backward.isDefEq.respectTransparency false
open PolygonSmoothing
variable (R : Type) [CommRing R] (m : ℕ)
local notation "S" => Ring R (m + 1)
local notation "e" => parameter R (m + 1)
local notation "B" => ChartRing (e)

/-- Reduction of the actual positive-stage smoothing chart to its original split node. -/
def topNodeReduction : (B) →+* ChartRing (0 : R) :=
  ringMap (reduction R (m + 1)).toRingHom (e) 0 (reduction_parameter R (m + 1))

@[simp] theorem topNodeReduction_left :
    topNodeReduction R m (leftCoordinate (e)) = leftCoordinate (0 : R) := ringMap_left ..

@[simp] theorem topNodeReduction_right :
    topNodeReduction R m (rightCoordinate (e)) = rightCoordinate (0 : R) := ringMap_right ..

/-- Every original node function lifts to the upper smoothing chart. -/
theorem topNodeReduction_surjective : Function.Surjective (topNodeReduction R m) :=
  ringMap_surjective _ _ _ _ (reduction_surjective R (m + 1))

/-- The closed coefficient kernel is the ideal generated by the actual parameter. -/
theorem topReduction_ker :
    RingHom.ker (reduction R (m + 1)).toRingHom = Ideal.span {e} := by
  ext z
  change reduction R (m + 1) z = 0 ↔ z ∈ Ideal.span {e}
  rw [reduction_eq_zero_iff, Ideal.mem_span_singleton]
  exact ⟨fun ⟨w, hw⟩ ↦ ⟨w, hw.symm⟩, fun ⟨w, hw⟩ ↦ ⟨w, hw.symm⟩⟩

/-- The node kernel is exactly the extended coefficient ideal. -/
theorem topNodeReduction_ker :
    RingHom.ker (topNodeReduction R m) =
      Ideal.span {algebraMap (S) (B) (e)} := by
  rw [topNodeReduction, ringMap_ker _ _ _ _ (reduction_surjective R (m + 1)),
    topReduction_ker, Ideal.map_span, Set.image_singleton]

/-- Vanishing after reduction supplies an actual parameter multiple in the original chart. -/
theorem topNodeReduction_zero_iff (z : B) :
    topNodeReduction R m z = 0 ↔ ∃ a : B, (e) • a = z := by
  rw [← RingHom.mem_ker, topNodeReduction_ker, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨a, ha⟩
    exact ⟨a, (Algebra.smul_def (e) a).trans ha.symm⟩
  · rintro ⟨a, ha⟩
    exact ⟨a, ha.symm.trans (Algebra.smul_def (e) a)⟩

/-- Flatness identifies the top-power annihilator with original closed-fiber reduction. -/
theorem topNode_parameter_annihilator (z : B) :
    (e) ^ (m + 1) • z = 0 ↔ topNodeReduction R m z = 0 := by
  rw [flat_last_smul_eq_zero_iff R m, topNodeReduction_zero_iff]

/-- The top parameter power squares to zero inside the actual node ring. -/
theorem topNode_parameter_sq : (algebraMap (S) (B) (e) ^ (m + 1)) ^ 2 = 0 :=
  parameter_top_weight_sq R m (B)

/-- Adjacent restriction keeps the actual equation and both original node coordinates. -/
def topNodeRestriction : (B) →+* ChartRing (parameter R m) :=
  ringMap (restriction R m).toRingHom (e) (parameter R m) (restriction_parameter R m)

@[simp] theorem topNodeRestriction_left :
    topNodeRestriction R m (leftCoordinate (e)) = leftCoordinate (parameter R m) :=
  ringMap_left ..

@[simp] theorem topNodeRestriction_right :
    topNodeRestriction R m (rightCoordinate (e)) = rightCoordinate (parameter R m) :=
  ringMap_right ..

/-- Every node function at the preceding stage has an actual lift. -/
theorem topNodeRestriction_surjective : Function.Surjective (topNodeRestriction R m) :=
  ringMap_surjective _ _ _ _ (restriction_surjective R m)

/-- Adjacent restriction has exactly the top parameter-power ideal as kernel. -/
theorem topNodeRestriction_ker : RingHom.ker (topNodeRestriction R m) =
    Ideal.span {algebraMap (S) (B) ((e) ^ (m + 1))} := by
  have hk : RingHom.ker (restriction R m).toRingHom = Ideal.span {(e) ^ (m + 1)} := by
    ext z
    rw [RingHom.mem_ker, Ideal.mem_span_singleton]
    exact (restriction_eq_zero_iff R m z).trans (exists_congr fun _ ↦ eq_comm)
  rw [topNodeRestriction, ringMap_ker _ _ _ _ (restriction_surjective R m),
    hk, Ideal.map_span, Set.image_singleton]

/-- A vanished adjacent-stage function has an actual division by the top parameter power. -/
theorem topNodeRestriction_zero_iff (z : B) :
    topNodeRestriction R m z = 0 ↔ ∃ a : B, (e) ^ (m + 1) • a = z := by
  rw [← RingHom.mem_ker, topNodeRestriction_ker, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨a, ha⟩
    exact ⟨a, (Algebra.smul_def ((e) ^ (m + 1)) a).trans ha.symm⟩
  · rintro ⟨a, ha⟩
    exact ⟨a, ha.symm.trans (Algebra.smul_def ((e) ^ (m + 1)) a)⟩

end FLT.Mazur.PolygonInfinitesimalStages
