module

public import FLT.Mazur.HomogeneousCochainCorrection
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# Original scalars annihilating a genuine correction class

The cyclic submodule generated by one error class is finite even when the
full correction cokernel is not. Its annihilator records simultaneous
homogeneous cochain corrections with one scalar at every order.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.HomogeneousCochainCorrection
variable {R : Type*} [CommRing R] {ι : Type*}
  {A : ι → Type*} {B : ι → ι → Type*}
  [∀ i, CommRing (A i)] [∀ i j, CommRing (B i j)]
  [∀ i, Algebra R (A i)] [∀ i j, Algebra R (B i j)]
  (p : ∀ i j, A i →ₐ[R] B i j) (q : ∀ i j, A j →ₐ[R] B i j)
  (I : ∀ i, Ideal (A i))

/-- Scalar multiplication is applied before taking the full correction class. -/
theorem obstruction_smul (s : R) (v : ∀ i, A i) :
    obstruction p q I (s • v) = s • obstruction p q I v := by
  simp only [obstruction, map_smul]

/-- The exact scalar ideal of the distinguished class in the true correction cokernel. -/
def scalarIdeal (v : ∀ i, A i) : Ideal R :=
  LinearMap.ker (LinearMap.toSpanSingleton R _ (obstruction p q I v))

/-- Membership means annihilation of the actual class, rather than pairwise extendability. -/
theorem mem_scalarIdeal (v : ∀ i, A i) (s : R) :
    s ∈ scalarIdeal p q I v ↔ s • obstruction p q I v = 0 := Iff.rfl

/-- A scalar kills the class exactly when full homogeneous chart corrections exist. -/
theorem mem_scalarIdeal_iff_corrections (v : ∀ i, A i) (s : R) :
    s ∈ scalarIdeal p q I v ↔
      ∃ h : ∀ i, A i, (∀ i, h i ∈ I i) ∧
        ∀ i j, p i j (s • v i - h i) = q i j (s • v j - h j) := by
  rw [mem_scalarIdeal, ← obstruction_smul, obstruction_eq_zero_iff]
  rfl

/-- The actual class generates a finite submodule of the full correction cokernel. -/
theorem obstruction_span_finite (v : ∀ i, A i) :
    Module.Finite R (Submodule.span R {obstruction p q I v}) := inferInstance

/-- The exact scalar quotient is finite; this does not assert full cokernel finiteness. -/
theorem scalarQuotient_finite (v : ∀ i, A i) :
    Module.Finite R (R ⧸ scalarIdeal p q I v) := inferInstance

/-- Every choice of the same boundary lifts gives exactly the same scalar ideal. -/
theorem scalarIdeal_eq_of_sub_mem (v w : ∀ i, A i) (h : ∀ i, v i - w i ∈ I i) :
    scalarIdeal p q I v = scalarIdeal p q I w := by
  unfold scalarIdeal
  rw [obstruction_eq_of_sub_mem p q I v w h]

/-- One radical witness is a single exponent for the entire compatible cochain. -/
theorem mem_radical_scalarIdeal (v : ∀ i, A i) (s : R) :
    s ∈ (scalarIdeal p q I v).radical ↔
      ∃ (N : ℕ) (h : ∀ i, A i), (∀ i, h i ∈ I i) ∧
        ∀ i j, p i j (s ^ N • v i - h i) = q i j (s ^ N • v j - h j) := by
  simp only [Ideal.mem_radical_iff, mem_scalarIdeal_iff_corrections]

end FLT.Mazur.HomogeneousCochainCorrection
