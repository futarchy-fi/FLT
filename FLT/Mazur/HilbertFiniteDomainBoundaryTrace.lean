module

public import FLT.Mazur.InvariantFiniteDomainTrace
public import FLT.Mazur.HilbertFiniteLocusScalarCoordinates

/-!
# Actual Hilbert boundary trace multipliers on finite domains

The finite projective geometry of the full original relation constructs
invariant traces. Each trace lifts its multiple of every original boundary
invariant, without a global basis, supplied equations, or division by a degree.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry Opposite
namespace FLT.Mazur.HilbertChart.AffineRestriction
open CartierAbel SchemePicard FCurve RelativeRelationOrbit InvariantOpenRelationDiagram
open SchemeOpenEnvelope
set_option backward.isDefEq.respectTransparency true
set_option backward.defeqAttrib.useBackward true
variable {R : Type} [CommRing R] [Algebra.FiniteType ℤ R] {X : Scheme}
  (f : X ⟶ Spec (.of R)) [IsProper f] [Flat f] [GeometricallyIntegral f]
  [SmoothOfRelativeDimension 1 f] {L : X.Modules} (hL : AmpleLineBundle L)
  (d : ℕ) (V : Over (Spec (.of R))) [Etale V.hom]
  (c : (relativeFppfSheaf f).obj.obj (op V))
  {A : Over (Spec (.of R))} [IsAffine A.left]
  (k : A ⟶ variableHilbertTest f d V) [IsOpenImmersion k.left]
local notation "p" => fst f hL d V c k
local notation "eo" => equivalence f hL d V c k
variable (W : TopologicalSpace.Opens (Orbit (equivalence f hL d V c k)))
set_option quotPrecheck false
local notation "E" => (pullOpen eo W).val
local notation "Ω" => (invariantSheaf eo).obj.obj (op W)
local notation "ec" => originalClosedEquivalence f hL d V c k
local notation "m" => originalClosedInvariantMap f hL d V c k
local notation "Wc" => (TopologicalSpace.Opens.map (m).base).obj W
local notation "D" => (invariantSheaf ec).obj.obj (op Wc)
local notation "ρ" => originalClosedSectionPullback f hL d V c k W
attribute [local irreducible] relation fst snd equivalence invariantSheaf
  originalClosedEquivalence originalClosedInvariantMap originalClosedSectionPullback
variable (hW : IsAffineOpen (pullOpen (equivalence f hL d V c k) W).val)
  (hfin : (pullOpen (equivalence f hL d V c k) W).val ≤
    finiteTargetOpen (fst f hL d V c k).left)

/-- The geometric trace lives in the original orbit-open scalar ring. -/
def originalFiniteDomainTrace (a : Γ((source E).left, ⊤)) : Ω :=
  finiteDomainTrace eo W (fullRelationSchemeEquivalence f hL d V c k) hW hfin a

/-- Every constructed trace multiplies every original boundary invariant into the true image. -/
theorem originalFiniteDomainTrace_mem_sectionLiftIdeal
    (t : D) (a : Γ((source E).left, ⊤)) :
    originalFiniteDomainTrace f hL d V c k W hW hfin a ∈ sectionLiftIdeal ρ t := by
  unfold originalClosedInvariantMap at t
  unfold originalClosedSectionPullback invariantSectionPullback
  unfold originalClosedInvariantMap
  exact finiteDomainTrace_mem_sectionLiftIdeal eo W
    (fullRelationSchemeEquivalence f hL d V c k) hW hfin ec
    (originalBoundarySourceMap f hL d V c k) (originalClosedArrow f hL d V c k)
    (originalClosedArrow_fst f hL d V c k) (originalClosedArrow_snd f hL d V c k)
    (originalClosedFst_isPullback f hL d V c k) t a

/-- The actual invariant ideal generated by all full original relation traces. -/
def originalFiniteDomainTraceIdeal : Ideal Ω :=
  Ideal.span (Set.range (originalFiniteDomainTrace f hL d V c k W hW hfin))

/-- Every element of this constructed ideal is a simultaneous boundary lifting multiplier. -/
theorem originalFiniteDomainTraceIdeal_le (t : D) :
    originalFiniteDomainTraceIdeal f hL d V c k W hW hfin ≤ sectionLiftIdeal ρ t := by
  apply Ideal.span_le.mpr
  rintro _ ⟨a, rfl⟩
  exact originalFiniteDomainTrace_mem_sectionLiftIdeal f hL d V c k W hW hfin t a

/-- A unit trace ideal supplies surjectivity of the exact original boundary section map. -/
theorem originalClosedSectionPullback_surjective_of_traceIdeal
    (h : originalFiniteDomainTraceIdeal f hL d V c k W hW hfin = ⊤) :
    Function.Surjective ρ := by
  intro t
  apply (sectionLiftIdeal_eq_top_iff ρ t).mp
  apply top_unique
  rw [← h]
  exact originalFiniteDomainTraceIdeal_le f hL d V c k W hW hfin t

end FLT.Mazur.HilbertChart.AffineRestriction
