module

public import FLT.Mazur.PolygonCompleteIdentityFiniteReduction
public import FLT.Mazur.LaurentCoefficientDivisibility

/-!
# The original multiplication error is divisible by the smoothing parameter

The actual coefficient reduction kernel is generated by q. This remains true
in the double Laurent algebra, giving a factorization of the entire original
multiplication error and the uniform nilpotence bound m + 1.
-/

@[expose] public noncomputable section
open scoped Polynomial LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open LaurentPolynomial PolygonScalingNaturality
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointWeierstrassCurve completePointToIntegralCubic originalStageToCompatibleProj

/-- The actual coefficient reduction kernel is generated by the specified smoothing parameter. -/
theorem parameter_dvd_of_reduction_eq_zero {R : Type*} [CommRing R] (m : ℕ)
    (a : Ring R m) (ha : reduction R m a = 0) : parameter R m ∣ a := by
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective a
  rw [reduction_mk] at ha
  obtain ⟨q, rfl⟩ := Polynomial.X_dvd_iff.mpr ha
  refine ⟨AdjoinRoot.mk _ q, ?_⟩
  rw [map_mul]
  rfl

variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (i : Fin n) (m : ℕ)

/-- The entire original multiplication error has a smoothing-parameter factor. -/
theorem completeIdentityFiniteMulDefect_parameter_dvd :
    C (C (parameter K m)) ∣ completeIdentityFiniteMulDefect K n h i m := by
  apply LaurentCoefficientDivisibility.doubleCoeffMap_kernel_dvd
    (reduction K m).toRingHom (parameter K m)
  · intro a ha
    exact parameter_dvd_of_reduction_eq_zero m a ha
  · exact completeIdentityFiniteMulDefect_reduction K n h i m

/-- The full original Laurent error, not merely each coefficient, has nilpotence bound m + 1. -/
theorem completeIdentityFiniteMulDefect_pow :
    completeIdentityFiniteMulDefect K n h i m ^ (m + 1) = 0 := by
  obtain ⟨q, hq⟩ := completeIdentityFiniteMulDefect_parameter_dvd K n h i m
  rw [hq, mul_pow, ← map_pow, ← map_pow, parameter_pow, map_zero, map_zero, zero_mul]

end FLT.Mazur.PolygonInfinitesimalStages
