module

public import FLT.Mazur.VariableHilbertWholeOrbitRefinement
public import FLT.Mazur.RelativeRelationSaturationCover

/-!
# Compatible full-relation neighborhoods generated by affine Hilbert opens

Within every invariant neighborhood, a whole-orbit affine refinement generates
an invariant saturated open. The invariant neighborhood has a compact quotient
image and a surjective etale cover by the original relation domain. The affine
refinement itself is not asserted to be invariant or the saturation affine.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry Opposite
namespace FLT.Mazur.HilbertChart
open CartierAbel SchemePicard FCurve RelativeRelationOrbit
set_option backward.isDefEq.respectTransparency false
variable {R : Type} [CommRing R] [Algebra.FiniteType ℤ R] {X : Scheme}
  (f : X ⟶ Spec (.of R)) [IsProper f] [Flat f] [GeometricallyIntegral f]
  [SmoothOfRelativeDimension 1 f] {L : X.Modules} (hL : AmpleLineBundle L)
  (d : ℕ) (V : Over (Spec (.of R))) [IsAffine V.left] [Etale V.hom]
  (c : (relativeFppfSheaf f).obj.obj (op V))
local notation "e" => variableChartEquivalenceRelation f hL d V c
local notation "p" => variableChartRelationFst f hL d V c
local notation "q" => variableChartRelationSnd f hL d V c

/-- Saturation using both endpoints of the original full translated chart relation. -/
def variableHilbertSaturation (W : (variableHilbertTest f d V).left.Opens) :
    InvariantOpens p q := saturateOpen e (q).left.isOpenMap W

/-- Saturation preserves refinement inside any original invariant neighborhood. -/
theorem exists_variableHilbert_saturated_affine_refinement
    (B : InvariantOpens p q) (x : (variableHilbertTest f d V).left) (hx : x ∈ B.val) :
    ∃ (U : X.affineOpens) (W : (variableHilbertTest f d V).left.Opens),
      IsAffineOpen W ∧
      {y | projection e y = projection e x} ⊆ W ∧
      W ≤ commonAmbientSourceOpen f d V U ∧
      (variableHilbertSaturation f hL d V c W).val ≤ B.val := by
  have hB : {y | projection e y = projection e x} ⊆ B.val := by
    intro y hy
    exact (invariant_mem_iff B ((projection_eq_iff e y x).mp hy)).mpr hx
  obtain ⟨U, W, hW, htW, hWB, hWU⟩ :=
    exists_variableHilbert_finite_affine_refinement f d V hL _
      (variableChartOrbit_finite f d V c hL x) B.val hB
  exact ⟨U, W, hW, htW, hWU, (saturateOpen_le_iff e (q).left.isOpenMap W B).mpr hWB⟩

/-- Common saturated refinements preserve every point of the original orbit. -/
theorem exists_variableHilbert_saturated_inter_refinement
    (B C : InvariantOpens p q) (x : (variableHilbertTest f d V).left)
    (hB : x ∈ B.val) (hC : x ∈ C.val) :
    ∃ (U : X.affineOpens) (W : (variableHilbertTest f d V).left.Opens),
      IsAffineOpen W ∧ {y | projection e y = projection e x} ⊆ W ∧
      W ≤ commonAmbientSourceOpen f d V U ∧
      (variableHilbertSaturation f hL d V c W).val ≤ B.val ⊓ C.val := by
  let D : InvariantOpens p q := ⟨B.val ⊓ C.val, by
    ext a
    exact and_congr (Set.ext_iff.mp (congrArg SetLike.coe B.property) a)
      (Set.ext_iff.mp (congrArg SetLike.coe C.property) a)⟩
  exact exists_variableHilbert_saturated_affine_refinement f hL d V c D x ⟨hB, hC⟩

omit [IsAffine V.left] in
/-- Every constructed saturation has exactly equal original endpoint domains. -/
theorem variableHilbertSaturation_invariant (W : (variableHilbertTest f d V).left.Opens) :
    (p).left ⁻¹ᵁ (variableHilbertSaturation f hL d V c W).val =
      (q).left ⁻¹ᵁ (variableHilbertSaturation f hL d V c W).val :=
  (variableHilbertSaturation f hL d V c W).property

end FLT.Mazur.HilbertChart
