module

public import FLT.Mazur.LaurentCoefficientEvaluation

/-!
# Constant divisibility in Laurent polynomials

Divisibility by a constant can be tested on each coefficient. A principal
coefficient kernel therefore remains principal after adjoining Laurent variables.
-/

@[expose] public noncomputable section
open scoped LaurentPolynomial
namespace FLT.Mazur.LaurentCoefficientDivisibility
open LaurentPolynomial PolygonScalingNaturality LaurentCoefficientEvaluation
variable {R S : Type*} [CommRing R] [CommRing S]

/-- Divisibility of every coefficient assembles to divisibility of the full Laurent polynomial. -/
theorem C_dvd_of_coeff (r : R) (p : R[T;T⁻¹]) (h : ∀ d, r ∣ p.coeff d) :
    C r ∣ p := by
  classical
  rw [← p.sum_coeff_single]
  apply Finset.dvd_sum
  intro d _
  obtain ⟨b, hb⟩ := h d
  refine ⟨C b * T d, ?_⟩
  rw [single_eq_C_mul_T, hb, map_mul, mul_assoc]

/-- Constant divisibility is equivalent to divisibility of all Laurent coefficients. -/
theorem C_dvd_iff (r : R) (p : R[T;T⁻¹]) : C r ∣ p ↔ ∀ d, r ∣ p.coeff d := by
  refine ⟨?_, C_dvd_of_coeff r p⟩
  rintro ⟨q, rfl⟩ d
  refine ⟨q.coeff d, ?_⟩
  rw [← smul_eq_C_mul, AddMonoidAlgebra.coeff_smul_apply, smul_eq_mul]

/-- A coefficient kernel generated by r stays generated by C r in the Laurent algebra. -/
theorem coeffMap_kernel_dvd (f : R →+* S) (r : R)
    (h : ∀ a, f a = 0 → r ∣ a) (p : R[T;T⁻¹]) (hp : coeffMap f p = 0) :
    C r ∣ p := by
  apply C_dvd_of_coeff
  intro d
  apply h
  have he := congrArg (fun q : S[T;T⁻¹] ↦ q.coeff d) hp
  simpa only [coeffMap_coeff, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply] using he

/-- The same principal-kernel statement retains both independent Laurent coordinates. -/
theorem doubleCoeffMap_kernel_dvd (f : R →+* S) (r : R)
    (h : ∀ a, f a = 0 → r ∣ a) (p : R[T;T⁻¹][T;T⁻¹])
    (hp : coeffMap (coeffMap f) p = 0) : C (C r) ∣ p :=
  coeffMap_kernel_dvd (coeffMap f) (C r) (coeffMap_kernel_dvd f r h) p hp

end FLT.Mazur.LaurentCoefficientDivisibility
