module

public import FLT.Mazur.PolygonSmoothingScalingNaturality

/-!
# Two coordinate differences generate every difference of node maps

For maps preserving the same original coefficients, equality after killing
the two coordinate differences follows from the presentation xy=t.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.PolygonSmoothing
universe u
variable {R S : Type u} [CommRing R] [CommRing S] (t : R)
variable (f g : ChartRing t →+* S)

/-- All differences of coefficient-compatible node maps are generated by two original errors. -/
theorem differenceIdeal_twoCoordinates
    (hc : ∀ r, f (algebraMap R (ChartRing t) r) = g (algebraMap R (ChartRing t) r)) :
    Ideal.span (Set.range (fun z ↦ f z - g z)) =
      Ideal.span {f (leftCoordinate t) - g (leftCoordinate t),
        f (rightCoordinate t) - g (rightCoordinate t)} := by
  let J := Ideal.span {f (leftCoordinate t) - g (leftCoordinate t),
    f (rightCoordinate t) - g (rightCoordinate t)}
  let q := Ideal.Quotient.mk J
  have he : q.comp f = q.comp g := by
    apply chartRing_ringHom_ext
    · intro r
      exact congrArg q (hc r)
    · exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_insert _ _))
    · exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨z, rfl⟩
    apply Ideal.Quotient.eq.mp
    exact congrArg (fun k : ChartRing t →+* S ⧸ J ↦ k z) he
  · apply Ideal.span_le.mpr
    intro z hz
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · exact Ideal.subset_span ⟨leftCoordinate t, rfl⟩
    · rw [Set.mem_singleton_iff] at hz
      subst z
      exact Ideal.subset_span ⟨rightCoordinate t, rfl⟩

end FLT.Mazur.PolygonSmoothing
