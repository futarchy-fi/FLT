module

public import FLT.Mazur.PolygonArithmeticRestrictionKernel
public import FLT.Mazur.LaurentCoefficientDivisibility

/-!
# Nonconsecutive arithmetic restrictions and their exact Laurent kernels

The restriction from order m to order k has kernel generated by pi^(k+1).
Coefficientwise detection retains every Laurent exponent and assembles the
full error into a single divisible Laurent polynomial.
-/

@[expose] public noncomputable section
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonArithmeticStages
open LaurentPolynomial PolygonScalingNaturality LaurentCoefficientEvaluation
set_option backward.isDefEq.respectTransparency false
variable (R : Type*) [CommRing R] (π : R)

/-- The original integral quotient map between any two ordered arithmetic stages. -/
def restrictionLE {k m : ℕ} (h : k ≤ m) : Quotient R π m →ₐ[R] Quotient R π k :=
  Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right (Nat.add_le_add_right h 1))

/-- Nonconsecutive restriction preserves original integral representatives. -/
@[simp] theorem restrictionLE_mk {k m : ℕ} (h : k ≤ m) (a : R) :
    restrictionLE R π h (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ a := rfl

/-- Restriction to the same stage is the identity. -/
theorem restrictionLE_refl (m : ℕ) : restrictionLE R π (le_refl m) = AlgHom.id R _ := by
  ext z
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
  rfl

/-- Arbitrary restrictions compose through the original adjacent quotient. -/
theorem restrictionLE_succ {k m : ℕ} (h : k ≤ m) :
    restrictionLE R π (Nat.le_trans h (Nat.le_succ m)) =
      (restrictionLE R π h).comp (restriction R π m) := by
  ext z
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
  rfl

/-- The original parameter survives every nonconsecutive restriction. -/
@[simp] theorem restrictionLE_parameter {k m : ℕ} (h : k ≤ m) :
    restrictionLE R π h (parameter R π m) = parameter R π k :=
  (restrictionLE R π h).commutes π

/-- The exact coefficient kernel is the indicated power of the original parameter. -/
theorem restrictionLE_eq_zero_iff {k m : ℕ} (h : k ≤ m) (z : Quotient R π m) :
    restrictionLE R π h z = 0 ↔ parameter R π m ^ (k + 1) ∣ z := by
  constructor
  · obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [restrictionLE_mk, Ideal.Quotient.eq_zero_iff_mem]
    change a ∈ Ideal.span {π} ^ (k + 1) → _
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    rintro ⟨b, rfl⟩
    exact ⟨Ideal.Quotient.mk _ b, by rw [map_mul, map_pow]; rfl⟩
  · rintro ⟨w, rfl⟩
    rw [map_mul, map_pow, restrictionLE_parameter, parameter_pow, zero_mul]

/-- Every coefficient of a vanishing full Laurent polynomial lies in the exact kernel. -/
theorem restrictionLE_coeff_dvd {k m : ℕ} (h : k ≤ m) (z : (Quotient R π m)[T;T⁻¹])
    (hz : coeffMap (restrictionLE R π h).toRingHom z = 0) (d : ℤ) :
    parameter R π m ^ (k + 1) ∣ z.coeff d := by
  apply (restrictionLE_eq_zero_iff R π h _).mp
  have hc := congrArg (fun p : (Quotient R π k)[T;T⁻¹] ↦ p.coeff d) hz
  simpa only [coeffMap_coeff, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply,
    AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom] using hc

/-- The full Laurent kernel is divisible without truncating support or choosing residue lifts. -/
theorem restrictionLE_laurent_dvd {k m : ℕ} (h : k ≤ m)
    (z : (Quotient R π m)[T;T⁻¹]) (hz : coeffMap (restrictionLE R π h).toRingHom z = 0) :
    C (parameter R π m ^ (k + 1)) ∣ z :=
  LaurentCoefficientDivisibility.C_dvd_of_coeff _ _ (restrictionLE_coeff_dvd R π h z hz)

end FLT.Mazur.PolygonArithmeticStages
