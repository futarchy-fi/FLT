module

public import FLT.Mazur.PolygonCompletePrincipalClosedFiber
public import FLT.Mazur.PolygonCompleteFamilyFlatness
public import FLT.Mazur.PolygonCompleteLineQuotient
public import FLT.Mazur.PolygonHigherStructureCohomology
public import FLT.Mazur.FlatStructureScalarMonicity
public import FLT.Mazur.PrincipalClosedCohomology
public import FLT.Mazur.ProperRingCohomologyFinite

/-!
# Original cohomology of the complete polygon family

The regular parameter sequence and actual closed functions give flat first
cohomology. Closed polygon vanishing and finite proper cohomology give
vanishing in every higher degree directly by Nakayama.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry

namespace FLT.Mazur.PolygonInfinitesimalStages

open FCurve WeierstrassIntegralChart Chow.AffineBase IdealPowerScalarLift

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase

variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n]

/-- The actual complete parameter subscheme has no structure cohomology above degree one. -/
theorem completeClosedIdeal_higher_subsingleton (q : ℕ) :
    Subsingleton (ModuleH (structureModule (compatibleProjAdicIdeal K n h).subscheme)
      (q + 2)) :=
  SchemeCoproductCohomology.of_iso (completeClosedIdealIso K n h) (q + 2)
    (PolygonHigherStructureCohomology.higher_subsingleton K n (by omega)
      (PolygonCyclicAtlas.normalization K n h) (PolygonCyclicAtlas.nodes K n h)
      (PolygonCyclicPushout.isPushout K n h (by omega)) q)

/-- The actual complete scalar map is monic on the original structure sheaf. -/
theorem completeParameter_scalarEnd_mono :
    Mono (scalarEnd (structureModule (exactVeroneseProj K n h))
      (baseCohomologyScalars (exactVeroneseProjToBase K n h) PowerSeries.X)) := by
  let _ := exactVeroneseProjToBase_flat K n h
  exact FlatStructureScalarMonicity.scalarEnd_mono _ _
    (isRegular_iff_ne_zero.mpr PowerSeries.X_ne_zero)

/-- The actual adic ideal is generated by the original parameter section on every chart. -/
theorem completeParameter_ideal (U : (exactVeroneseProj K n h).affineOpens) :
    (compatibleProjAdicIdeal K n h).ideal U =
      Ideal.span {((exactVeroneseProj K n h).presheaf.map U.1.leTop.op
        (baseCohomologyScalars (exactVeroneseProjToBase K n h) PowerSeries.X))} :=
  FlatStructureScalarMonicity.baseIdeal_principal _ _ U

/-- Actual first structure cohomology is flat over the unchanged power-series coefficient ring. -/
theorem completeStructureH1_flat :
    Module.Flat (PowerSeries K) (ModuleRingH
      (baseCohomologyScalars (exactVeroneseProjToBase K n h))
      (structureModule (exactVeroneseProj K n h)) 1) := by
  let _ : (exactVeroneseProj K n h).IsSeparated :=
    inferInstanceAs (Proj (compatibleVeroneseGrade K n h (exactVeroneseStep K n h))).IsSeparated
  let _ := completeParameter_scalarEnd_mono K n h
  exact PowerSeriesParameterFlatness.flat K _
    (PrincipalClosedCohomology.h1_regular (compatibleProjAdicIdeal K n h) _
      (completeParameter_ideal K n h) (completeClosedIdeal_appTop_surjective K n h))

/-- Actual proper structure cohomology vanishes in every degree above one. -/
theorem completeStructureH_higher_subsingleton (q : ℕ) :
    Subsingleton (ModuleRingH (baseCohomologyScalars (exactVeroneseProjToBase K n h))
      (structureModule (exactVeroneseProj K n h)) (q + 2)) := by
  let _ : (exactVeroneseProj K n h).IsSeparated :=
    inferInstanceAs (Proj (compatibleVeroneseGrade K n h (exactVeroneseStep K n h))).IsSeparated
  let _ := exactVeroneseProjToBase_isProper K n h
  let _ := CoherentIdealIntersection.structureModule_coherent
    (X := exactVeroneseProj K n h)
  let _ := completeParameter_scalarEnd_mono K n h
  let _ := completeClosedIdeal_higher_subsingleton K n h q
  let _ := proper_coherent_hasFiniteRingCohomology (exactVeroneseProjToBase K n h)
    (structureModule (exactVeroneseProj K n h)) (q + 2)
  apply PrincipalClosedCohomology.finite_vanishing (compatibleProjAdicIdeal K n h)
    (baseCohomologyScalars (exactVeroneseProjToBase K n h)) PowerSeries.X _
    (completeParameter_ideal K n h) (q + 2)
  rw [IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top,
    ← PowerSeries.ker_coeff_eq_max_ideal]
  exact PowerSeries.constantCoeff_X

end FLT.Mazur.PolygonInfinitesimalStages
