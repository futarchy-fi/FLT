module

public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.LinearAlgebra.Prod

/-!
# Two generators subject to one linear relation

The quotient of a free rank-two module by the relation y dx + x dy
has the explicit universal property used by arithmetic cotangent modules.
-/

@[expose] public noncomputable section

namespace FLT.Mazur.TwoGeneratorRelation

variable {C : Type*} [CommRing C] (x y : C)

/-- The submodule generated by the single relation vector. -/
def relations : Submodule C (C × C) := Submodule.span C {(y, x)}

/-- The explicit quotient by the relation y dx + x dy. -/
abbrev Model := (C × C) ⧸ relations x y

/-- The first generator of the quotient. -/
def left : Model x y := (relations x y).mkQ (1, 0)

/-- The second generator of the quotient. -/
def right : Model x y := (relations x y).mkQ (0, 1)

/-- The quotient generators satisfy the prescribed relation. -/
theorem relation : x • right x y + y • left x y = 0 := by
  change x • (relations x y).mkQ (0, 1) + y • (relations x y).mkQ (1, 0) = 0
  rw [← map_smul, ← map_smul, ← map_add]
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  simp [relations]

/-- Every quotient element is a combination of the two distinguished generators. -/
theorem mk_eq (p : C × C) :
    (relations x y).mkQ p = p.1 • left x y + p.2 • right x y := by
  change (relations x y).mkQ p =
    p.1 • (relations x y).mkQ (1, 0) + p.2 • (relations x y).mkQ (0, 1)
  rw [← map_smul, ← map_smul, ← map_add]
  congr 1
  ext <;> simp

variable {N : Type*} [AddCommGroup N] [Module C N]

/-- Evaluate a free pair at two prescribed module elements. -/
def pairMap (u v : N) : (C × C) →ₗ[C] N :=
  (LinearMap.fst C C C).smulRight u + (LinearMap.snd C C C).smulRight v

/-- Free-pair evaluation is the expected linear combination. -/
@[simp] theorem pairMap_apply (u v : N) (p : C × C) :
    pairMap u v p = p.1 • u + p.2 • v := rfl

/-- A solution of the relation induces a map from the quotient. -/
def lift (u v : N) (h : x • v + y • u = 0) : Model x y →ₗ[C] N :=
  (relations x y).liftQ (pairMap u v) (by
    rw [relations, Submodule.span_le, Set.singleton_subset_iff]
    change y • u + x • v = 0
    rwa [add_comm])

/-- The quotient lift preserves the first generator. -/
@[simp] theorem lift_left (u v : N) (h : x • v + y • u = 0) :
    lift x y u v h (left x y) = u := by
  change (1 : C) • u + (0 : C) • v = u
  simp

/-- The quotient lift preserves the second generator. -/
@[simp] theorem lift_right (u v : N) (h : x • v + y • u = 0) :
    lift x y u v h (right x y) = v := by
  change (0 : C) • u + (1 : C) • v = v
  simp

/-- Images of the two generators determine a linear map from the quotient. -/
theorem hom_ext (f g : Model x y →ₗ[C] N)
    (hl : f (left x y) = g (left x y)) (hr : f (right x y) = g (right x y)) :
    f = g := by
  apply LinearMap.ext
  intro q
  obtain ⟨p, rfl⟩ := (relations x y).mkQ_surjective q
  rw [mk_eq, map_add, map_add, map_smul, map_smul, map_smul, map_smul, hl, hr]

end FLT.Mazur.TwoGeneratorRelation
