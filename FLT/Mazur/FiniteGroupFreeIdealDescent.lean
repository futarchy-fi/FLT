module

public import FLT.Mazur.FiniteGroupFreeTraceIdeal

/-!
# Reconstruction of invariant closed ideals under free finite actions

The identity orbit combination reconstructs every element of a stable source
ideal from invariant elements of that same ideal. Consequently extension of
the contracted ideal is exactly the original ideal, including nilpotents.
-/

@[expose] public noncomputable section
open scoped BigOperators
namespace FLT.Mazur.FiniteGroupQuotient
variable (G : Type*) [Group G] [Fintype G]
  {A : Type*} [CommRing A] [MulSemiringAction G A]
  (J : Ideal A) (hJ : ∀ (g : G) a, a ∈ J → g • a ∈ J)
set_option quotPrecheck false in
local notation "I" => (J.comap (inclusion G A)).map (inclusion G A)
include hJ

/-- Weighted sums of a stable ideal element lie in the extended invariant ideal. -/
theorem weighted_orbit_sum_mem_invariantIdeal {v : G → A} (hv : v ∈ orbitSpan G A)
    (x : A) (hx : x ∈ J) : ∑ g, v g * (g • x) ∈ I := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨b, rfl⟩ := hv
    have h : orbitTrace G (b * x) ∈ J.comap (inclusion G A) := by
      change (∑ g : G, g • (b * x)) ∈ J
      exact J.sum_mem (fun g _ ↦ hJ g (b * x) (J.mul_mem_left b hx))
    simpa only [inclusion, Subring.coe_subtype, orbitTrace, orbitProfile,
      MulSemiringAction.smul_mul] using Ideal.mem_map_of_mem (inclusion G A) h
  | zero => simpa only [Pi.zero_apply, zero_mul, Finset.sum_const_zero] using (I).zero_mem
  | add v w _ _ hv hw =>
    simpa only [Pi.add_apply, add_mul, Finset.sum_add_distrib] using (I).add_mem hv hw
  | smul a v _ hv =>
    simpa only [Pi.smul_apply, smul_eq_mul, mul_assoc, Finset.mul_sum] using
      (I).mul_mem_left a hv

omit [Fintype G] in
/-- Every stable ideal is generated by its actual invariant elements for a free finite action. -/
theorem invariantIdeal_map_comap_eq [Finite G]
    (hfree : ∀ g : G, g ≠ 1 → fixedPointIdeal G A g = ⊤) : I = J := by
  let _ := Fintype.ofFinite G
  apply le_antisymm (Ideal.map_comap_le)
  intro x hx
  obtain ⟨v, hv, hv₁, hv₀⟩ := exists_identity_orbit_combination G A hfree
  have hsum : (∑ g : G, v g * (g • x)) = x := by
    rw [Fintype.sum_eq_single 1 (fun g hg ↦ by rw [hv₀ g hg, zero_mul]),
      hv₁, one_smul, one_mul]
  exact hsum ▸ weighted_orbit_sum_mem_invariantIdeal G J hJ hv x hx

end FLT.Mazur.FiniteGroupQuotient
