module

public import FLT.Mazur.WeierstrassSuccessiveInfinityCenter
public import FLT.Mazur.WeierstrassModificationXFlat

/-!
# The deeper original center on the retained x-direction input

The deeper original ideal is generated by the retained horizontal variable.
Cancelling that regular variable from the scaled output center forces the
successive output center to be the unit ideal.
-/

@[expose] public noncomputable section
open AlgebraicGeometry CategoryTheory
namespace FLT.Mazur.WeierstrassSuccessiveX
set_option backward.isDefEq.respectTransparency false

universe u
variable {R : Type u} [CommRing R]

/-- Cancelling a regular retained horizontal coordinate forces the other ideal to be a unit. -/
theorem successiveCenter_unit_of_scaled_eq {S : Type u} [CommRing S]
    (x t : S) (J : Ideal S) (hx : IsRegular x)
    (h : Ideal.span {x * t} * J = Ideal.span {x}) : J = ⊤ := by
  have he : Ideal.span {x} * (Ideal.span {t} * J) = Ideal.span {x} * ⊤ := by
    rw [← mul_assoc, Ideal.span_singleton_mul_span_singleton, Ideal.mul_top]
    exact h
  have ht := regular_principal_mul_cancel hx he
  exact top_unique (ht ▸ Ideal.mul_le_right)

variable (W : WeierstrassCurve R) (s π b3 b4 b6 : R)
  (h3 : W.a₃ = s * b3) (h4 : W.a₄ = s * b4) (h6 : W.a₆ = s ^ 2 * b6)
local notation "X" => WeierstrassModificationX.Coordinate W s b3 b4 b6
local notation "x" => WeierstrassModificationX.x W s b3 b4 b6
local notation "t" => WeierstrassModificationX.t W s b3 b4 b6
local notation "c" => WeierstrassModificationX.fromOriginal W s b3 b4 b6 h3 h4 h6

/-- Every deeper original center is already principal on the retained initial exterior. -/
theorem originalDeeperCenter_map_exterior :
    (WeierstrassIntegralChart.modificationChartCenter W (s * π) 2).map (c).toRingHom =
      Ideal.span {x} := by
  rw [WeierstrassIntegralChart.modificationChartCenter_map]
  simp only [WeierstrassModificationX.fromOriginal_x,
    WeierstrassModificationX.fromOriginal_y, WeierstrassModificationX.y, map_mul,
    ← WeierstrassModificationX.incidence W s b3 b4 b6]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · exact Ideal.mem_span_singleton.mpr ⟨t * algebraMap R X π, by ring⟩
    · exact Ideal.subset_span (Set.mem_singleton x)
    · exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
  · apply Ideal.span_mono
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst z
    simp

/-- Arbitrary ring presentations retain the same deeper input ideal generator. -/
theorem originalDeeperCenter_map_exteriorPresentation {S : Type u} [CommRing S]
    (ψ : X →+* S) :
    (WeierstrassIntegralChart.modificationChartCenter W (s * π) 2).map
      (ψ.comp (c).toRingHom) = Ideal.span {ψ x} := by
  rw [← Ideal.map_map, originalDeeperCenter_map_exterior, Ideal.map_span]
  simp only [Set.image_singleton]

end FLT.Mazur.WeierstrassSuccessiveX
