module

public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Residue tensor products and principal scalar reduction

A surjective coefficient homomorphism identifies tensor base change with
reduction by its kernel. When that kernel is principal, this is precisely
the quotient by the scalar endomorphism used in the cohomology sequence.
-/

@[expose] public noncomputable section

open scoped TensorProduct Pointwise

namespace FLT.Mazur.PrincipalResidueTensor

universe u v w

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
  (hs : Function.Surjective (algebraMap R S))
  (M : Type w) [AddCommGroup M] [Module R M]

/-- The quotient by the actual coefficient kernel is the target coefficient algebra. -/
def coefficientQuotientEquiv : (R ⧸ RingHom.ker (algebraMap R S)) ≃ₐ[R] S where
  __ := RingHom.quotientKerEquivOfSurjective hs
  commutes' _ := rfl

/-- Tensor base change by surjective coefficients is quotient by the actual kernel. -/
def kernelTensorEquiv : S ⊗[R] M ≃ₗ[R]
    M ⧸ (RingHom.ker (algebraMap R S) • (⊤ : Submodule R M)) :=
  ((coefficientQuotientEquiv hs).symm.toLinearEquiv.rTensor M).trans
    (TensorProduct.quotTensorEquivQuotSMul M _)

/-- The submodule generated by a principal ideal is the range of its scalar map. -/
theorem principal_smul_top (a : R) :
    Ideal.span {a} • (⊤ : Submodule R M) =
      LinearMap.range (DistribSMul.toLinearMap R M a) := by
  rw [Submodule.ideal_span_singleton_smul]
  ext x
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    LinearMap.mem_range, DistribSMul.toLinearMap_apply]

/-- Principal scalar reduction is actual residue tensor base change. -/
def principalTensorEquiv (a : R)
    (ha : RingHom.ker (algebraMap R S) = Ideal.span {a}) :
    S ⊗[R] M ≃ₗ[R] M ⧸ LinearMap.range (DistribSMul.toLinearMap R M a) :=
  (kernelTensorEquiv hs M).trans
    (Submodule.quotEquivOfEq _ _ (by rw [ha, principal_smul_top]))

/-- A linear equivalence for surjective coefficients is linear over the target ring. -/
def extendEquiv {N P : Type*} [AddCommGroup N] [AddCommGroup P]
    [Module R N] [Module R P] [Module S N] [Module S P]
    [IsScalarTower R S N] [IsScalarTower R S P] (e : N ≃ₗ[R] P) : N ≃ₗ[S] P where
  __ := e.toAddEquiv
  map_smul' s x := by
    obtain ⟨r, rfl⟩ := hs s
    change e ((algebraMap R S r) • x) = (algebraMap R S r) • e x
    simpa only [algebraMap_smul] using e.map_smul r x

end FLT.Mazur.PrincipalResidueTensor
