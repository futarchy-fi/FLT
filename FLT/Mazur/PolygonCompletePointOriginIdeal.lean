module

public import FLT.Mazur.PolygonCompletePointOriginNeighborhood
public import FLT.Mazur.WeierstrassOriginComplement
public import FLT.Mazur.WeierstrassOriginDivisorCoordinates
public import FLT.Mazur.AffinePullbackIdeal

/-!
# The actual pulled origin ideal and its local equations

The pulled ideal has exactly the original marking as support. On the actual
parameter preimage its powers are generated by the pulled original parameter.
This does not yet assert equality with the original marking ideal.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
namespace FLT.Mazur.PolygonInfinitesimalStages
open WeierstrassIntegralChart
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase

variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (i : Fin n)
local notation "s" => completeBaseMarking K n h i
local notation "W" => completePointWeierstrassCurve K n h i
local notation "g" => completePointToIntegralCubic K n h i
local notation "V" => completePointOriginOpen K n h i
local notation "q" => completePointToOrigin K n h i

/-- The original cubic origin ideal pulled to the actual complete-base family. -/
def completePointPulledOriginIdeal : (exactVeroneseProj K n h).IdealSheafData :=
  (integralCurveZero (W)).ker.comap (g)

/-- Its complement is exactly the original Cartier complement. -/
theorem completePointPulledOriginIdeal_complement :
    (completePointPulledOriginIdeal K n h i).support.compl = (s).ker.support.compl := by
  rw [completePointPulledOriginIdeal, Scheme.IdealSheafData.support_comap]
  change (g) ⁻¹ᵁ (integralCurveZero (W)).ker.support.compl = _
  rw [← integralCurve_affine_eq_origin_complement,
    completePointToIntegralCubic_preimage_z]

/-- The cubic map introduces no additional points over its origin. -/
theorem completePointPulledOriginIdeal_support :
    (completePointPulledOriginIdeal K n h i).support = (s).ker.support := by
  exact TopologicalSpace.Closeds.compl_bijective.injective
    (completePointPulledOriginIdeal_complement K n h i)

/-- Restricting the pulled ideal to the actual preimage retains the parameter-neighborhood ideal. -/
theorem completePointPulledOriginIdeal_neighborhood :
    (completePointPulledOriginIdeal K n h i).comap (V).ι =
      (originNeighborhoodSection (W)).ker.comap (q) := by
  rw [completePointPulledOriginIdeal, ← Scheme.IdealSheafData.comap_comp,
    ← completePointToOrigin_inclusion, Scheme.IdealSheafData.comap_comp,
    originIdealSheaf_neighborhood]

attribute [local irreducible] completePointPulledOriginIdeal completePointOriginOpen
  completePointToOrigin

/-- Every pulled ideal power has its exact original parameter equation on every affine open. -/
theorem completePointPulledOriginIdeal_equation (m : ℕ) (A : (V).toScheme.affineOpens) :
    (((completePointPulledOriginIdeal K n h i) ^ m).comap (V).ι).ideal A =
      Ideal.span {((q).appLE ⊤ A (by simp)).hom (originParameterSection (W) ^ m)} := by
  have he := (FCurve.idealSheaf_comap_pow
    (completePointPulledOriginIdeal K n h i) (V).ι m).trans
      ((congrArg (fun J => J ^ m) (completePointPulledOriginIdeal_neighborhood K n h i)).trans
        (FCurve.idealSheaf_comap_pow (originNeighborhoodSection (W)).ker (q) m).symm)
  exact (congrArg (fun J => J.ideal A) he).trans
    (Scheme.IdealSheafData.ideal_comap_of_span_singleton _ (q)
      ⟨⊤, isAffineOpen_top _⟩ A (by simp) _
      (originIdealSheaf_power_section_equation (W) m))

/-- The original marking ideal restricts to the actual lifted marking ideal. -/
theorem completePointMarkingIdeal_neighborhood :
    (s).ker.comap (V).ι = (completePointMarkingOrigin K n h i).ker := by
  let _ := exactVeroneseProjToBase_isProper K n h
  have : IsClosedImmersion ((completePointMarkingOrigin K n h i) ≫ (V).ι) := by
    rw [completePointMarkingOrigin_inclusion]
    exact FCurve.isClosedImmersion_section _ _ (completeBaseMarking_toBase K n h i)
  rw [← completePointMarkingOrigin_inclusion, ProjectiveLineMarkedCharts.ker_comap_mono]

end FLT.Mazur.PolygonInfinitesimalStages
