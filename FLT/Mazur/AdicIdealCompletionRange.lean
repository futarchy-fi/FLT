module

public import Mathlib.RingTheory.AdicCompletion.AsTensorProduct

/-!
# The image of an ideal's completion

Completing the inclusion of a finite ideal has image equal to the ideal
generated by its original elements in the completed ring. Thus exactness
of completion can identify completed presentation kernels as actual ideals.
-/

@[expose] public noncomputable section

namespace FLT.Mazur.AdicIdealCompletionRange

open TensorProduct

set_option backward.isDefEq.respectTransparency false

variable {R : Type*} [CommRing R] (I K : Ideal R) [Module.Finite R K]

/-- The image of the completed inclusion is the extension of the original ideal. -/
theorem range_map_subtype :
    LinearMap.range (AdicCompletion.map I K.subtype) =
      K.map (algebraMap R (AdicCompletion I R)) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    obtain ⟨x, rfl⟩ := AdicCompletion.ofTensorProduct_surjective_of_finite I K x
    refine TensorProduct.inductionOn x ?_ ?_
    · intro a k
      rw [AdicCompletion.ofTensorProduct_tmul, map_smul, AdicCompletion.map_of]
      exact Submodule.smul_mem _ a (Ideal.mem_map_of_mem _ k.property)
    · intro x y hx hy
      simpa only [map_add] using Ideal.add_mem _ hx hy
  · rw [Ideal.map_le_iff_le_comap]
    intro k hk
    exact ⟨AdicCompletion.of I K ⟨k, hk⟩, AdicCompletion.map_of I K.subtype ⟨k, hk⟩⟩

end FLT.Mazur.AdicIdealCompletionRange
