/-!
# Finite submodules generated by specified actual boundary errors

A finite family of original boundary sections gives a finite submodule of the
full localized correction cokernel. In particular the specified section has
an unconditional cyclic finite container. Divisibility of this container is
a separate obligation; no finiteness of the entire image is asserted.
-/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TensorProduct
namespace FLT.Mazur.HilbertChart.AffineRestriction
open CartierAbel SchemePicard FCurve EquivalenceRelationNormalizedFrames
open RelativeRelationOrbit InvariantOpenRelationDiagram
open FiniteGroupRestriction SchemeFiniteGroupQuotient
set_option backward.isDefEq.respectTransparency true
set_option backward.defeqAttrib.useBackward true
attribute [local irreducible] relativeFppfSheaf AmpleLineBundle
variable {R : Type} [CommRing R] [Algebra.FiniteType ℤ R] {X : Scheme}
  (f : X ⟶ Spec (.of R)) [IsProper f] [Flat f] [GeometricallyIntegral f]
  [SmoothOfRelativeDimension 1 f] {L : X.Modules} (hL : AmpleLineBundle L)
  (d : ℕ) (V : Over (Spec (.of R))) [IsAffine V.left] [Etale V.hom]
  (c : (relativeFppfSheaf f).obj.obj (op V))
  {A : Over (Spec (.of R))} [IsAffine A.left]
  (k : A ⟶ variableHilbertTest f d V) [IsOpenImmersion k.left]
attribute [local irreducible] relation fst snd equivalence
  EquivalenceRelationNormalizedFrames.source
namespace OrbitBoundaryAtlas.FiniteAtlas
attribute [local irreducible] finiteCharts lifts obstruction
  scalarFamily normalizedBoundaryChartMap normalizedOrbitBoundaryCoefficient
local notation "e" => equivalence f hL d V c k
variable (W : TopologicalSpace.Opens (Orbit (equivalence f hL d V c k)))
set_option quotPrecheck false
local notation "E" => (pullOpen e W).val

variable (hW : IsAffineOpen (pullOpen (equivalence f hL d V c k) W).val)
local notation "Charts" => finiteCharts f hL d V c k W hW

attribute [local irreducible] originalChartScalarMap
local notation "Ω" => (invariantSheaf e).obj.obj (op W)
local notation "Ac" => chartCoordinateRing f hL d V c k W hW
local notation "Bc" => chartBoundaryCoordinateRing f hL d V c k W hW
local notation "Cc" => mixedCoordinateRing f hL d V c k W hW

local notation "ec" => originalClosedEquivalence f hL d V c k
local notation "m" => originalClosedInvariantMap f hL d V c k
local notation "Wc" => (TopologicalSpace.Opens.map (m).base).obj W
local notation "D" => (invariantSheaf ec).obj.obj (op Wc)
local notation "ρ" => originalClosedSectionPullback f hL d V c k W

attribute [local instance] originalBoundarySectionAlgebra originalCorrectionBoundaryAlgebra
  originalCorrectionChartAlgebra originalCorrectionMixedAlgebra
attribute [local irreducible] originalBoundaryCoefficientLinearMap
  BoundaryCorrectionIdeal.originalCorrectionOperator
  originalCorrectionBoundaryHom originalCorrectionFirstHom originalCorrectionSecondHom
local notation "Hb" => originalCorrectionBoundaryHom f hL d V c k W hW
local notation "Fp" => originalCorrectionFirstHom f hL d V c k W hW
local notation "Gq" => originalCorrectionSecondHom f hL d V c k W hW
local notation "β" => originalBoundaryCoefficientLinearMap f hL d V c k W hW
variable (S : Type*) [CommRing S]
  [Algebra ((invariantSheaf (equivalence f hL d V c k)).obj.obj (op W)) S]
attribute [local irreducible] BoundaryCorrectionIdeal.ambientCorrectionOperator
  BoundaryCorrectionIdeal.ambientScalarError
local notation "F₀" => BoundaryCorrectionIdeal.ambientCorrectionOperator Hb Fp Gq 0 S
local notation "π" => (LinearMap.range F₀).mkQ


attribute [local irreducible] originalBoundarySealedObstructionMap
  originalBoundaryLiftErrorClass

attribute [local irreducible] originalBoundaryExtendedCokernelAddCommGroup
  originalBoundaryExtendedCokernelModule originalClosedEquivalence originalClosedInvariantMap

attribute [local irreducible] invariantSheaf originalBoundarySource
  originalBoundarySourceMap originalClosedRelation originalClosedFst originalClosedSnd
  originalClosedArrow SchemeOpenEnvelope.denominatorIdeal

/-- The specified actual error has an unconditional finite container in its full image. -/
theorem originalBoundaryLiftErrorClass_finite_container (t : D) :
    ∃ Q : Submodule S (originalBoundaryExtendedCokernel f hL d V c k W hW S),
      Q.FG ∧ Q ≤ LinearMap.range
        (originalBoundarySealedObstructionMap f hL d V c k W hW S) ∧
      originalBoundaryLiftErrorClass f hL d V c k W hW S t ∈ Q := by
  refine ⟨Submodule.span S {originalBoundaryLiftErrorClass f hL d V c k W hW S t},
    Submodule.fg_span_singleton _, ?_, Submodule.subset_span (Set.mem_singleton _)⟩
  rw [Submodule.span_singleton_le_iff_mem]
  exact originalBoundaryLiftErrorClass_mem_range f hL d V c k W hW S t

/-- Any specified finite family of actual errors has one finite container in the full image. -/
theorem originalBoundaryFiniteErrorFamily_container {ι : Type*} [Finite ι] (t : ι → D) :
    ∃ Q : Submodule S (originalBoundaryExtendedCokernel f hL d V c k W hW S),
      Q.FG ∧ Q ≤ LinearMap.range
        (originalBoundarySealedObstructionMap f hL d V c k W hW S) ∧
      ∀ j, originalBoundaryLiftErrorClass f hL d V c k W hW S (t j) ∈ Q := by
  let errors : ι → originalBoundaryExtendedCokernel f hL d V c k W hW S :=
    fun j ↦ originalBoundaryLiftErrorClass f hL d V c k W hW S (t j)
  refine ⟨Submodule.span S (Set.range errors), Submodule.fg_span (Set.finite_range errors), ?_,
    fun j ↦ Submodule.subset_span (Set.mem_range_self j)⟩
  apply Submodule.span_le.mpr
  rintro _ ⟨j, rfl⟩
  exact originalBoundaryLiftErrorClass_mem_range f hL d V c k W hW S (t j)

end OrbitBoundaryAtlas.FiniteAtlas
end FLT.Mazur.HilbertChart.AffineRestriction
