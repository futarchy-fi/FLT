module

public import FLT.Mazur.HilbertFamilyBoundedEvaluation
public import FLT.Mazur.HilbertTruncatedIdealDetection

/-!
# Bounded relations determine arbitrary finite flat families

The full ideal of a finite flat rank-d quotient over any coefficient ring is
generated in degree at most d+1. Its actual relation subspace in that degree
range detects ideal inclusion and equality, with nilpotents retained.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.HilbertChart
universe u
variable (S I : Type u) [CommRing S] (J : Ideal (MvPolynomial I S)) (d : ℕ)
  [Module.FinitePresentation S (MvPolynomial I S ⧸ J)]
  [Module.Flat S (MvPolynomial I S ⧸ J)]
  (hd : ∀ p : PrimeSpectrum S, Module.finrank p.asIdeal.ResidueField
    (MvPolynomial I p.asIdeal.ResidueField ⧸
      J.map (MvPolynomial.map (algebraMap S p.asIdeal.ResidueField))) = d)

include hd in
/-- The full family ideal is generated by its bounded relations over any coefficient ring. -/
theorem finiteFlat_truncatedRelationIdeal_eq : truncatedRelationIdeal S I J d = J :=
  truncatedRelationIdeal_eq S I J d (finiteFlat_exists_bounded_representative S I J d hd)

include hd in
/-- Containment in any ideal can be tested on the finite flat source's bounded relations. -/
theorem finiteFlat_ideal_le_of_truncated (K : Ideal (MvPolynomial I S))
    (h : truncatedIdealSubmodule S I J (d + 1) ≤ truncatedIdealSubmodule S I K (d + 1)) :
    J ≤ K := by
  apply ideal_le_of_bounded_relations S I J K d
    (finiteFlat_exists_bounded_representative S I J d hd)
  intro p hp hJ
  exact ((mem_truncatedIdealSubmodule S I K (d + 1) p).mp
    (h ((mem_truncatedIdealSubmodule S I J (d + 1) p).mpr ⟨hJ, hp⟩))).1

variable (K : Ideal (MvPolynomial I S))
  [Module.FinitePresentation S (MvPolynomial I S ⧸ K)]
  [Module.Flat S (MvPolynomial I S ⧸ K)]
  (he : ∀ p : PrimeSpectrum S, Module.finrank p.asIdeal.ResidueField
    (MvPolynomial I p.asIdeal.ResidueField ⧸
      K.map (MvPolynomial.map (algebraMap S p.asIdeal.ResidueField))) = d)

include hd he in
/-- The bounded relation subspace distinguishes full families over arbitrary rings. -/
theorem finiteFlat_ideal_eq_iff_truncated :
    J = K ↔ truncatedIdealSubmodule S I J (d + 1) =
      truncatedIdealSubmodule S I K (d + 1) := by
  constructor
  · rintro rfl
    rfl
  · intro h
    exact le_antisymm (finiteFlat_ideal_le_of_truncated S I J d hd K h.le)
      (finiteFlat_ideal_le_of_truncated S I K d he J h.ge)

end FLT.Mazur.HilbertChart
