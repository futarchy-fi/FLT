module

public import FLT.Mazur.PolygonCompleteIdentityFirstChartResidualGenerators
public import FLT.Mazur.PolygonCompleteIdentityFirstChartTargetScalars
public import FLT.Mazur.PolygonSmoothingDifferenceIdeal

/-!
# Two original coordinate errors generate the entire residual closed-fiber ideal

Original source and target coefficient maps agree before reduction. Hence
all actual target errors are generated by their two coordinate values.
Neither generator is assumed or proved to vanish here.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing LaurentPolynomial LaurentFirstStageParameter
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointWeierstrassCurve completePointToIntegralCubic originalStageToCompatibleProj
  completeIdentityFirstActionUnit completeIdentityFirstActionField
  completeIdentityFirstActionNodeDefect completeIdentityFirstErrorAlgebra
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n]
local notation "A" => Ring K 1
local notation "t" => parameter K 1
local notation "e" => parameter K[T;T⁻¹] 1
local notation "B" => ChartRing (t)
local notation "s" => completeIdentityFirstChartSourceFunctions K n h
local notation "p" => completeIdentityFirstChartTargetFunctions K n h
local notation "a" => stageCoefficientMap (C : K →+* K[T;T⁻¹]) 1
local notation "b" => ringMap (a) (t) (e) (stageCoefficientMap_parameter _ _)
local notation "σ" => reciprocalScale (e) (parameterUnit K)
local notation "q" => completeIdentityFirstChartClosedQuotient K n h
local notation "r" => completeIdentityFirstChartClosedReduction K n h
local notation "δ" => completeIdentityFirstChartClosedError K n h

/-- Scaling the original source does not alter any original truncated-base coefficient. -/
theorem completeIdentityFirstChartScaledSource_scalar (z : A) :
    (s) ((σ) ((b) (algebraMap (A) (B) z))) = (p) (algebraMap (A) (B) z) := by
  rw [ringMap_scalar, AlgHom.commutes, completeIdentityFirstChartTargetFunctions_scalar]
  exact completeIdentityFirstChartSource_scalar K n h z

attribute [local irreducible] completeIdentityFirstChartClosedError
  completeIdentityFirstChartClosedReduction completeIdentityFirstChartClosedQuotient
  completeIdentityFirstChartSourceFunctions completeIdentityFirstChartTargetFunctions

/-- The full residual kernel is generated by the two actual original coordinate errors. -/
theorem completeIdentityFirstChartResidualKernel_twoCoordinates :
    RingHom.ker (r) = Ideal.span {(δ) (leftCoordinate (t)), (δ) (rightCoordinate (t))} := by
  let f := (q).comp (p)
  let g := (q).comp ((s).comp ((σ).toRingHom.comp (b)))
  have he (z : B) : (δ) z = f z - g z := completeIdentityFirstChartClosedError_eq K n h z
  rw [completeIdentityFirstChartResidualKernel_generators]
  have hc (z : A) : f (algebraMap (A) (B) z) = g (algebraMap (A) (B) z) :=
    congrArg (q) (completeIdentityFirstChartScaledSource_scalar K n h z).symm
  have hh := differenceIdeal_twoCoordinates (t) f g hc
  have hrange : (fun z ↦ f z - g z) = (δ) := funext (fun z ↦ (he z).symm)
  rw [hrange, ← he, ← he] at hh
  exact hh

/-- The scaled original source still satisfies the node equation in the full closed fiber. -/
theorem completeIdentityFirstChartClosedScaledSource_xy :
    (q) ((s) ((σ) ((b) (leftCoordinate (t))))) *
      (q) ((s) ((σ) ((b) (rightCoordinate (t))))) = 0 := by
  rw [← map_mul, ← map_mul, ← map_mul, ← map_mul, coordinate_relation,
    ringMap_scalar, AlgHom.commutes, stageCoefficientMap_parameter,
    completeIdentityFirstChartSourceFunctions_parameter,
    completeIdentityFirstChartClosedQuotient_parameter]

/-- The two residual generators satisfy the unchanged target node equation before reduction. -/
theorem completeIdentityFirstChartResidualCoordinates_equation :
    (q) ((s) ((σ) ((b) (leftCoordinate (t))))) * (δ) (rightCoordinate (t)) +
      (q) ((s) ((σ) ((b) (rightCoordinate (t))))) * (δ) (leftCoordinate (t)) +
      (δ) (leftCoordinate (t)) * (δ) (rightCoordinate (t)) = 0 := by
  calc
    _ = (q) ((p) (leftCoordinate (t))) * (q) ((p) (rightCoordinate (t))) -
        (q) ((s) ((σ) ((b) (leftCoordinate (t))))) *
          (q) ((s) ((σ) ((b) (rightCoordinate (t))))) := by
      rw [completeIdentityFirstChartClosedError_eq, completeIdentityFirstChartClosedError_eq]
      ring
    _ = 0 := by
      rw [completeIdentityFirstChartClosedTarget_xy,
        completeIdentityFirstChartClosedScaledSource_xy, sub_self]

end FLT.Mazur.PolygonInfinitesimalStages
