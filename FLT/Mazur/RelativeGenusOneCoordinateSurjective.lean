module

public import FLT.Mazur.DivisorComplementExhaustion
public import FLT.Mazur.RelativeGenusOneAffineCubicMorphism
public import FLT.Mazur.RelativeGenusOnePoleReduction

/-!
# Surjectivity onto all original complement functions

Successively removing the constructed unit-leading monomials generates every
finite pole section. Noetherian pole exhaustion then generates every regular function.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry Scheme.Modules MonoidalCategory
namespace FLT.Mazur.FCurve
open ModuleLineBundleTensorPullback
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] divisorLineBundle sectionPoleMultiplicativeCoordinates
  relativePoleFunction

variable {S : Scheme} [IsAffine S] [IsNoetherianRing Γ(S, ⊤)]
  (G : Over S) [GrpObj G] [IsProper G.hom]
  [SmoothOfRelativeDimension 1 G.hom] [GeometricallyIntegral G.hom]
  (hg : CurveFiberHypotheses.NodalGenusOneGeometricFibers G.hom)
  (s : 𝟙_ (Over S) ⟶ G) (hI : EffectiveCartier s.left.ker)
  (e : (pullback s.left).obj (divisorLineBundle s.left.ker hI) ≅ structureModule S)

local notation "E" => relativePointCoordinateEvaluation G hg s hI e
local notation "φ" => relativePointComplementBaseMap G s
local notation "W" => relativePointWeierstrassCurve G hg s hI e

/-- Every original base scalar belongs to the coordinate image. -/
theorem relativePointCoordinateRange_scalar (a : Γ(S, ⊤)) : φ a ∈ (E).range :=
  ⟨algebraMap Γ(S, ⊤) (W).toAffine.CoordinateRing a,
    relativePointCoordinateEvaluation_scalar G hg s hI e a⟩

/-- The original x function belongs to the coordinate image. -/
theorem relativePointCoordinateRange_x : relativePointComplementX G hg s hI e ∈ (E).range :=
  ⟨algebraMap (Polynomial Γ(S, ⊤)) (W).toAffine.CoordinateRing Polynomial.X,
    relativePointCoordinateEvaluation_x G hg s hI e⟩

/-- The original y function belongs to the coordinate image. -/
theorem relativePointCoordinateRange_y : relativePointComplementY G hg s hI e ∈ (E).range :=
  ⟨AdjoinRoot.root (W).toAffine.polynomial, relativePointCoordinateEvaluation_y G hg s hI e⟩

/-- Every higher unit-leading monomial belongs to the original coordinate image. -/
theorem relativePointCoordinateRange_higher (m : ℕ) :
    relativePoleFunction G.hom s.left hI (m + 2)
      (relativePointHigherMonomial G hg s hI e m) ∈ (E).range := by
  induction m using Nat.twoStepInduction with
  | zero => exact relativePointCoordinateRange_x G hg s hI e
  | one => exact relativePointCoordinateRange_y G hg s hI e
  | more m ih _ =>
    rw [relativePointHigherMonomial_function_step]
    exact (E).range.mul_mem ih (relativePointCoordinateRange_x G hg s hI e)

/-- Original pole sections of every finite order are generated by x and y over the base. -/
theorem relativePointCoordinateRange_pole (m : ℕ)
    (z : ModuleRingH G.hom.appTop.hom
      (tensorPower (divisorLineBundle s.left.ker hI) m) 0) :
    relativePoleFunction G.hom s.left hI m z ∈ (E).range := by
  induction m with
  | zero =>
    have h := (relativePointZeroBasis G hg s hI).sum_repr z
    rw [Fintype.sum_unique] at h
    have hh := congrArg (relativePoleFunction G.hom s.left hI 0) h
    rw [relativePoleFunction_smul, relativePointComplement_zeroBasis, mul_one] at hh
    rw [← hh]
    exact relativePointCoordinateRange_scalar G hg s hI e _
  | succ m ih =>
    cases m with
    | zero =>
      have h := (relativePointOneBasis G hg s hI).sum_repr z
      rw [Fintype.sum_unique] at h
      have hh := congrArg (relativePoleFunction G.hom s.left hI 1) h
      rw [relativePoleFunction_smul, relativePointComplement_oneBasis, mul_one] at hh
      rw [← hh]
      exact relativePointCoordinateRange_scalar G hg s hI e _
    | succ m =>
      obtain ⟨w, a, h⟩ := relativePointHigherMonomial_decomposition G hg s hI e m z
      have hh := congrArg (relativePoleFunction G.hom s.left hI (m + 2)) h
      rw [relativePoleFunction_add, relativePoleFunction_step, relativePoleFunction_smul] at hh
      rw [hh]
      exact (E).range.add_mem (ih w) ((E).range.mul_mem
        (relativePointCoordinateRange_scalar G hg s hI e a)
        (relativePointCoordinateRange_higher G hg s hI e m))

/-- The actual coordinate evaluation is surjective onto the full complement ring. -/
theorem relativePointCoordinateEvaluation_surjective : Function.Surjective E := by
  let _ := Chow.source_isNoetherian (G.hom ≫ S.isoSpec.hom)
  intro z
  obtain ⟨m, t, ht⟩ := exists_divisorComplementFunction hI z
  have h := relativePointCoordinateRange_pole G hg s hI e m ((moduleH0Equiv _).symm t)
  unfold relativePoleFunction at h
  rw [LinearEquiv.apply_symm_apply, ht] at h
  exact h

end FLT.Mazur.FCurve
