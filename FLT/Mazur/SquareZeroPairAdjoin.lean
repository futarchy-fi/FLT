module

public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
public import Mathlib.Tactic.LinearCombination

/-!
# An algebra generated by two square-zero errors

When all products of two errors vanish, adjoining them adds at most two
module generators. The normal form keeps the coefficients in the original
base ring, without asserting that either error belongs to that ring.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.SquareZeroPairAdjoin

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
  (u v : A) (hu : u * u = 0) (huv : u * v = 0) (hv : v * v = 0)

include hu huv hv in
/-- Every element of the error algebra has a three-term expression over the original ring. -/
theorem normalForm {z : A} (hz : z ∈ Algebra.adjoin R ({u, v} : Set A)) :
    ∃ a b c : R, z = algebraMap R A a + algebraMap R A b * u + algebraMap R A c * v := by
  induction hz using Algebra.adjoin_induction with
  | mem x hx =>
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact ⟨0, 1, 0, by simp⟩
    · obtain rfl := Set.mem_singleton_iff.mp hx
      exact ⟨0, 0, 1, by simp⟩
  | algebraMap a => exact ⟨a, 0, 0, by simp⟩
  | add x y hx hy ihx ihy =>
    obtain ⟨a, b, c, rfl⟩ := ihx
    obtain ⟨d, e, f, rfl⟩ := ihy
    exact ⟨a + d, b + e, c + f, by simp only [map_add]; ring⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨a, b, c, rfl⟩ := ihx
    obtain ⟨d, e, f, rfl⟩ := ihy
    refine ⟨a * d, a * e + b * d, a * f + c * d, ?_⟩
    simp only [map_add, map_mul]
    linear_combination
      algebraMap R A b * algebraMap R A e * hu +
      (algebraMap R A b * algebraMap R A f +
        algebraMap R A c * algebraMap R A e) * huv +
      algebraMap R A c * algebraMap R A f * hv

/-- Conversely, every such expression belongs to the actual adjoined algebra. -/
theorem mem_of_normalForm (a b c : R) :
    algebraMap R A a + algebraMap R A b * u + algebraMap R A c * v ∈
      Algebra.adjoin R ({u, v} : Set A) := by
  apply Subalgebra.add_mem
  · exact Subalgebra.add_mem _ (Subalgebra.algebraMap_mem _ a)
      (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ b)
        (Algebra.subset_adjoin (by simp)))
  · exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ c)
      (Algebra.subset_adjoin (by simp))

include hu hv in
/-- Two square-zero errors always generate a finite module extension. -/
theorem finite : Module.Finite R (Algebra.adjoin R ({u, v} : Set A)) := by
  apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.toFinite _)
  intro z hz
  have hi (w : A) (hw : w * w = 0) : IsIntegral R w := by
    apply IsIntegral.of_pow (n := 2) (by decide)
    simpa only [pow_two, hw] using (isIntegral_zero : IsIntegral R (0 : A))
  rcases Set.mem_insert_iff.mp hz with hz | hz
  · exact hz ▸ hi u hu
  · exact (Set.mem_singleton_iff.mp hz) ▸ hi v hv

include hu huv hv in
/-- Multiplication by a scalar killing both errors removes the two extra summands. -/
theorem scalar_mul_eq {s : R} (hsu : algebraMap R A s * u = 0)
    (hsv : algebraMap R A s * v = 0) {z : A}
    (hz : z ∈ Algebra.adjoin R ({u, v} : Set A)) :
    ∃ a : R, algebraMap R A s * z = algebraMap R A (s * a) := by
  obtain ⟨a, b, c, rfl⟩ := normalForm u v hu huv hv hz
  refine ⟨a, ?_⟩
  simp only [map_mul, mul_add]
  rw [mul_left_comm (algebraMap R A s) (algebraMap R A b), hsu, mul_zero,
    mul_left_comm (algebraMap R A s) (algebraMap R A c), hsv, mul_zero, add_zero, add_zero]

end FLT.Mazur.SquareZeroPairAdjoin
