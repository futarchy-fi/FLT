module

public import FLT.Mazur.FiniteModuleFiberSurjective
public import Mathlib.RingTheory.LocalRing.ResidueField.Fiber

/-!
# Finite algebra surjectivity from the actual scheme fibers

If every prime fiber is generated by its coefficient field, the finite
algebra itself is generated as a module by one. Thus its original
structural map is surjective, with no reduced-base assumption.
-/

@[expose] public noncomputable section
open TensorProduct
namespace FLT.Mazur.FCurve

variable {R B : Type*} [CommRing R] [CommRing B] [Algebra R B] [Module.Finite R B]

/-- Surjective structural maps on all prime fibers force the finite algebra map to be onto. -/
theorem finiteAlgebra_surjective_of_residue_fibers
    (hf : ∀ p : PrimeSpectrum R,
      Function.Surjective (algebraMap p.asIdeal.ResidueField (p.asIdeal.Fiber B))) :
    Function.Surjective (algebraMap R B) := by
  apply FiniteModuleFiberVanishing.surjective_of_residue_fields (Algebra.linearMap R B)
  intro p x
  obtain ⟨a, rfl⟩ := hf p x
  refine ⟨a ⊗ₜ[R] (1 : R), ?_⟩
  simp

end FLT.Mazur.FCurve
