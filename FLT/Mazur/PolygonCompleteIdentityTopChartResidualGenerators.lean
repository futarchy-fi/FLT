module

public import FLT.Mazur.GeneratedRelationReductionKernel
public import FLT.Mazur.PolygonCompleteIdentityTopChartAmbientGenerators
public import FLT.Mazur.PolygonCompleteIdentityTopResidualTarget

/-!
# Generators of the full original residual node kernel

The ambient kernel is generated by the original parameter and all actual
target errors. On the literal closed fiber, the parameter is already zero,
so the target errors generate the entire residual ideal.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry
open scoped LaurentPolynomial
namespace FLT.Mazur.PolygonInfinitesimalStages
open PolygonSmoothing LaurentPolynomial LaurentStageParameter
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointWeierstrassCurve completePointToIntegralCubic originalStageToCompatibleProj
  completeIdentityTopActionUnit completeIdentityTopActionField
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n] (m : ℕ)
local notation "t" => parameter K (m + 1)
local notation "e" => parameter K[T;T⁻¹] (m + 1)
local notation "s" => completeIdentityTopAmbientSourceFunctions K n h m
local notation "p" => completeIdentityTopAmbientTargetFunctions K n h m
local notation "a" => stageCoefficientMap (C : K →+* K[T;T⁻¹]) (m + 1)
local notation "b" => ringMap (a) (t) (e) (stageCoefficientMap_parameter _ _)
local notation "σ" => reciprocalScale (e) (parameterUnit K (m + 1))
local notation "f" => completeIdentityTopChartClosedAmbientMap K n h m
variable (hm : completeIdentityFiniteMulDefect K n h 0 m = 0)
local notation "d" => completeIdentityTopAmbientNodeReduction K n h m hm
local notation "r" => completeIdentityTopChartClosedReduction K n h m hm

/-- The full ambient node kernel is generated by the original parameter and actual target errors. -/
theorem completeIdentityTopAmbientNodeKernel_generators :
    RingHom.ker (d) = Ideal.span {completeIdentityTopAmbientParameter K n h m} ⊔
      Ideal.span (Set.range (completeIdentityTopAmbientError K n h m)) := by
  have he := GeneratedRelationReductionKernel.kernel_eq (s) (p)
    ((σ).toRingHom.comp (b)) (d) (topNodeReduction K[T;T⁻¹] m)
    (completeIdentityTopAmbientFunctions_generate K n h m)
    (topNodeReduction_surjective K[T;T⁻¹] m)
    (RingHom.ext (completeIdentityTopAmbientNodeReduction_source K n h m hm))
    (RingHom.ext (completeIdentityTopAmbientNodeReduction_target K n h m hm))
  rw [GeneratedRelationReductionKernel.relations, topNodeReduction_ker,
    Ideal.map_span, Set.image_singleton] at he
  exact he

/-- The original parameter is killed by the actual full closed-fiber map. -/
theorem completeIdentityTopChartClosedAmbientMap_parameter :
    (f) (completeIdentityTopAmbientParameter K n h m) = 0 := by
  change completeIdentityTopChartClosedQuotient K n h m
    ((completeIdentityActionGraphAdicChartEmbedding K n h (m + 1) 0 0).appTop _) = _
  rw [completeIdentityTopAmbientParameter_restrict,
    completeIdentityTopChartClosedQuotient_parameter]

/-- Actual target errors generate every element of the full closed-fiber residual ideal. -/
theorem completeIdentityTopChartResidualKernel_generators :
    RingHom.ker (r) = Ideal.span (Set.range (completeIdentityTopChartClosedError K n h m)) := by
  rw [← completeIdentityTopChartResidualKernel_image,
    completeIdentityTopAmbientNodeKernel_generators, Ideal.map_sup,
    Ideal.map_span, Set.image_singleton, completeIdentityTopChartClosedAmbientMap_parameter,
    Ideal.span_singleton_zero, bot_sup_eq, Ideal.map_span, ← Set.range_comp]
  rfl

end FLT.Mazur.PolygonInfinitesimalStages
