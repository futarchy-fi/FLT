module

public import FLT.Mazur.PolygonOriginalAffineQuotient

/-!
# Original coefficients in the affine quotient comparison

The affine parameter is the image of the original power-series variable.
Restriction to an original stage retains its actual power-series structure
map, so the quotient comparison is over the original complete base.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry

namespace FLT.Mazur.PolygonInfinitesimalStages

set_option backward.isDefEq.respectTransparency false

attribute [local irreducible] family exactVeroneseProj originalStageToCompatibleProj
  originalStageAffineQuotient exactVeroneseProjToBase

variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n]

/-- Coefficients on a complete affine open, from its actual structure morphism. -/
def completeAffineScalars (U : (exactVeroneseProj K n h).affineOpens) :
    PowerSeries K →+* Γ(exactVeroneseProj K n h, U) :=
  ((exactVeroneseProjToBase K n h).appLE ⊤ U (by simp)).hom.comp
    (Scheme.ΓSpecIso (.of (PowerSeries K))).inv.hom

/-- Coefficients on the original stage open, from the original structure morphism. -/
def originalStageAffineScalars (m : ℕ) (U : (exactVeroneseProj K n h).affineOpens) :
    PowerSeries K →+*
      Γ((family K m n h).left, originalStageToCompatibleProj K n h m ⁻¹ᵁ U) :=
  (((family K m n h).hom ≫ baseToSeries K m).appLE ⊤ _ (by simp)).hom.comp
    (Scheme.ΓSpecIso (.of (PowerSeries K))).inv.hom

/-- The affine restriction retains the actual complete-base coefficient map. -/
theorem originalStage_app_scalars (m : ℕ)
    (U : (exactVeroneseProj K n h).affineOpens) (r : PowerSeries K) :
    (originalStageToCompatibleProj K n h m).app U (completeAffineScalars K n h U r) =
      originalStageAffineScalars K n h m U r := by
  have he := Scheme.Hom.appLE_comp_appLE (originalStageToCompatibleProj K n h m)
    (exactVeroneseProjToBase K n h) ⊤ U
    (originalStageToCompatibleProj K n h m ⁻¹ᵁ U) (by simp) le_rfl
  rw [originalStageToCompatibleProj_toBase] at he
  simpa only [completeAffineScalars, originalStageAffineScalars, RingHom.comp_apply,
    ← CommRingCat.comp_apply, Scheme.Hom.appLE, homOfLE_refl, CategoryTheory.op_id,
    CategoryTheory.Functor.map_id, Category.comp_id] using
      congrArg (fun f ↦ f ((Scheme.ΓSpecIso (.of (PowerSeries K))).inv r)) he

/-- The affine adic ideal is generated by the actual smoothing parameter. -/
theorem compatibleProjAdicIdeal_affine (U : (exactVeroneseProj K n h).affineOpens) :
    (compatibleProjAdicIdeal K n h).ideal U =
      Ideal.span {completeAffineScalars K n h U PowerSeries.X} := by
  have he := BaseAdicThickening.extendedPower_ideal (parameterIdeal K)
    (exactVeroneseProjToBase K n h) U 1
  simpa only [pow_one, parameterIdeal, Ideal.map_span, Set.image_singleton,
    compatibleProjAdicIdeal, completeAffineScalars] using he

/-- The affine quotient comparison preserves every original power-series coefficient. -/
theorem originalStageAffineQuotient_scalars (m : ℕ)
    (U : (exactVeroneseProj K n h).affineOpens) (r : PowerSeries K) :
    originalStageAffineQuotient K n h m U
      (Ideal.Quotient.mk _ (completeAffineScalars K n h U r)) =
        originalStageAffineScalars K n h m U r := by
  rw [originalStageAffineQuotient_mk, originalStage_app_scalars]

/-- In particular the actual parameter is retained, without a change of normalization. -/
theorem originalStageAffineQuotient_parameter (m : ℕ)
    (U : (exactVeroneseProj K n h).affineOpens) :
    originalStageAffineQuotient K n h m U
      (Ideal.Quotient.mk _ (completeAffineScalars K n h U PowerSeries.X)) =
        originalStageAffineScalars K n h m U PowerSeries.X :=
  originalStageAffineQuotient_scalars K n h m U PowerSeries.X

end FLT.Mazur.PolygonInfinitesimalStages
