module

public import FLT.Mazur.HomogeneousNumeratorObstruction
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.LinearAlgebra.Span.Basic

/-!
# The scalar obstruction is the actual cyclic part of the homogeneous cokernel

Use the source-linear image of the homogeneous ideal, not its target-ideal
span. The kernel of multiplication by the error class is exactly the scalar
ideal. Its image is a finitely generated submodule of the actual cokernel.
-/

@[expose] public noncomputable section
namespace FLT.Mazur.HomogeneousNumeratorObstruction
variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The full homogeneous source image as a module over original source scalars. -/
def homogeneousImage (I : Ideal R) : Submodule R S :=
  Submodule.map (Algebra.linearMap R S) I

/-- Membership in the linear image retains an actual homogeneous source witness. -/
theorem mem_homogeneousImage (I : Ideal R) (x : S) :
    x ∈ homogeneousImage (S := S) I ↔ ∃ z ∈ I, algebraMap R S z = x := Iff.rfl

/-- Scalar multiplication by the original error class in the full homogeneous cokernel. -/
def errorClassMap (I : Ideal R) (x : S) : R →ₗ[R] S ⧸ homogeneousImage (S := S) I :=
  (homogeneousImage (S := S) I).mkQ.comp (LinearMap.toSpanSingleton R S x)

/-- The scalar kernel is exactly the numerator ideal, without enlarging its image. -/
theorem errorClassMap_ker (I : Ideal R) (x : S) :
    LinearMap.ker (errorClassMap I x) = scalarIdeal (algebraMap R S) I x := by
  ext a
  change (homogeneousImage (S := S) I).mkQ (a • x) = 0 ↔
    ∃ z ∈ I, algebraMap R S z = algebraMap R S a * x
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, mem_homogeneousImage,
    Algebra.smul_def]

/-- The exact image is the cyclic submodule generated by the full error class. -/
theorem errorClassMap_range (I : Ideal R) (x : S) :
    LinearMap.range (errorClassMap I x) =
      Submodule.span R {(homogeneousImage (S := S) I).mkQ x} := by
  rw [errorClassMap, LinearMap.comp_toSpanSingleton, LinearMap.range_toSpanSingleton]

/-- This particular obstruction submodule is finite even if the entire cokernel is not. -/
theorem errorClassMap_range_fg (I : Ideal R) (x : S) :
    (LinearMap.range (errorClassMap I x)).FG := by
  rw [errorClassMap_range]
  exact Submodule.fg_span_singleton _

/-- Killing the distinguished class is exactly an unscaled homogeneous lift. -/
theorem errorClass_eq_zero_iff (I : Ideal R) (x : S) :
    (homogeneousImage (S := S) I).mkQ x = 0 ↔ ∃ z ∈ I, algebraMap R S z = x := by
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, mem_homogeneousImage]

end FLT.Mazur.HomogeneousNumeratorObstruction
