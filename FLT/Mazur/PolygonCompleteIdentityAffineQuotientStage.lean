module

public import FLT.Mazur.QuotientSpectrumBaseChange
public import FLT.Mazur.PolygonCompleteIdentityFiniteAffineMaps

/-!
# Original finite input restrictions as actual affine parameter quotients

An affine map into the original input supplies its own scalar map and parameter.
Its parameter-power quotients are Cartesian over the original finite inputs.
-/

@[expose] public noncomputable section
open CategoryTheory Limits AlgebraicGeometry
namespace FLT.Mazur.PolygonInfinitesimalStages
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] exactVeroneseProj exactVeroneseProjToBase
  completePointWeierstrassCurve completePointToIntegralCubic originalStageToCompatibleProj
variable (K : Type) [Field K] (n : ℕ) (h : 2 ≤ n) [NeZero n]
  {A : Type} [CommRing A] (v : Spec (.of A) ⟶ completeIdentityActionProduct K n h 0)
local notation "s" => completeIdentityActionSecond K n h
local notation "π" => exactVeroneseProjToBase K n h
local notation "j" m => completeIdentityFiniteInput K n h 0 m
local notation "b" m => PolygonInfinitesimal.scalingParameterProjection
  (Ring K m) (parameter K m) n h ≫ Over.hom (family K m n h)

/-- The affine source's actual complete coefficient map. -/
def completeIdentityAffineScalars : PowerSeries K →+* A :=
  (Spec.preimage (v ≫ (s) ≫ (π))).hom

/-- The original source parameter ideal, with its original scalar action. -/
def completeIdentityAffineIdeal : Ideal A :=
  (parameterIdeal K).map (completeIdentityAffineScalars K n h v)

/-- This is precisely the principal ideal generated by the original parameter's image. -/
theorem completeIdentityAffineIdeal_eq :
    completeIdentityAffineIdeal K n h v =
      Ideal.span {completeIdentityAffineScalars K n h v PowerSeries.X} := by
  rw [completeIdentityAffineIdeal, parameterIdeal, Ideal.map_span, Set.image_singleton]

local notation "I" => completeIdentityAffineIdeal K n h v
local notation "q" m => Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk ((I) ^ (m + 1))))

/-- The original finite coefficient morphism of each affine parameter quotient. -/
def completeIdentityAffineQuotientBase (m : ℕ) :
    Spec (.of (A ⧸ (I) ^ (m + 1))) ⟶ Spec (.of (Ring K m)) :=
  Spec.map (CommRingCat.ofHom (QuotientSpectrumBaseChange.powerMap
    (completeIdentityAffineScalars K n h v) (parameterIdeal K) (m + 1))) ≫
      (stageAdicBaseIso K m).inv

/-- Each actual affine quotient is the original finite coefficient base change. -/
theorem completeIdentityAffineQuotientBase_isPullback (m : ℕ) :
    IsPullback (q m) (completeIdentityAffineQuotientBase K n h v m)
      (v ≫ (s) ≫ (π)) (baseToSeries K m) := by
  refine (QuotientSpectrumBaseChange.power_isPullback
    (completeIdentityAffineScalars K n h v) (parameterIdeal K) (m + 1)).of_iso'
    (Iso.refl _) (Iso.refl _) (stageAdicBaseIso K m) (Iso.refl _) ?_ ?_ ?_ ?_
  · simp [completeIdentityAffineIdeal]
  · simp [completeIdentityAffineQuotientBase]
  · simp [completeIdentityAffineScalars]
  · simpa only [Iso.refl_hom, Category.comp_id, Ideal.Quotient.algebraMap_eq]
      using stageAdicBaseIso_toSeries K m

/-- The actual parameter quotient maps to the unchanged entire original finite input. -/
def completeIdentityAffineQuotientToFinite (m : ℕ) :
    Spec (.of (A ⧸ (I) ^ (m + 1))) ⟶
      PolygonInfinitesimal.scalingParameterFamily (Ring K m) (parameter K m) n h :=
  (completeIdentityFiniteInput_base_isPullback K n h 0 m).lift
    ((q m) ≫ v) (completeIdentityAffineQuotientBase K n h v m)
    (by simpa only [Category.assoc] using
      (completeIdentityAffineQuotientBase_isPullback K n h v m).w)

/-- The quotient map retains the exact original affine input. -/
@[reassoc] theorem completeIdentityAffineQuotientToFinite_input (m : ℕ) :
    completeIdentityAffineQuotientToFinite K n h v m ≫ (j m) = (q m) ≫ v :=
  (completeIdentityFiniteInput_base_isPullback K n h 0 m).lift_fst _ _ _

/-- The same quotient map retains the exact original finite coefficients. -/
@[reassoc] theorem completeIdentityAffineQuotientToFinite_base (m : ℕ) :
    completeIdentityAffineQuotientToFinite K n h v m ≫ (b m) =
      completeIdentityAffineQuotientBase K n h v m :=
  (completeIdentityFiniteInput_base_isPullback K n h 0 m).lift_snd _ _ _

/-- The affine parameter quotient is the full original input restriction, including nilpotents. -/
theorem completeIdentityAffineQuotientToFinite_isPullback (m : ℕ) :
    IsPullback (completeIdentityAffineQuotientToFinite K n h v m) (q m) (j m) v := by
  have H : IsPullback (completeIdentityAffineQuotientToFinite K n h v m ≫ (b m))
      (q m) (baseToSeries K m) (v ≫ (s) ≫ (π)) := by
    rw [completeIdentityAffineQuotientToFinite_base]
    exact (completeIdentityAffineQuotientBase_isPullback K n h v m).flip
  exact H.of_right (completeIdentityAffineQuotientToFinite_input K n h v m)
    (completeIdentityFiniteInput_base_isPullback K n h 0 m).flip

/-- Adjacent quotient inclusions retain the original affine source. -/
@[reassoc] theorem completeIdentityAffineQuotientRestriction_input (m : ℕ) :
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor
      (S := (I) ^ (m + 2)) (T := (I) ^ (m + 1))
      (Ideal.pow_le_pow_right (Nat.le_succ (m + 1))))) ≫ (q (m + 1)) = (q m) := by
  rw [← Spec.map_comp]
  rfl

/-- The quotient identifications commute with the original finite input restrictions. -/
@[reassoc] theorem completeIdentityAffineQuotientToFinite_restriction (m : ℕ) :
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.factor
      (S := (I) ^ (m + 2)) (T := (I) ^ (m + 1))
      (Ideal.pow_le_pow_right (Nat.le_succ (m + 1))))) ≫
        completeIdentityAffineQuotientToFinite K n h v (m + 1) =
      completeIdentityAffineQuotientToFinite K n h v m ≫
        completeIdentityFiniteRestriction K n h m := by
  apply (cancel_mono (j (m + 1))).mp
  rw [Category.assoc, completeIdentityAffineQuotientToFinite_input,
    Category.assoc, completeIdentityFiniteRestriction_input,
    completeIdentityAffineQuotientToFinite_input,
    completeIdentityAffineQuotientRestriction_input_assoc]

end FLT.Mazur.PolygonInfinitesimalStages
