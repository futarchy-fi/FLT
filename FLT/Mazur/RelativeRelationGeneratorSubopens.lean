module

public import FLT.Mazur.RelativeRelationSaturatedSheafImage

/-!
# Original invariant-sheaf descent on every quotient subopen

Intersect a generator with the inverse image of a quotient subopen. Its exact
orbit image is that subopen, so effective function descent applies there too.
The ring comparison retains the original sheaf inclusion and restriction maps.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry Opposite
universe u
namespace FLT.Mazur.RelativeRelationOrbit
open SchemeEffectiveEpiSections
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
variable {S : Scheme.{u}} {A U : Over S} {p q : A ⟶ U}
  (e : CategoryTheory.EquivalenceRelation p q) (hq : IsOpenMap q.left)
  (W : U.left.Opens)

/-- The generator domain lying over a specified quotient open. -/
def orbitGeneratorOpen (O : TopologicalSpace.Opens (Orbit e)) : U.left.Opens :=
  W ⊓ (pullOpen e O).val

/-- Taking the exact orbit image commutes with restriction to a quotient open. -/
theorem orbitGeneratorOpen_image (O : TopologicalSpace.Opens (Orbit e)) :
    orbitImageOpen e hq (orbitGeneratorOpen e W O) = orbitImageOpen e hq W ⊓ O := by
  ext z
  change (∃ x, (x ∈ W ∧ projection e x ∈ O) ∧ projection e x = z) ↔
    (∃ x ∈ W, projection e x = z) ∧ z ∈ O
  constructor
  · rintro ⟨x, ⟨hx, ho⟩, rfl⟩
    exact ⟨⟨x, hx, rfl⟩, ho⟩
  · rintro ⟨⟨x, hx, rfl⟩, ho⟩
    exact ⟨x, ⟨hx, ho⟩, rfl⟩

/-- A quotient subopen is generated by the corresponding part of the original generator. -/
theorem orbitGeneratorOpen_image_of_le (O : TopologicalSpace.Opens (Orbit e))
    (hO : O ≤ orbitImageOpen e hq W) :
    orbitImageOpen e hq (orbitGeneratorOpen e W O) = O := by
  rw [orbitGeneratorOpen_image, inf_eq_right.mpr hO]

/-- Its saturation is exactly the original invariant source domain of the subopen. -/
theorem orbitGeneratorOpen_saturation (O : TopologicalSpace.Opens (Orbit e))
    (hO : O ≤ orbitImageOpen e hq W) :
    saturateOpen e hq (orbitGeneratorOpen e W O) = pullOpen e O := by
  unfold saturateOpen
  rw [orbitGeneratorOpen_image_of_le e hq W O hO]

variable [Etale q.left]

/-- Descent on an explicitly identified quotient image. -/
def saturatedSheafFunctionEquivOn (O : TopologicalSpace.Opens (Orbit e))
    (he : orbitImageOpen e hq W = O) : (invariantSheaf e).obj.obj (op O) ≃+*
      compatibleFunctions (SchemeRelationRestriction.fst p.left q.left W.ι)
        (SchemeRelationRestriction.snd p.left q.left W.ι) := by
  subst O
  exact saturatedSheafFunctionEquiv e hq W

/-- The comparison on an identified domain retains the original invariant-sheaf inclusion. -/
theorem saturatedSheafFunctionEquivOn_val (O : TopologicalSpace.Opens (Orbit e))
    (he : orbitImageOpen e hq W = O) (hW : W ≤ (pullOpen e O).val)
    (t : (invariantSheaf e).obj.obj (op O)) :
    (saturatedSheafFunctionEquivOn e hq W O he t).val =
      W.topIso.inv (U.left.presheaf.map (homOfLE hW).op
        ((invariantInclusion e).hom.app (op O) t)) := by
  subst O
  exact saturatedSheafFunctionEquiv_val e hq W t

/-- Every quotient subopen has the exact original compatible generator-function ring. -/
def generatorSubopenFunctionEquiv (O : TopologicalSpace.Opens (Orbit e))
    (hO : O ≤ orbitImageOpen e hq W) : (invariantSheaf e).obj.obj (op O) ≃+*
      compatibleFunctions
        (SchemeRelationRestriction.fst p.left q.left (orbitGeneratorOpen e W O).ι)
        (SchemeRelationRestriction.snd p.left q.left (orbitGeneratorOpen e W O).ι) :=
  saturatedSheafFunctionEquivOn e hq (orbitGeneratorOpen e W O) O
    (orbitGeneratorOpen_image_of_le e hq W O hO)

/-- The comparison on every subopen is actual restriction of the original regular function. -/
theorem generatorSubopenFunctionEquiv_val (O : TopologicalSpace.Opens (Orbit e))
    (hO : O ≤ orbitImageOpen e hq W) (t : (invariantSheaf e).obj.obj (op O)) :
    (generatorSubopenFunctionEquiv e hq W O hO t).val =
      (orbitGeneratorOpen e W O).topIso.inv
        (U.left.presheaf.map (homOfLE inf_le_right).op
          ((invariantInclusion e).hom.app (op O) t)) :=
  saturatedSheafFunctionEquivOn_val e hq (orbitGeneratorOpen e W O) O
    (orbitGeneratorOpen_image_of_le e hq W O hO) inf_le_right t

end FLT.Mazur.RelativeRelationOrbit
