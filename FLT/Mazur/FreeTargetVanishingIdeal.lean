module

public import Mathlib.LinearAlgebra.TensorProduct.Basis
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The coefficient ideal representing vanishing of a linear map

For a free target, the ideal generated by every coordinate of every image
represents vanishing after arbitrary scalar extension. The source need not
be free or finitely generated. This is the affine equation for vanishing of
maps into a finite locally free direct image.
-/

@[expose] public noncomputable section
open scoped TensorProduct
namespace FLT.Mazur.FreeTargetVanishing
variable {R M N ι : Type*} [CommRing R] [AddCommGroup M] [AddCommGroup N]
  [Module R M] [Module R N] (b : Module.Basis ι R N) (f : M →ₗ[R] N)

/-- All coefficients of the actual map, including every source element. -/
def ideal : Ideal R := Ideal.span (Set.range fun p : M × ι ↦ b.repr (f p.1) p.2)

/-- The original map vanishes exactly when its coefficient ideal vanishes. -/
theorem ideal_eq_bot_iff : ideal b f = ⊥ ↔ f = 0 := by
  rw [ideal, Ideal.span_eq_bot]
  constructor
  · intro h
    ext x
    apply b.repr.injective
    ext i
    simpa using h _ ⟨(x, i), rfl⟩
  · rintro rfl
    rintro _ ⟨⟨x, i⟩, rfl⟩
    simp

variable (A : Type*) [CommRing A] [Algebra R A]

/-- Arbitrary scalar extension kills the map precisely when it kills all coefficients. -/
theorem baseChange_eq_zero_iff :
    f.baseChange A = 0 ↔ ideal b f ≤ RingHom.ker (algebraMap R A) := by
  rw [ideal, Ideal.span_le]
  constructor
  · intro h
    rintro _ ⟨⟨x, i⟩, rfl⟩
    have hx := congrArg (fun g : A ⊗[R] M →ₗ[A] A ⊗[R] N ↦
      (b.baseChange A).repr (g (1 ⊗ₜ[R] x)) i) h
    simpa [Algebra.smul_def] using hx
  · intro h
    ext x
    apply (b.baseChange A).repr.injective
    ext i
    have hc : algebraMap R A (b.repr (f x) i) = 0 := h ⟨(x, i), rfl⟩
    simp [Algebra.smul_def, hc]

/-- The canonical quotient by the coefficient ideal kills the entire extended map. -/
theorem quotient_baseChange_eq_zero : f.baseChange (R ⧸ ideal b f) = 0 := by
  apply (baseChange_eq_zero_iff b f _).mpr
  intro x hx
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hx

end FLT.Mazur.FreeTargetVanishing
