module

public import FLT.Mazur.WeierstrassSuccessiveCenterAction
public import FLT.Mazur.WeierstrassSuccessiveReesCover
public import FLT.Mazur.RegularCenterGluedLift

/-!
# Principalization and local lifts for the actual successive center

On a flat affine presentation of a successor fraction input, the genuine
smooth translation has the same regular principal center. Gluing its ratio
opens constructs a map into the actual successor Rees scheme.
-/

@[expose] public noncomputable section
open AlgebraicGeometry CategoryTheory
namespace FLT.Mazur.WeierstrassSuccessiveX
open WeierstrassIntegralChart
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
universe u
variable {R : Type u} [CommRing R]
  (W : WeierstrassCurve R) (s π b3 b4 b6 : R)
  (h3 : W.a₃ = s * (π * b3)) (h4 : W.a₄ = s * (π * b4))
  (h6 : W.a₆ = s ^ 2 * (π ^ 2 * b6))
local notation "B" =>
  WeierstrassDilatation.Coordinate W s (π * b3) (π * b4) (π ^ 2 * b6)
local notation "c" =>
  WeierstrassDilatation.fromOriginal W s (π * b3) (π * b4) (π ^ 2 * b6) h3 h4 h6
variable {S : Type u} [CommRing S] [Algebra R S]
variable (p : Spec (.of S) ⟶ (integralSmoothOpen W).toScheme)
  (α β : WeierstrassDilatation.Coordinate W s
    (π * b3) (π * b4) (π ^ 2 * b6) →ₐ[R] S)
  (hp : p ≫ integralSmoothStructure W =
    (Spec.map (CommRingCat.ofHom (β.comp (WeierstrassDilatation.fromOriginal W s
      (π * b3) (π * b4) (π ^ 2 * b6) h3 h4 h6)).toRingHom) ≫ integralCurveChart W 2) ≫
      integralCurveStructure W)
  (hα : Spec.map (CommRingCat.ofHom (α.comp (WeierstrassDilatation.fromOriginal W s
      (π * b3) (π * b4) (π ^ 2 * b6) h3 h4 h6)).toRingHom) ≫ integralCurveChart W 2 =
    leftSmoothPointAddition W p
      (Spec.map (CommRingCat.ofHom (β.comp (WeierstrassDilatation.fromOriginal W s
      (π * b3) (π * b4) (π ^ 2 * b6) h3 h4 h6)).toRingHom) ≫ integralCurveChart W 2) hp)

variable (hs : IsRegular (algebraMap R S s))
  (f : WeierstrassDilatation.Coordinate W s (π * b3) (π * b4) (π ^ 2 * b6))
  (hf : f ∈ modificationCenter W s π b3 b4 b6)
  (ψ : BlowupFractionChart.chart (modificationCenter W s π b3 b4 b6) f →+* S)
  (hβ : β.toRingHom = ψ.comp (algebraMap _ _))
  (hflat : RingHom.Flat ψ)
local notation "I" => modificationCenter W s π b3 b4 b6
local notation "den" => ψ (BlowupFractionChart.denominator I f)

include hp hα hs hf hβ in
/-- The output successive center is generated by the retained input fraction denominator. -/
theorem successiveFractionAction_principal : (I).map α.toRingHom = Ideal.span {den} := by
  rw [successiveSmoothPresentation_center_eq W s π b3 b4 b6 h3 h4 h6 p α β hp hα hs, hβ]
  exact BlowupFractionChart.center_map_eq_mapped_denominator I f hf ψ

omit [Algebra R S] in
include hflat in
/-- Flat smooth-input presentations retain the regular successor denominator. -/
theorem successiveFractionAction_denominator_regular : IsRegular den :=
  flatRingHom_isRegular ψ hflat (BlowupFractionChart.denominator_regular I f)

/-- The entire affine presentation lifts to the successor Rees scheme. -/
irreducible_def successiveFractionActionToRees : Spec (.of S) ⟶ BlowupRees.proj I :=
  RegularCenter.gluedLift I α.toRingHom den
    (successiveFractionAction_principal W s π b3 b4 b6 h3 h4 h6 p α β hp hα hs f hf ψ hβ)
    (successiveFractionAction_denominator_regular W s π b3 b4 b6 f ψ hflat)
    (WeierstrassSuccessiveRees.centerGenerators W s π b3 b4 b6)
    (WeierstrassSuccessiveRees.centerGenerators_mem W s π b3 b4 b6)
    (WeierstrassSuccessiveRees.centerGenerators_span W s π b3 b4 b6)

/-- The constructed lift retains the exact divided output presentation. -/
@[reassoc] theorem successiveFractionActionToRees_contraction :
    successiveFractionActionToRees W s π b3 b4 b6 h3 h4 h6 p α β hp hα hs f hf ψ hβ hflat ≫
        BlowupRees.contraction I = Spec.map (CommRingCat.ofHom α.toRingHom) := by
  rw [successiveFractionActionToRees_def, RegularCenter.gluedLift_contraction]

/-- Contracting further recovers the genuine original smooth action on this entire presentation. -/
@[reassoc] theorem successiveFractionActionToRees_original :
    successiveFractionActionToRees W s π b3 b4 b6 h3 h4 h6 p α β hp hα hs f hf ψ hβ hflat ≫
        BlowupRees.contraction I ≫
          WeierstrassDilatation.toCurve W s (π * b3) (π * b4) (π ^ 2 * b6) h3 h4 h6 =
      leftSmoothPointAddition W p
        (Spec.map (CommRingCat.ofHom (β.comp c).toRingHom) ≫ integralCurveChart W 2) hp := by
  rw [successiveFractionActionToRees_contraction_assoc]
  change Spec.map _ ≫ (Spec.map _ ≫ _) = _
  rw [← Category.assoc, ← Spec.map_comp]
  exact hα

end FLT.Mazur.WeierstrassSuccessiveX
