module

public import FLT.Mazur.DivisorComplementExhaustion
public import FLT.Mazur.GeneralizedCurveMarkingAffineCubicMorphism
public import FLT.Mazur.GeneralizedCurveMarkingPoleReduction

/-!
# Surjectivity onto all original complement functions

Successively removing the constructed unit-leading monomials generates every
finite pole section. Noetherian pole exhaustion then generates every regular function.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry Scheme.Modules MonoidalCategory
namespace FLT.Mazur.GeneralizedEllipticCurve
open FCurve ModuleLineBundleTensorPullback
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
attribute [local irreducible] ModuleSheafTensor.tensor divisorLineBundle
  sectionPoleMultiplicativeCoordinates Scheme.Modules.pullback
  relativePoleFunction

variable {S : Scheme} [IsAffine S] [IsNoetherianRing Γ(S, ⊤)]
  (E : GeneralizedEllipticCurve S) (s : 𝟙_ (Over S) ⟶ E.group)

local notation "t" => s ≫ E.inclusion
local notation "hI" => And.left (smoothMarking_relativeCartier E s)

/-- The structure morphism is proper for the original family. -/
local instance generalizedCurveMarkingCoordinateSurjectiveProper :
    IsProper E.curve.hom := E.family.family.1

variable (e : (pullback (s ≫ E.inclusion).left).obj
  (divisorLineBundle (s ≫ E.inclusion).left.ker
    (smoothMarking_relativeCartier E s).1) ≅ structureModule S)

local notation "ε" => smoothMarkingCoordinateEvaluation E s e
local notation "φ" => smoothMarkingComplementBaseMap E s
local notation "W" => smoothMarkingWeierstrassCurve E s e

/-- Every original base scalar belongs to the coordinate image. -/
theorem smoothMarkingCoordinateRange_scalar (a : Γ(S, ⊤)) : φ a ∈ (ε).range :=
  ⟨algebraMap Γ(S, ⊤) (W).toAffine.CoordinateRing a,
    smoothMarkingCoordinateEvaluation_scalar E s e a⟩

/-- The original x function belongs to the coordinate image. -/
theorem smoothMarkingCoordinateRange_x : smoothMarkingComplementX E s e ∈ (ε).range :=
  ⟨algebraMap (Polynomial Γ(S, ⊤)) (W).toAffine.CoordinateRing Polynomial.X,
    smoothMarkingCoordinateEvaluation_x E s e⟩

/-- The original y function belongs to the coordinate image. -/
theorem smoothMarkingCoordinateRange_y : smoothMarkingComplementY E s e ∈ (ε).range :=
  ⟨AdjoinRoot.root (W).toAffine.polynomial, smoothMarkingCoordinateEvaluation_y E s e⟩

/-- Every higher unit-leading monomial belongs to the original coordinate image. -/
theorem smoothMarkingCoordinateRange_higher (m : ℕ) :
    relativePoleFunction E.curve.hom (t).left (hI) (m + 2)
      (smoothMarkingHigherMonomial E s e m) ∈ (ε).range := by
  induction m using Nat.twoStepInduction with
  | zero => exact smoothMarkingCoordinateRange_x E s e
  | one => exact smoothMarkingCoordinateRange_y E s e
  | more m ih _ =>
    rw [smoothMarkingHigherMonomial_function_step]
    exact (ε).range.mul_mem ih (smoothMarkingCoordinateRange_x E s e)

/-- Original pole sections of every finite order are generated by x and y over the base. -/
theorem smoothMarkingCoordinateRange_pole (m : ℕ)
    (z : ModuleRingH E.curve.hom.appTop.hom
      (tensorPower (divisorLineBundle (t).left.ker (hI)) m) 0) :
    relativePoleFunction E.curve.hom (t).left (hI) m z ∈ (ε).range := by
  induction m with
  | zero =>
    let w := divisorPowerRingStep E.curve.hom.appTop.hom (hI) 0 z
    have h := (smoothMarkingOneBasis E s).sum_repr w
    rw [Fintype.sum_unique] at h
    have hh := congrArg (relativePoleFunction E.curve.hom (t).left (hI) 1) h
    rw [relativePoleFunction_smul, smoothMarkingComplement_oneBasis, mul_one] at hh
    have hw : relativePoleFunction E.curve.hom (t).left (hI) 1 w =
        relativePoleFunction E.curve.hom (t).left (hI) 0 z :=
      relativePoleFunction_step E.curve.hom (t).left (hI) 0 z
    rw [hw] at hh
    rw [← hh]
    exact smoothMarkingCoordinateRange_scalar E s e _
  | succ m ih =>
    cases m with
    | zero =>
      have h := (smoothMarkingOneBasis E s).sum_repr z
      rw [Fintype.sum_unique] at h
      have hh := congrArg (relativePoleFunction E.curve.hom (t).left (hI) 1) h
      rw [relativePoleFunction_smul, smoothMarkingComplement_oneBasis, mul_one] at hh
      rw [← hh]
      exact smoothMarkingCoordinateRange_scalar E s e _
    | succ m =>
      obtain ⟨w, a, h⟩ := smoothMarkingHigherMonomial_decomposition E s e m z
      have hh := congrArg (relativePoleFunction E.curve.hom (t).left (hI) (m + 2)) h
      rw [relativePoleFunction_add, relativePoleFunction_step, relativePoleFunction_smul] at hh
      rw [hh]
      exact (ε).range.add_mem (ih w) ((ε).range.mul_mem
        (smoothMarkingCoordinateRange_scalar E s e a)
        (smoothMarkingCoordinateRange_higher E s e m))

/-- The actual coordinate evaluation is surjective onto the full complement ring. -/
theorem smoothMarkingCoordinateEvaluation_surjective : Function.Surjective ε := by
  let _ := Chow.source_isNoetherian (E.curve.hom ≫ S.isoSpec.hom)
  intro z
  obtain ⟨m, u, ht⟩ := exists_divisorComplementFunction (hI) z
  have h := smoothMarkingCoordinateRange_pole E s e m ((moduleH0Equiv _).symm u)
  unfold relativePoleFunction at h
  rw [LinearEquiv.apply_symm_apply, ht] at h
  exact h

end FLT.Mazur.GeneralizedEllipticCurve
