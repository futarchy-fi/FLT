module

public import FLT.Mazur.CartierGeneratorOrbitCover
public import FLT.Mazur.CyclicGeneratorUnitLift
public import Mathlib.AlgebraicGeometry.AlgClosed.Basic

/-!
# Geometric Cartier generators differ by full-level units

Over an algebraically closed field, every section of the actual subgroup is
a power of a Cartier generator. Thus any two Cartier generators differ by
a unit modulo the original level, even for non-etale subgroups. Equality is
proved for the original section morphisms, not only for their point images.
-/

@[expose] public noncomputable section
open CategoryTheory AlgebraicGeometry MonoidalCategory MonObj
namespace FLT.Mazur.GeneralizedEllipticCurve.FiniteSubgroup
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
variable {K : Type} [Field K] [IsAlgClosed K]
  {E : GeneralizedEllipticCurve (Spec (.of K))} {n : ℕ}
  (H : E.FiniteSubgroup n) {P : 𝟙_ (Over (Spec (.of K))) ⟶ H.carrier}

/-- Geometric orbit coverage recovers each original section as a generator power. -/
theorem IsCartierGenerator.exists_section_power (hP : H.IsCartierGenerator P)
    (Q : 𝟙_ (Over (Spec (.of K))) ⟶ H.carrier) :
    ∃ i : Fin n, P ^ i.val = Q := by
  obtain ⟨i, hi⟩ := hP.exists_orbit_point H (Q.left (IsLocalRing.closedPoint K))
  refine ⟨i, Over.OverMorphism.ext ?_⟩
  apply ext_of_apply_closedPoint_eq H.carrier.hom (Over.w _) (Over.w _)
  simpa only [Subsingleton.elim (H.carrier.hom (Q.left (IsLocalRing.closedPoint K)))
    (IsLocalRing.closedPoint K)] using! hi

/-- The group of geometric subgroup sections is generated by the original Cartier section. -/
theorem IsCartierGenerator.geometric_zpowers_eq_top (hP : H.IsCartierGenerator P) :
    Subgroup.zpowers P = ⊤ := by
  apply top_le_iff.mp
  intro Q _
  obtain ⟨i, rfl⟩ := hP.exists_section_power H Q
  exact Subgroup.pow_mem _ (Subgroup.mem_zpowers P) i.val

variable [NeZero n]

/-- Full-level unit relabeling compares the actual geometric Cartier generators. -/
theorem IsCartierGenerator.exists_unit_power (hP : H.IsCartierGenerator P)
    {Q : 𝟙_ (Over (Spec (.of K))) ⟶ H.carrier} (hQ : H.IsCartierGenerator Q) :
    ∃ u : (ZMod n)ˣ, P ^ u.val.val = Q :=
  CyclicGeneratorUnitLift.exists_unit_of_zpowers_eq hP.1
    ((hP.geometric_zpowers_eq_top H).trans (hQ.geometric_zpowers_eq_top H).symm)

end FLT.Mazur.GeneralizedEllipticCurve.FiniteSubgroup
