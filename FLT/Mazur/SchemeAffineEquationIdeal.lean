module

public import FLT.Mazur.FiniteCoefficientDifferenceIdeal
public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme

/-!
# Full affine endpoint equations in original coefficients

The scheme-theoretic equalizer ideal is generated by the differences of the
original endpoint coefficients. This identifies the exact ideal, including
nilpotents, without assuming finite generation of the endpoint ring.
-/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
namespace FLT.Mazur.SchemeAffineEquationIdeal
open FiniteCoefficientDifference
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
variable {T Z : Scheme.{0}} [IsAffine T] [IsAffine Z] (f g : T ⟶ Z)

/-- The exact scalar ideal cutting out equality of the two full endpoint morphisms. -/
abbrev equations : Ideal Γ(T, ⊤) := differenceIdeal f.appTop.hom g.appTop.hom

/-- The original scalar differences compute the entire equalizer ideal sheaf. -/
theorem kernel_eq :
    (equalizer.ι f g).ker = Scheme.IdealSheafData.ofIdealTop (equations f g) := by
  let K := Scheme.IdealSheafData.ofIdealTop (equations f g)
  have hle : K ≤ (equalizer.ι f g).ker := by
    rw [Scheme.ker_of_isAffine]
    apply Scheme.IdealSheafData.equivOfIsAffine.symm.toOrderIso.monotone
    apply (differenceIdeal_le_ker_iff _ _ _).mpr
    exact congrArg (fun h : equalizer f g ⟶ Z ↦ h.appTop.hom) (equalizer.condition f g)
  have hk : equations f g = RingHom.ker K.subschemeι.appTop.hom := by
    simpa [K, Scheme.Hom.appTop] using
      (K.ker_subschemeι_app ⟨⊤, isAffineOpen_top T⟩).symm
  have he : K.subschemeι ≫ f = K.subschemeι ≫ g := by
    apply ext_of_isAffine
    apply CommRingCat.hom_ext
    exact (differenceIdeal_le_ker_iff _ _ _).mp hk.le
  apply le_antisymm _ hle
  have hl := (equalizer.lift K.subschemeι he).le_ker_comp (equalizer.ι f g)
  simpa only [equalizer.lift_ι, Scheme.IdealSheafData.ker_subschemeι] using hl

/-- On an affine test, equality equations are exactly the scalar kernel of the equalizer. -/
theorem scalar_kernel_eq : RingHom.ker (equalizer.ι f g).appTop.hom = equations f g := by
  apply Scheme.IdealSheafData.equivOfIsAffine.symm.injective
  change Scheme.IdealSheafData.ofIdealTop _ = Scheme.IdealSheafData.ofIdealTop _
  rw [← Scheme.ker_of_isAffine, kernel_eq]

end FLT.Mazur.SchemeAffineEquationIdeal
