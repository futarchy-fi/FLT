module

public import FLT.FreyCurve.Serre.VeluInfinityParameter
public import Mathlib.RingTheory.Localization.Ideal

/-!
# The scheme ideal of the original infinity point

The evaluation kernel on the original chart is generated by its two vanishing
coordinates. After the first principal localization the single parameter u
generates the full ideal, including its scheme structure.
-/

@[expose] public noncomputable section

open FLT.Mazur.WeierstrassIntegralChart

namespace WeierstrassCurve.Velu

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

variable {K : Type} [Field K] (E : WeierstrassCurve K)

/-- The original infinity section has exactly the coordinate ideal (u,v). -/
theorem infinityEvaluation_ker :
    RingHom.ker (infinityEvaluation E).toRingHom =
      Ideal.span {coord E 1 0, coord E 1 2} := by
  let I : Ideal (Coordinate E 1) := Ideal.span {coord E 1 0, coord E 1 2}
  have hle : I ≤ RingHom.ker (infinityEvaluation E).toRingHom := by
    apply Ideal.span_le.mpr
    simp only [Set.subset_def, Set.mem_insert_iff, Set.mem_singleton_iff]
    rintro x (rfl | rfl) <;> simp [RingHom.mem_ker]
  have he : Ideal.Quotient.mkₐ K I =
      (Algebra.ofId K (Coordinate E 1 ⧸ I)).comp (infinityEvaluation E) := by
    refine @hom_ext K (Coordinate E 1 ⧸ I) inferInstance inferInstance inferInstance
      E 1 (Ideal.Quotient.mkₐ K I)
      ((Algebra.ofId K (Coordinate E 1 ⧸ I)).comp (infinityEvaluation E)) ?_
    intro i
    have h0 : Ideal.Quotient.mk I (coord E 1 0) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
    have h2 : Ideal.Quotient.mk I (coord E 1 2) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
    fin_cases i
    · simpa using h0
    · simp
    · simpa using h2
  refine le_antisymm (fun x hx => ?_) hle
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change (Ideal.Quotient.mkₐ K I) x = 0
  rw [he, AlgHom.comp_apply, show infinityEvaluation E x = 0 from hx, map_zero]

/-- The full evaluation ideal after localization is the single original parameter. -/
theorem infinityParameterEvaluation_ker :
    RingHom.ker (infinityParameterEvaluation E).toRingHom =
      Ideal.span {algebraMap _ (InfinityParameterRing E) (coord E 1 0)} := by
  have hc : (RingHom.ker (infinityParameterEvaluation E).toRingHom).under (Coordinate E 1) =
      RingHom.ker (infinityEvaluation E).toRingHom := by
    ext x
    change infinityParameterEvaluation E (algebraMap _ _ x) = 0 ↔ _
    rw [infinityParameterEvaluation_algebraMap]
    rfl
  rw [← IsLocalization.map_under (Submonoid.powers (infinityFactor E))
    (InfinityParameterRing E) (RingHom.ker (infinityParameterEvaluation E).toRingHom), hc,
    infinityEvaluation_ker, Ideal.map_span, Set.image_pair]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro x (rfl | rfl)
    · exact Ideal.subset_span (by simp)
    · rw [← infinityReciprocal_relation]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  · exact Ideal.span_mono (by simp [Set.subset_def])

end WeierstrassCurve.Velu
